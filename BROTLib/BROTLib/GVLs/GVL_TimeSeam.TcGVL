<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_TimeSeam" Id="{96bf0a23-6fec-4c7b-a291-7a7af8a12bef}">
    <Declaration><![CDATA[// Test seam for the long timeouts of the telescope state machines (600 s, 2 min, 12 h; plan
// telescope-state-machine-unification, decision 4). FB_TimeoutTimer divides its preset time by nTimeDivisor.
// Production never writes it, so the default 1 keeps the real times. Tests set it to e.g. 1000 and restore it.
{attribute 'qualified_only'}
VAR_GLOBAL
	nTimeDivisor	: UDINT := 1;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>