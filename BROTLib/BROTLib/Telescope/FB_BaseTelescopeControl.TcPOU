<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_BaseTelescopeControl" Id="{eddbf876-a986-4fe1-ba5b-16d782882b92}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT FB_BaseTelescopeControl IMPLEMENTS I_Telescope
VAR_INPUT
(*
TCS interface section, modeled on an external TCS spec kept as a private internal reference
(not linked here -- this repo is public; ask internally for the spec if you need it). See
specs/design/telescope-telemetry-publish-chain.md for what's actually confirmed about the
on-wire format from tracing the code, since the spec itself isn't accessible from here.
*)
	// Command inputs (bPower ... bReset) are edge-triggered (MONETcommon#24 step 5): a rising edge starts the command
	// once, holding the input TRUE does not start it again, and the input falling does not abort it. The telescope
	// control does not clear or write these inputs; whether a command runs is reported by the outputs and telemetry
	// (READY_STATE, nMotionState, bSlewing, bTracking, ...). The matching method (Init, Home, Park, Track, Slew, Stop,
	// Reset) starts the same command; an edge and a method call in the same scan count once. The cyclic body of this block
	// is the template of the command model (BROTLib#25 step 5.4); the derived block fills in the hook methods (_Do*, _Read*, ...).
	bPower				: BOOL;		// edge-triggered: rising edge powers on and starts up the telescope (method: Init)
	bGoHome				: BOOL;		// edge-triggered: rising edge moves to the home position, ends a running track/goto (method: Home)
	bPark				: BOOL;		// edge-triggered: rising edge moves to the park position, ready to stow, ends a running track/goto (method: Park)
	bTrack				: BOOL;		// edge-triggered: rising edge moves to fRightAscension/fDeclination and tracks it, ends a running goto (method: Track); stop tracking with bStop/Stop
	bGoto				: BOOL;		// edge-triggered: rising edge moves to fRightAscension/fDeclination and stops there (then tracks if bAutoTrack), ends a running track; no method in I_Telescope
	bSlew				: BOOL;		// edge-triggered: rising edge moves to fAzimuth/fElevation (method: Slew)
	bStop				: BOOL;		// edge-triggered: rising edge stops all motion at once, ends track/goto/slew (method: Stop)
	bReset				: BOOL;		// edge-triggered: rising edge resets the errors of all axes (method: Reset)
	bAutoTrack			: BOOL := TRUE;	// automatic tracking after goto
	bCoverAutoOpen		: BOOL := TRUE;	// automatically open the mirror covers on Init/PowerOn
	// catalog/mean right ascension (ICRS/J2000), degrees, double -- fed straight into AstroBROT's
	// FB_EQ2HOR with precess/nutate/aberration all at their default TRUE, which only makes sense
	// for mean/catalog input (feeding it an already-apparent position would double-correct it);
	// MONETcommon's own telemetry independently re-publishes this same value as *_RA_ICRS (#22)
	fRightAscension		: LREAL :=  0.0;
	// catalog/mean declination (ICRS/J2000), degrees, double -- see fRightAscension
	fDeclination		: LREAL :=  0.0;
	fElevation			: LREAL :=  0.0;	// desired elevation of the telescope pointing
	fAzimuth			: LREAL :=  0.0;	// desired azimut of the telescope pointing
	fTimeOffset			: LREAL := 0.0;		// absolute offset for time
	fHorizon			: LREAL := 1.0;		// ELEVATION below which value the telescope will not go
	
	// TRUE while the E-stop is triggered. The caller must connect it to its safety handling (MONETS/MONETN MAIN:
	// SafetyHandling.estop); left unconnected, the E-stop is never reported as STATUS.GLOBAL = 1 (#10).
	bEstopTriggered		: BOOL	:= FALSE;
	bMainReady			: BOOL	:= TRUE;
	
	telescopeConfig		: ST_TelescopeConfig;

	// Test seam: every long timeout of the telescope (the command timeouts) is divided by it. Production leaves it at 1. Per instance,
	// because TcUnit runs all suites in the same PLC cycles. (Moved here from the derived blocks, BROTLib#25 step 5.4.)
	nTimeDivisor		: UDINT := 1;
END_VAR
VAR
	fbComm 				: I_Comm;
	
	TCS_command			: E_TCSCommand;	// actual command from the TCS
	// fJd/fLst are published by _PublishTelemetry, but this block never sets them or calls fbTime: the derived
	// block must (MONETcommon's FB_MonetTelescopeControl does, gated on fbTime.bValid). Otherwise both read 0 (#10).
	fJd					: LREAL;	// current Julian Date calculated from system time
	fLst				: LREAL;	// local siderial time calculated from Julian date in hours
	fElevationCalc		: LREAL;	// elevation calulated when ra and dec are set by TCS 
	fAzimuthCalc		: LREAL;	// azimuth calulated when ra and dec are set by TCS
	fHourAngle			: LREAL;	// hourangle when ra and dec are set by TCS
	
	fRightAscensionCalc	: LREAL;	// right ascension calulated when azimuth and elevation are set by TCS
	fDeclinationCalc	: LREAL;	// declination calulated when azimuth and elevation are set by TCS
	fHourAngleCalc		: LREAL;	// hour angle azimuth and elevation are set by TCS
	
	fbTime				: FB_AstroClock;	// precise astronomical	time
	
	rtrigReset			: R_TRIG;
	bInterrupted		: BOOL;		// If a command is interruped by one with more presedence, the interrupted needs to reset its stage
	
	bPowerFailure		: BOOL;		// triggers power-failure event
	tpPowerOnWarning	: TP;		// triggers power warning
	tonPowerTimeout		: FB_TimeoutTimer;		// power on timeout
	tonCommandTimeout	: FB_TimeoutTimer;		// command timeout
	tonTrackingDelay	: TON;		// tracking delay
	
	TCSpowerEvent,
	TCSgohomeEvent,
	TCSparkEvent,
	TCSgotoEvent,
	TCStrackEvent,
	TCSstopEvent,
	TCStargetHorizonEvent,
	TCSaltitudeEvent,
	TCSnearPoleEvent,
	TCSreadyEvent,
	TCSCTOEvent			: FB_Eventlog;
	tonMQTTTimer 			: TON := (PT:=T#5S);
	// the 7 INFO/CONFIG fields never change at runtime; republishing them on the fast 1-5s
	// telemetry cadence is wasted traffic, so they get their own much slower timer instead
	tonStaticTelemetryTimer	: TON := (PT:=T#30S);
	bStaticTelemetrySent	: BOOL;	// forces one immediate publish on the first cycle

	// ---- state of the template body (BROTLib#25 step 5.4): was declared in both derived blocks ----
	fbStartup			: FB_StartupControl;
	// internal (non-axis) errors of the state machines, latched until a reset (bError/nErrorID are recomputed from the axes every scan).
	bSoftwareError		: BOOL;
	// #84: a running move was interrupted (gohome/goto/park/track over a slew or goto): stop the axes
	// before the new command may start. Cleared at standstill and on an error. A reset (#56) clears it only
	// if no enabled axis is moving (F_ResetMoveAbort), otherwise the abort stop goes on. Also set by the switch to
	// manual under motion (#118, SuspendAutomatic).
	bMoveAbortPending	: BOOL;
	eTimeoutCommand		: E_TCSCommand;	// #56: the command tonCommandTimeout is counting for
	// #25 step 5.2: which command runs (FB_CommandArbiter); bRequestIdle: no request is set in this scan
	fbArbiter			: FB_CommandArbiter;
	bRequestIdle		: BOOL;
	bParkHeld			: BOOL;		// the pending park waits: not given to the arbiter (_ParkPreStep)
	bWasPower, bWasPark, bWasGoHome, bWasMove : BOOL;	// the requests of the scan before the arbiter's clears
	// an accepted move replaces the running one (latest wins): drop the other move flags, stop the axes
	bSupersedeRequest		: BOOL;
	eSupersedeKeep			: E_TCSCommand;
	// #24 step 5: edge memory of the command inputs (was the #83 direct-write gate). The input of the last scan (snapshot at the
	// end of the body), or TRUE once a method has sent that command since then: a method call and a rising input in the same scan
	// (from one call of the body to the next) are one command, and a held input starts its command once.
	bGoHomeChecked			: BOOL;
	bGotoChecked			: BOOL;
	bSlewChecked			: BOOL;
	bTrackChecked			: BOOL;
	bPowerChecked			: BOOL;
	bParkChecked			: BOOL;
	bStopChecked			: BOOL;
	bResetChecked			: BOOL;
	// #83/#87: a Park() received during a stop; the stop branch would clear bPark, so it is set at standstill
	bParkAfterStop			: BOOL;
	// #87: park aborted a running power-on (one scan, logged)
	bPowerAbortedByPark		: BOOL;
END_VAR
VAR_OUTPUT
	bReady				: BOOL;		// TRUE, IF telescope can be operated 
	fReadyState 		: LREAL := 0.0; // -1 error, 0 parked, 0.3 parking, 0.7 initializing, 0.8 calibrating/positioning, 1 startup complete
	bIsParked			: BOOL := TRUE;		// telescope is parked
	bIsPowered			: BOOL;		// telescope is powered on
	bError				: BOOL;		// indicates an error on one of the components
	bHorizonError		: BOOL;		// if TRUE, the set Coordinate is below the Horizon threshold fHorizon
	nErrorID				: UDINT;	//error id of axis
	nMotionState		: INT	:= 0;
	bSlewing			: BOOL;		//TRUE, IF telescope is in fast-MOVE phase (includes pole-swap)	
	bTracking			: BOOL;		//TRUE, IF telescope is on tracking position AND currently tracking.	
	bStopped			: BOOL;		//TRUE, IF telescope is AT rest.	
	fHourAngleCurrent	: LREAL;	// true position of the hour angle (without pointing and offset correction)
	fDeclinationCurrent	: LREAL;	// true position of the declination (without pointing and offset correction)
	fRightAscensionCurrent: LREAL;	// true position of the right ascension (without pointing and offset correction)
	fElevationCurrent	: LREAL;	// current position in elevation (calculated) (without pointing and offset correction)
	fAzimuthCurrent		: LREAL;	// current position in azimuth (calculated) (without pointing and offset correction)
	fElevationCurrentSky	: LREAL;	// current position in elevation (calculated)
	fAzimuthCurrentSky		: LREAL;	// current position in azimuth (calculated)
	fSlewTime			: LREAL;	//	(time in sec. to reach the goto/track position) 
	bHomed				: BOOL;		// True: telescope is calibrated
	bBusy				: BOOL;		// telescope does not accept further commands

	// #24 step 5 (aim 3): the command requests of the telescope. Until 0.14.x the inherited inputs bPower, bGoHome, bPark, bTrack,
	// bGoto, bSlew, bStop, bReset were written by the telescope (set by the methods, cleared when a command ended); now the inputs
	// are read-only and edge-triggered and these latches carry the request. Set by the methods (Init, Home, Park, Track/TrackRaDec/
	// MoveRaDec, Slew/MoveAltAz, Stop, Reset) and by the rising edge of the matching input, cleared by the telescope when the
	// command ends, is dropped or aborted, exactly where the input used to be cleared. TRUE = requested or running (bGotoActive
	// also while a goto waits for the abort stop of the move it replaces); a status for the Visu and diagnostics, read-only.
	// Comments in the telescope written before step 5 name the request by its input (bGoto meaning bGotoActive, and so on).
	bPowerActive		: BOOL;	// power-on requested or running (was bPower)
	bGoHomeActive		: BOOL;	// move to the home position (was bGoHome; also set by the horizon guard)
	bParkActive			: BOOL;	// park requested or running (was bPark; kept during manual mode, #118)
	bTrackActive		: BOOL;	// tracking requested or running (was bTrack; set after a goto with bAutoTrack)
	bGotoActive			: BOOL;	// goto requested or running (was bGoto; Track() is a goto followed by tracking)
	bSlewActive			: BOOL;	// slew requested or running (was bSlew)
	bStopActive			: BOOL;	// stop running, until the stop transaction has settled (was bStop)
	bResetActive		: BOOL;	// reset of this scan, held while an error the telescope resets is active (was bReset)
END_VAR
VAR CONSTANT
	// kept as an inherited constant (not GVL_Math.d2r directly) so existing subclasses
	// (e.g. MONETcommon/MONETN's FB_MonetTelescopeControl) keep working unmodified; single-sourced
	// from GVL_Math now instead of its own copy of PI/180.0
	d2r		: LREAL := GVL_Math.d2r;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// #24 step 5 (aim 3): the command inputs are read-only here and edge-triggered. The rising edge of bStop, bPark, bReset or
// bPower is the method call (Stop(), Park(), Reset(), Init()), made here at the start of the scan, where a direct write used
// to act; the moves (bGoHome, bGoto, bSlew, bTrack) are decided by the gate after the error computation below. A held input
// starts its command once; the input falling does nothing (it used to stop a track or drop a request only because this block
// also wrote it). A method call of the same command since the last scan already counts (b*Checked), so it is one command.
// Order: stop and park before power, so that Init() refuses a power-on sent together with them (#87).
IF bStop AND NOT bStopChecked THEN
	Stop();
END_IF
IF bPark AND NOT bParkChecked THEN
	Park();
END_IF
IF bReset AND NOT bResetChecked THEN
	Reset();
END_IF
IF bPower AND NOT bPowerChecked THEN
	Init();
END_IF

// Startup events are reset once per scan. Internal bReady still drives mechanical sequencing.
// A repeated request to an already online telescope is dropped, it must not restart calibration.
bPowerActive := fbStartup.BeginScan(Power := bPowerActive, Ready := bReady);
_ScanBegin();

IF NOT _UpdateClock() AND (bGotoActive OR bSlewActive OR bTrackActive) THEN
	// without a trustworthy time nothing may be pointed or tracked: refuse through the normal stop path
	_AutoStop();
END_IF

_ReadInputs();
_HandleReset();
_ReadErrors();
_ErrorReaction();

// A rising move input is a command like the method call: decided at arrival (_AcceptMove); accepted, it sets the request latch,
// rejected, it is logged and nothing is set. Like a method call, an edge while the same command runs is a new command (replace,
// latest wins). The input is never written; a held input is not a new edge. After the error computation, so that the gate sees
// the error, the clock and the power-on of this scan. Nested IFs on purpose: ST does not short-circuit AND and _AcceptMove
// must only run on the edge.
IF bGoHome AND NOT bGoHomeChecked THEN
	Home();
END_IF
IF bGoto AND NOT bGotoChecked THEN
	IF _AcceptMove(E_TCSCommand.goto, E_TCSCommand.no_command) THEN
		_OnMoveEdgeAccepted(E_TCSCommand.goto);
		bGotoActive := TRUE;
	END_IF
END_IF
IF bSlew AND NOT bSlewChecked THEN
	IF _AcceptMove(E_TCSCommand.slew, E_TCSCommand.no_command) THEN
		_OnMoveEdgeAccepted(E_TCSCommand.slew);
		bSlewActive := TRUE;
	END_IF
END_IF
IF bTrack AND NOT bTrackChecked THEN
	IF _AcceptMove(E_TCSCommand.track, E_TCSCommand.no_command) THEN
		_OnMoveEdgeAccepted(E_TCSCommand.track);
		bTrackActive := TRUE;
	END_IF
END_IF

IF bError THEN
	bTrackActive := 	FALSE;
	bGotoActive := 	FALSE;
	bSlewActive := 	FALSE;
	bGoHomeActive := 	FALSE;	// #85 (the horizon guard sets it again if still needed)
	bMoveAbortPending := FALSE;	// #84: the drives are disabled below, nothing to wait for
	bSupersedeRequest := FALSE;	// #83
END_IF
_ApplyError();
IF NOT bError THEN
	nErrorID := 0;
END_IF

// #24 step 4b: the target of this scan (refraction weather, eq2hor, pointing model, derotator, velocities, turn inside
// the axis limits) and the reported position (inverse pointing model, both hor2eq); after the error reaction, before the
// horizon guard and the arbitration below (SM plan D3 hook)
_ComputeTargets();
_Guards();
tonCommandTimeout();
_Timers();

// #83: the latest move wins. Drop the other move flags, reset their stage machines and stop the axes (#84 path).
// The kept command is already accepted and its target written; it starts once the axes are at standstill.
IF bSupersedeRequest THEN
	IF eSupersedeKeep <> E_TCSCommand.gohome THEN
		bGoHomeActive := FALSE;
	END_IF
	IF eSupersedeKeep <> E_TCSCommand.goto THEN
		bGotoActive := FALSE;
	END_IF
	IF eSupersedeKeep <> E_TCSCommand.slew THEN
		bSlewActive := FALSE;
	END_IF
	IF eSupersedeKeep <> E_TCSCommand.track THEN
		bTrackActive := FALSE;
	END_IF
	bInterrupted := TRUE;
	_DoGoHome();
	_DoGoto();
	_DoSlew();
	bInterrupted := FALSE;	// #26: one-shot, the interrupted state machines have reset their stage
	// #56: the replacement gets its own timeout, the timer must not go on counting from the first request
	_RestartMoveTimeout(eSupersedeKeep);
	IF NOT bError THEN
		bMoveAbortPending := TRUE;
	END_IF
	bSupersedeRequest := FALSE;
END_IF

// the automatic parks (error park, cover error, E-stop / safety error); after the supersede block, before the arbitration, so the
// stop branch cannot clear a request in the scan it is made
_ParkRequests();

// A park that waits (the telescope-specific pre-step) is not given to the arbiter
bParkHeld := FALSE;
IF bParkActive AND NOT bStopActive AND NOT bPowerActive AND NOT fbStartup.Initializing AND NOT (bMoveAbortPending AND NOT bError) THEN
	bParkHeld := _ParkPreStep();
END_IF

// set TCS_command according to state variables ordered by precedence (BROTLib.FB_CommandArbiter decides, the block applies what it
// asks for). Order: stop (also a running power-on) > park aborts a running power-on > power-on > a running abort stop > park >
// gohome > goto > slew > track > idle.
// A command that waits (not ready, busy, behind an abort stop) leaves TCS_command as it was in the last scan; only a scan
// without any request goes idle. The arbiter says "no command" in both cases, so the idle case is derived here from the same inputs.
fbArbiter.bStop := bStopActive;
fbArbiter.bPower := bPowerActive;
fbArbiter.bInitializing := fbStartup.Initializing;
fbArbiter.bPark := bParkActive AND NOT bParkHeld;
fbArbiter.bGoHome := bGoHomeActive;
fbArbiter.bGoto := bGotoActive;
fbArbiter.bSlew := bSlewActive;
fbArbiter.bTrack := bTrackActive;
fbArbiter.bError := bError;
fbArbiter.bEmergencyPark := _EmergencyPark();
fbArbiter.bReady := bReady;
fbArbiter.bBusy := bBusy;
fbArbiter.bStopped := _AtRest();
fbArbiter.bMoveAbortPending := bMoveAbortPending;
fbArbiter.bParkWinsOverPowerOn := TRUE;	// #87
bRequestIdle := NOT (bStopActive OR bPowerActive OR bParkActive OR bGoHomeActive OR bGotoActive OR bSlewActive OR bTrackActive
	OR (bMoveAbortPending AND NOT bError));
bWasPower := bPowerActive;
bWasPark := bParkActive;
bWasGoHome := bGoHomeActive;
bWasMove := bGotoActive OR bSlewActive;
fbArbiter();

// #80: a stop always aborts a startup, also when bPower is already FALSE; the park that aborts a power-on does too (#87).
// The flag it looks at is the one of the scan, before the clears below.
IF fbArbiter.bAbortStartup THEN
	fbStartup.MarkAbortedIfStarting(Power := bPowerActive);
END_IF
IF fbArbiter.bClearPower THEN
	bPowerActive := FALSE;
END_IF
IF fbArbiter.bClearTrack THEN
	bTrackActive := FALSE;
END_IF
IF fbArbiter.bClearPark THEN
	bParkActive := FALSE;
END_IF
IF fbArbiter.bClearGoto THEN
	bGotoActive := FALSE;
END_IF
IF fbArbiter.bClearSlew THEN
	bSlewActive := FALSE;
END_IF
IF fbArbiter.bClearGoHome THEN
	bGoHomeActive := FALSE;
END_IF
// #26: the interrupted state machines reset their stage in one call with bInterrupted TRUE; bInterrupted is a one-shot
IF fbArbiter.bInterruptPower OR fbArbiter.bInterruptPark OR fbArbiter.bInterruptGoto OR fbArbiter.bInterruptSlew
		OR fbArbiter.bInterruptGoHome THEN
	bInterrupted := TRUE;
	IF fbArbiter.bInterruptPower THEN
		_InterruptPower();
	END_IF
	IF fbArbiter.bInterruptPark THEN
		_InterruptPark();
	END_IF
	IF fbArbiter.bInterruptGoto THEN
		_InterruptGoto();
	END_IF
	IF fbArbiter.bInterruptSlew THEN
		_InterruptSlew();
	END_IF
	IF fbArbiter.bInterruptGoHome THEN
		_InterruptGoHome();
	END_IF
	bInterrupted := FALSE;
END_IF
IF fbArbiter.bSetMoveAbortPending THEN
	bMoveAbortPending := TRUE;	// #84
END_IF
IF fbArbiter.bPowerAbortedByPark THEN
	bPowerAbortedByPark := TRUE;	// #87, logged below
END_IF
_AfterArbiter();

IF fbArbiter.eCommand <> E_TCSCommand.no_command THEN
	TCS_command := fbArbiter.eCommand;
ELSIF bRequestIdle THEN
	TCS_command := E_TCSCommand.no_command;
	_DropAxisCommands();
END_IF

// #56: each command counts its timeout from its own dispatch. A preemption never has a scan without command, so
// the timer used to go on from the previous command (a stop after a long track timed out in its first scan).
IF TCS_command <> eTimeoutCommand THEN
	tonCommandTimeout(IN := FALSE);
	eTimeoutCommand := TCS_command;
	_OnCommandChanged();
END_IF

IF TCS_command = E_TCSCommand.poweron THEN
	_DoPowerOn();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.poweron, PT := _CommandTimeout(TCS_command), nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'POWER';
ELSIF TCS_command = E_TCSCommand.stop THEN
	_DoStop();
	TCSCTOEvent.OnMessage := 'STOP';
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.stop, PT := _CommandTimeout(TCS_command), nDivisor := nTimeDivisor);
ELSIF TCS_command = E_TCSCommand.park THEN
	_DoPark();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.park, PT := _CommandTimeout(TCS_command), nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'PARK';
ELSIF TCS_command = E_TCSCommand.gohome THEN
	_DoGoHome();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.gohome, PT := _CommandTimeout(TCS_command), nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'GOHOME';
ELSIF TCS_command = E_TCSCommand.goto THEN
	_DoGoto();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.goto, PT := _CommandTimeout(TCS_command), nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'GOTO';
ELSIF TCS_command = E_TCSCommand.slew THEN
	_DoSlew();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.slew, PT := _CommandTimeout(TCS_command), nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'SLEW';
ELSIF TCS_command = E_TCSCommand.track THEN
	_DoTrack();
	tonCommandTimeout(IN := TCS_command = E_TCSCommand.track, PT := _CommandTimeout(TCS_command), nDivisor := nTimeDivisor);
	TCSCTOEvent.OnMessage := 'TRACK';
ELSE
	// disable command timeout
	tonCommandTimeout(IN := FALSE);
	TCSCTOEvent.OnMessage := 'NOCOMMAND';
END_IF
_AfterDispatch();

_UpdateStatus();
(* STATUS STATES*)
// Public completion is latched only by the final startup stage, never by mechanical bReady alone.
fReadyState := fbStartup.Update(
    Error := bError OR bSoftwareError OR bPowerFailure OR bEstopTriggered,
    Parked := bIsParked,
    Parking := _ReadyStateParking(),
    Operational := bReady AND bMainReady AND NOT bEstopTriggered,
    AbortExtra := bEstopTriggered);
//MotionState
IF bStopped THEN
	nMotionState := 0;
ELSIF _IsSlewing() OR bBusy THEN
	nMotionState := 1;
ELSIF bTracking THEN
	nMotionState := 8;
END_IF

// unset the STOP command if the telescope is stopped (#96: and the stop transaction has settled)
_ReleaseStop();
_ReleaseReset();
_SafeStateEndOfScan();

// send telemetry
// The readiness field uses its existing topic and numeric format.
IF fbStartup.PublishDue(CommValid := fbComm <> 0, Heartbeat := FALSE) THEN
    fbComm.PublishLREAL('telescope', 'dome', 'TELESCOPE.READY_STATE', fReadyState);
END_IF
tonMQTTTimer.PT := _TelemetryPeriod();
tonMQTTTimer(IN:=TRUE);
IF tonMQTTTimer.Q THEN
	tonMQTTTimer(IN:=FALSE);
	_SendTelemetry();
END_IF

_LogEvents();
_EndOfScan();

// #24 step 5: edge memory of the command inputs (the #83 gate snapshot, now of the inputs, not of the requests). A method
// called after this point sets its b*Checked TRUE until the next snapshot, so an input that rises meanwhile is not a second
// command. In manual mode (SuspendAutomatic) the snapshot is not taken: an input that rose during manual acts on the return.
bGoHomeChecked := bGoHome;
bGotoChecked := bGoto;
bSlewChecked := bSlew;
bTrackChecked := bTrack;
bPowerChecked := bPower;
bParkChecked := bPark;
bStopChecked := bStop;
bResetChecked := bReset;]]></ST>
    </Implementation>
    <Folder Name="template hooks" Id="{892e0f4f-2438-4e72-9ccc-d183d3585e4b}" />
    <Method Name="_PublishTelemetry" Id="{6dec3368-4b87-4c9c-96fd-ac4ed46b70ff}">
      <Declaration><![CDATA[METHOD _PublishTelemetry : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// fbComm is only ever set via FB_Init(comm := ...); nothing enforces that a consumer actually
// does, and calling through an unassigned interface reference crashes the whole PLC task (#7)
IF fbComm = 0 THEN
	RETURN;
END_IF

(* TELESCOPE module*)

//fbComm.Publish('telescope', 'dome', 'TELESCOPE.READY_STATE',	LREAL_TO_STRING(fReadyState));
//fbComm.Publish('telescope', 'dome', 'TELESCOPE.Motion_STATE',	LREAL_TO_STRING(nMotionState));

// static INFO/CONFIG fields never change at runtime: publish once immediately, then only every
// 30s afterward, instead of on every call to this method (#22). Gated here rather than in the
// cyclic body so it still applies when a subclass calls this method directly on its own timer
// instead of going through FB_BaseTelescopeControl's own cyclic body (e.g. MONETcommon's
// FB_MonetTelescopeControl, which never calls SUPER^() from its main body)
tonStaticTelemetryTimer(IN:=TRUE);
IF NOT bStaticTelemetrySent OR tonStaticTelemetryTimer.Q THEN
	tonStaticTelemetryTimer(IN:=FALSE);
	bStaticTelemetrySent := TRUE;
	_PublishStaticTelemetry();
END_IF

// STATUS
IF bEstopTriggered THEN
	fbComm.PublishINT('telescope', 'dome', 'TELESCOPE.STATUS.GLOBAL', 1);
ELSIF bError THEN
	fbComm.PublishINT('telescope', 'dome', 'TELESCOPE.STATUS.GLOBAL', 2);
ELSE
	fbComm.PublishINT('telescope', 'dome', 'TELESCOPE.STATUS.GLOBAL', 0);
END_IF
(* ERROR LIST: TO BE IMPLEMENTED!!!*)

(* OBJECT Module*)

// INSTRUMENTAL
// Set Coords from outside | GoTo:RA DEC | Slew:Alt Az
fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.INSTRUMENTAL.RA', fRightAscension);
fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.INSTRUMENTAL.DEC', fDeclination);
fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.INSTRUMENTAL.ALT', fElevation);
fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.INSTRUMENTAL.AZ', fAzimuth);

// HORIZONTAL
IF bSlew THEN
	fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.HORIZONTAL.ALT', fElevation);
	fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.HORIZONTAL.AZ', fAzimuth);
ELSE
	fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.HORIZONTAL.ALT', fElevationCalc);
	fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.HORIZONTAL.AZ', fAzimuthCalc);
END_IF

//EQUATORIAL
fbComm.PublishString('telescope', 'dome', 'OBJECT.EQUATORIAL.EPOCH', 'J2000.0');
fbComm.PublishString('telescope', 'dome', 'OBJECT.EQUATORIAL.EQUINOX', 'J2000.0');
fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.RA_PM', 0.0);
fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.DEC_PM', 0.0);
fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.RA_RATE', 0.0);
fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.DEC_RATE', 0.0);
// all angles in the telemetry are degrees, RA included, like the rightascension command (#37)
IF bSlew THEN
	fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.RA', fRightAscensionCalc);
	fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.DEC', fDeclinationCalc);
ELSE
	fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.RA', fRightAscension);
	fbComm.PublishLREAL('telescope', 'dome', 'OBJECT.EQUATORIAL.DEC', fDeclination);
END_IF

(*POSITION*)
//LOCAL
fbComm.PublishLREAL('telescope', 'dome', 'POSITION.LOCAL.SIDEREAL_TIME', fLst);
fbComm.PublishLREAL('telescope', 'dome', 'POSITION.LOCAL.JD', fJd);
fbComm.PublishLREAL('telescope', 'dome', 'POSITION.LOCAL.LATITUDE', telescopeConfig.latitude);
fbComm.PublishLREAL('telescope', 'dome', 'POSITION.LOCAL.LONGITUDE', telescopeConfig.longitude);
fbComm.PublishLREAL('telescope', 'dome', 'POSITION.LOCAL.HEIGHT', telescopeConfig.altitude);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_PublishStaticTelemetry" Id="{9c1b6e2a-7f34-4d8e-a5b1-3e6f8c2d9a47}">
      <Declaration><![CDATA[METHOD _PublishStaticTelemetry : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// see _PublishTelemetry's identical guard (#7)
IF fbComm = 0 THEN
	RETURN;
END_IF

// fields that never change at runtime -- published on their own slow timer (see the cyclic
// body), not on _PublishTelemetry's fast 1-5s cadence (#22)

// INFO
fbComm.PublishString('telescope', 'dome', 'TELESCOPE.INFO.NAME', telescopeConfig.name);
fbComm.PublishLREAL('telescope', 'dome', 'TELESCOPE.INFO.DIAMETER', telescopeConfig.diameter);
fbComm.PublishString('telescope', 'dome', 'TELESCOPE.INFO.CABINET', telescopeConfig.cabinet);
fbComm.PublishString('telescope', 'dome', 'TELESCOPE.INFO.MANUFACTURER', telescopeConfig.manufacturer);

// CONFIG
fbComm.PublishINT('telescope', 'dome', 'TELESCOPE.CONFIG.CAPABILITIES', 0); // no ST_TelescopeConfig field for this yet
fbComm.PublishString('telescope', 'dome', 'TELESCOPE.CONFIG.MOUNTOPTIONS', telescopeConfig.mountOptions);
fbComm.PublishString('telescope', 'dome', 'TELESCOPE.CONFIG.MOUNT', telescopeConfig.mount);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_UpdateClock" Id="{c5141413-9d80-47a4-a950-6f1e2ae97825}">
      <Declaration><![CDATA[// Reads the astronomical clock and sets fJd (only while the clock is valid, otherwise the last value stays) and fLst.
// Returns TRUE while the clock is valid. A derived block that does not call SUPER^() from its body calls this once per
// scan (MONETcommon and IAG50cm do the same inline). What to do without valid time (stop pointing) is the caller's decision.
METHOD PROTECTED _UpdateClock : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbTime();
IF fbTime.bValid THEN
	fJd := DateTime2JD(fbTime.time_RTCEX2);
END_IF
fLst := CT2LST(telescopeConfig.longitude, fJd);
_UpdateClock := fbTime.bValid;
]]></ST>
      </Implementation>
    </Method>
