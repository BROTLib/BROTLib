    <Method Name="_LogEvents" Id="{8e86cd0b-e91d-430a-8a49-bfe56732ef9e}" FolderPath="template hooks\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4). The log events of this scan.
METHOD PROTECTED ABSTRACT _LogEvents
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="_EndOfScan" Id="{42545af6-a788-4a74-85c7-9dd599ed4a79}" FolderPath="template hooks\">
      <Declaration><![CDATA[// Hook of the template body (BROTLib#25 step 5.4). End of the scan, before the edge snapshot.
METHOD PROTECTED _EndOfScan
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ReleaseStop" Id="{0028dbac-59d2-49bf-9e5f-8ad56b877162}" FolderPath="template hooks\">
      <Declaration><![CDATA[// Once the stop has settled, release the stop request and the abort stop; a park queued behind the stop runs now.
// Called by the body; a derived block may call it as well (MONETcommon's SuspendAutomatic).
METHOD PROTECTED _ReleaseStop
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _StopSettled() THEN
	bStopActive := FALSE;
	IF TCS_command = E_TCSCommand.stop THEN
		bMoveAbortPending := FALSE;	// only after STOP was dispatched in this scan
		_OnAbortStopReleased();
	END_IF
	IF bParkAfterStop AND NOT bStopActive THEN
		// a park sent during the stop runs now (from the next scan)
		bParkActive := TRUE;
		bParkAfterStop := FALSE;
	END_IF
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Altitude" Id="{caafb587-dfec-4075-98b5-4e0c659dd422}">
      <Declaration><![CDATA[PROPERTY Altitude : LREAL
]]></Declaration>
      <Get Name="Get" Id="{3eadfa0f-91b9-4d35-b2a2-3995bf1ad272}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Altitude := THIS^.fElevationCurrent;]]></ST>
        </Implementation>
      </Get>
    </Property>
