<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_MotionConfigValid" Id="{9430c9f0-324b-4335-880a-9242fcc4c800}" SpecialFunc="None">
    <Declaration><![CDATA[// TRUE if an ST_MotionConfig can be used (MONETcommon#24, step 2a): every move velocity > 0, every timeout > 0,
// both elevation windows ordered (min < max), horizon and track margins >= 0, track time caps > 0. The defaults
// are valid. FB_MonetTelescopeControl is to refuse an invalid configuration with an error, like F_HomeBelowHorizon.
FUNCTION F_MotionConfigValid : BOOL
VAR_INPUT
	stConfig	: ST_MotionConfig;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_MotionConfigValid :=
	stConfig.fAzimuthMoveVelocity > 0.0
	AND stConfig.fDerotatorMoveVelocity > 0.0
	AND stConfig.fElevationMoveVelocity > 0.0
	AND stConfig.tStateMachineTimeout > T#0S
	AND stConfig.tCommandTimeout > T#0S
	AND stConfig.tIdleParkTimeout > T#0S
	AND stConfig.tPowerOnTimeout > T#0S
	AND stConfig.tTrackTimeout > T#0S
	AND stConfig.tStopTimeout > T#0S
	AND stConfig.tSuspendStopTimeout > T#0S
	AND stConfig.fGotoMinElevation < stConfig.fGotoMaxElevation
	AND stConfig.fTrackMinElevation < stConfig.fTrackMaxElevation
	AND stConfig.fHorizonMargin >= 0.0
	AND stConfig.fAzimuthTrackMargin >= 0.0
	AND stConfig.fDerotatorTrackMargin >= 0.0
	AND stConfig.fAzimuthTrackTimeCap > 0.0
	AND stConfig.fDerotatorTrackTimeCap > 0.0;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
