<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_CommandState" Id="{2f662648-c436-4d78-b5aa-d083b171e1b2}">
    <Declaration><![CDATA[// #83/#87: the telescope state F_CommandAcceptance decides on (filled by FB_MonetTelescopeControl._CommandState).
TYPE ST_CommandState :
STRUCT
	bEstop			: BOOL;
	bError			: BOOL;
	bClockValid		: BOOL;
	bStop			: BOOL;
	bPowering		: BOOL;		// bPower OR fbStartup.Initializing
	bParkPending	: BOOL;		// bPark OR bParkAfterStop
	bIsParked		: BOOL;
	bReady			: BOOL;
	bGoHomeActive	: BOOL;		// bGoHome OR TCS_command = gohome
	bMoveActive		: BOOL;		// slew/goto/track flag or command, bTracking or bMoveAbortPending (own flag excluded)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
