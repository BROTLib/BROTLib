<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.11">
  <POU Name="FB_EventLog" Id="{3524ed80-3787-4549-a84e-d995fc3a40dc}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EventLog
VAR_INPUT
	Trigger			: BOOL;
	// ADSLOG_MSGTYPE_HINT or ADSLOG_MSGTYPE_WARN or ADSLOG_MSGTYPE_ERROR
	Level			: UDINT := ADSLOG_MSGTYPE_HINT;
	FormatString	: STRING(255) := '%s';
	OnMessage		: STRING(255) := '';
	OffMessage		: STRING(255) := '';
	OffLevel		: UDINT := ADSLOG_MSGTYPE_HINT;
	Comm			: I_Comm;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	LogonTrigger	: R_TRIG;
	LogoffTrigger	: F_TRIG; // R_Trig or F_Trig ?!
	PayloadMessage	: STRING(255);
	fbFormat		: FB_FormatString;
	// OffLevel is a VAR_INPUT; fall back to Level in a local instead of writing back into it
	effectiveOffLevel	: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[LogonTrigger(CLK := Trigger);
LogoffTrigger(CLK := Trigger);
// in case the OffLevel is not set use the default Level Value
effectiveOffLevel := OffLevel;
IF effectiveOffLevel = 0 THEN
	effectiveOffLevel := Level;
END_IF
IF LogonTrigger.Q AND LEN(OnMessage)>0 THEN
	ADSLOGSTR( Level OR ADSLOG_MSGTYPE_LOG, FormatString, OnMessage);
END_IF

IF LogoffTrigger.Q AND LEN(OffMessage)>0 THEN
	ADSLOGSTR( effectiveOffLevel OR ADSLOG_MSGTYPE_LOG, FormatString, OffMessage);
END_IF

// same length check as the ADS log above (>0), so a one-character message is not local-only.
// Comm <> 0: it's a plain VAR_INPUT, nothing stops a caller from leaving it unassigned, and
// calling through it would crash the whole PLC task (#7) -- the ADS log above still happens
// either way, only the MQTT publish is skipped
IF LogonTrigger.Q AND LEN(OnMessage)>0 AND Comm <> 0 THEN
	fbFormat( sFormat := FormatString, arg1 := F_STRING(OnMessage), sOut => PayloadMessage);
	Comm.PublishLog(_LevelToString(Level), PayloadMessage);
END_IF

IF LogoffTrigger.Q AND LEN(OffMessage)>0 AND Comm <> 0 THEN
	fbFormat( sFormat := FormatString, arg1 := F_STRING(OffMessage), sOut => PayloadMessage);
	Comm.PublishLog(_LevelToString(effectiveOffLevel), PayloadMessage);
END_IF
]]></ST>
    </Implementation>
    <Method Name="_LevelToString" Id="{7a3e5c91-4b82-4f6a-9d3e-2c8b1f6a9d54}">
      <Declaration><![CDATA[METHOD PRIVATE _LevelToString : STRING
VAR_INPUT
	level	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// bit-test rather than = against the raw constant: a caller combining Level with another flag
// (e.g. the ADSLOG_MSGTYPE_LOG bit this FB itself ORs in for ADSLOGSTR) must still match its
// actual severity here instead of always falling through to ERROR
IF (level AND ADSLOG_MSGTYPE_ERROR) <> 0 THEN
	_LevelToString := 'ERROR';
ELSIF (level AND ADSLOG_MSGTYPE_WARN) <> 0 THEN
	_LevelToString := 'WARNING';
ELSE
	_LevelToString := 'INFO';
END_IF]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_EventLog">
      <LineId Id="27" Count="1" />
