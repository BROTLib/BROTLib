<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
<DUT Name="ST_HmiAxisStatus" Id="{ddb5ad49-e0cd-4f7d-ae56-82146703090f}">
<Declaration><![CDATA[// One axis slot of ST_HmiStatus.aAxis (slots 1..nAxisCount; the focus is one of them, role focus).
TYPE ST_HmiAxisStatus :
STRUCT
	bPresent		: BOOL;
	stInfo			: ST_HmiAxisInfo;	// copy of the descriptor (focus: limits from I_Focus)
	fPosition		: LREAL;			// ActualPosition, unit sUnit
	fTarget			: LREAL;			// Position (target) as read through the interface
	bEnabled		: BOOL;
	bReady			: BOOL;
	bBusy			: BOOL;
	bCalibrated		: BOOL;
	bError			: BOOL;
	nErrorID		: UDINT;
	bInPosLimit		: BOOL;
	bInNegLimit		: BOOL;
	bTracking		: BOOL;				// I_Axis.isTracking (FALSE for the focus)
	nJogDirection	: SINT;				// the HMI jog the gateway currently drives: -1/0/+1
	bHmiMoveActive	: BOOL;				// a MoveAxisTo of the HMI is running on this axis
END_STRUCT
END_TYPE
]]></Declaration>
</DUT>
</TcPlcObject>