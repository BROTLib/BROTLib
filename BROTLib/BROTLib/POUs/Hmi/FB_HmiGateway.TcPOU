<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
<POU Name="FB_HmiGateway" Id="{009b732a-b2b1-49cf-ae88-47c085ce6ce8}" SpecialFunc="None">
<Declaration><![CDATA[// Thin adapter that makes the I_* interfaces reachable over ADS for the HMI (BROTweb): it takes interface references as
// inputs, exposes a fixed set of RPC methods ({attribute 'TcRpcEnable'}) and publishes one flat status struct (stStatus).
// It holds no telescope logic: every command ends in an interface call, so all checks of the implementation apply unchanged.
// Contract: specs/design/ui-tiers-and-hmi-gateway.md. Instantiate it at MAIN.Hmi and call it ONCE PER CYCLE, UNCONDITIONALLY, in the
// task that runs the axis blocks and BEFORE them (the dead-man of the HMI jog lives here, section 7).
// An RPC only validates (the gateway's own gates) and queues; the cyclic body executes (mailbox, section 5.5).
FUNCTION_BLOCK FB_HmiGateway
VAR_INPUT
	ipAltAz				: I_AltAzTelescope;		// at most one of ipAltAz/ipRaDec; the assigned one is the gateway's I_Telescope
	ipRaDec				: I_RaDecTelescope;		//   and decides the mount type
	ipCabinet			: I_Cabinet;			// unassigned: every motion RPC is rejected (rejected_no_cabinet)
	aipAxes				: ARRAY[1..GVL_Hmi.MAX_AXES] OF I_Axis;	// mount axes, derotator(s); the assigned ones become slots 1..n in this order
	astAxisInfo			: ARRAY[1..GVL_Hmi.MAX_AXES] OF ST_HmiAxisInfo;
	ipFocus				: I_Focus;				// appended as the next axis slot, role focus
	stFocusInfo			: ST_HmiAxisInfo;
	ipCovers			: I_MirrorCovers;
	ipHydraulics		: I_Hydraulics;
	ipBrake				: I_Brake;
	ipRoof				: I_Roof;
	ipDome				: I_Dome;
	ipFilter			: I_Filter;
	ipNasmyth			: I_Nasmyth;
	ipTelescopeStatus	: I_TelescopeStatus;	// optional, same object as ipAltAz/ipRaDec
	ipSafety			: I_SafetyDiagnostics;	// optional
	bTelescopeRunsInLocal	: BOOL;				// project constant: TRUE where the telescope control runs with the switch on Local (IAG50cm),
												//   FALSE where Local suspends it (MONETS, MONETN); replaced by NOT ipTelescopeStatus.Suspended where wired
	tJogTimeout			: TIME := T#400MS;		// dead-man timeout: no Jog call for this long releases the jog (the HMI calls every 150 ms)
END_VAR
VAR_OUTPUT
	stStatus			: ST_HmiStatus;			// the only symbol the HMI reads
END_VAR
VAR
	ipTelescope			: I_Telescope;			// each cycle: ipAltAz if assigned, else ipRaDec
	// derived each cycle
	bCabinet			: BOOL;
	bLocal				: BOOL;
	bPendant			: BOOL;
	bEstop				: BOOL;
	bSafetyError		: BOOL;
	bMotionAllowed		: BOOL;					// Local AND NOT pendant AND cabinet assigned
	bTelescopeCmds		: BOOL;					// telescope-level commands available
	bConfigError		: BOOL;
	eMount				: E_HmiMountType;
	nAxes				: INT;					// axis slots in use, the focus included
	nFocusSlot			: INT;					// slot of the focus, 0 = none
	aipSlot				: ARRAY[1..GVL_Hmi.MAX_AXES] OF I_BaseAxis;
	aipAxis				: ARRAY[1..GVL_Hmi.MAX_AXES] OF I_Axis;		// 0 for the focus slot
	aInfo				: ARRAY[1..GVL_Hmi.MAX_AXES] OF ST_HmiAxisInfo;
	// mailbox
	aRequest			: ARRAY[0..GVL_Hmi.SLOT_LAST] OF ST_HmiRequest;
	nCommandId			: UDINT;
	stLast				: ST_HmiCommandRecord;
	nHeartbeat			: UDINT;
	// jog (section 7)
	bJogOwned			: BOOL;
	nJogAxis			: INT;
	nJogDir				: SINT;
	bJogSlow			: BOOL;
	nJogToken			: UDINT;
	bJogCalled			: BOOL;					// a valid Jog call arrived since the last cycle: restarts the watchdog
	bJogRelease			: BOOL;					// a release was requested (Jog with direction 0, reversal)
	tonJog				: TON;
	// MoveAxisTo (section 5.4.1)
	aMove				: ARRAY[1..GVL_Hmi.MAX_AXES] OF ST_HmiMove;
	aTonMove			: ARRAY[1..GVL_Hmi.MAX_AXES] OF TON;
	stEmptyAxis			: ST_HmiAxisStatus;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[nHeartbeat := nHeartbeat + 1;
_Derive();
_ExecuteRequests();
_ServiceJog();
_ServiceMoves();
_PublishStatus();
]]></ST>
</Implementation>
<Method Name="_Post" Id="{3b6d49c8-a0f3-48c9-9d4d-5d1825038b1d}">
<Declaration><![CDATA[// Queues a request in the mailbox slot of its group; the cyclic body executes it (section 5.5).
METHOD PRIVATE _Post : E_HmiResult
VAR_INPUT
	nSlot		: INT;
	eCommand	: E_HmiCommand;
	nAxis		: USINT;
	fA			: LREAL;
	fB			: LREAL;
	bFlag		: BOOL;
	nValue		: DINT;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[IF aRequest[nSlot].bFull THEN
	_Post := E_HmiResult.rejected_busy;
	RETURN;
END_IF
nCommandId := nCommandId + 1;
aRequest[nSlot].bFull := TRUE;
aRequest[nSlot].eCommand := eCommand;
aRequest[nSlot].nId := nCommandId;
aRequest[nSlot].nAxis := nAxis;
aRequest[nSlot].fA := fA;
aRequest[nSlot].fB := fB;
aRequest[nSlot].bFlag := bFlag;
aRequest[nSlot].nValue := nValue;
_Post := E_HmiResult.queued;
]]></ST>
</Implementation>
</Method>
<Method Name="_GateMotion" Id="{27adc8a4-333b-4ecb-850a-f10044f61bd3}">
<Declaration><![CDATA[// The gate every HMI motion command passes: a cabinet, switch on Local, no pendant (section 4.2, 4.3).
METHOD PRIVATE _GateMotion : E_HmiResult
]]></Declaration>
<Implementation>
<ST><![CDATA[IF NOT bCabinet THEN
	_GateMotion := E_HmiResult.rejected_no_cabinet;
ELSIF NOT bLocal THEN
	_GateMotion := E_HmiResult.rejected_remote;
ELSIF bPendant THEN
	_GateMotion := E_HmiResult.rejected_pendant;
ELSE
	_GateMotion := E_HmiResult.queued;
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="_GateTelescope" Id="{0d909500-18eb-42e5-ad25-c23ee443b412}">
<Declaration><![CDATA[// Motion gate plus a telescope whose commands are available (section 5.3).
METHOD PRIVATE _GateTelescope : E_HmiResult
]]></Declaration>
<Implementation>
<ST><![CDATA[_GateTelescope := _GateMotion();
IF _GateTelescope = E_HmiResult.queued AND NOT bTelescopeCmds THEN
	_GateTelescope := E_HmiResult.rejected_no_telescope;
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="_GateAxis" Id="{3fa72f50-b574-48c1-a8c3-dc76c0127dbd}">
<Declaration><![CDATA[// Motion gate plus a present axis slot.
METHOD PRIVATE _GateAxis : E_HmiResult
VAR_INPUT
	nAxis	: INT;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[_GateAxis := _GateMotion();
IF _GateAxis <> E_HmiResult.queued THEN
	RETURN;
END_IF
IF nAxis < 1 OR nAxis > GVL_Hmi.MAX_AXES THEN
	_GateAxis := E_HmiResult.rejected_argument;
ELSIF nAxis > nAxes THEN
	_GateAxis := E_HmiResult.rejected_absent;
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="_GateSub" Id="{1810ed1d-6f2b-4d1a-a266-d4fcad59a16d}">
<Declaration><![CDATA[// Motion gate (bStopDirection FALSE) plus a present subsystem.
METHOD PRIVATE _GateSub : E_HmiResult
VAR_INPUT
	bPresent			: BOOL;
	bStopDirection		: BOOL;		// stop direction commands are allowed in every mode
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[IF NOT bPresent THEN
	_GateSub := E_HmiResult.rejected_absent;
ELSIF bStopDirection THEN
	_GateSub := E_HmiResult.queued;
ELSE
	_GateSub := _GateMotion();
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="_IsStopDirection" Id="{7879c71c-969b-4eb0-b99a-12e0d4c9dd98}">
<Declaration><![CDATA[METHOD PRIVATE _IsStopDirection : BOOL
VAR_INPUT
	eCommand	: E_HmiCommand;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[_IsStopDirection := eCommand = E_HmiCommand.stop OR eCommand = E_HmiCommand.covers_stop OR eCommand = E_HmiCommand.roof_stop OR eCommand = E_HmiCommand.dome_stop;
]]></ST>
</Implementation>
</Method>
<Method Name="_IsTelescopeLevel" Id="{00571663-fd64-4608-b303-54637ef95eae}">
<Declaration><![CDATA[METHOD PRIVATE _IsTelescopeLevel : BOOL
VAR_INPUT
	eCommand	: E_HmiCommand;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[_IsTelescopeLevel := eCommand = E_HmiCommand.init OR eCommand = E_HmiCommand.park OR eCommand = E_HmiCommand.home OR eCommand = E_HmiCommand.slew OR
	eCommand = E_HmiCommand.slew_ha_dec OR eCommand = E_HmiCommand.track OR eCommand = E_HmiCommand.reset;
]]></ST>
</Implementation>
</Method>
<Method Name="_IsReset" Id="{52ec9d3e-d4b2-4873-81e0-501267a6c160}">
<Declaration><![CDATA[METHOD PRIVATE _IsReset : BOOL
VAR_INPUT
	eCommand	: E_HmiCommand;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[_IsReset := eCommand = E_HmiCommand.reset OR eCommand = E_HmiCommand.reset_axis OR eCommand = E_HmiCommand.covers_reset OR
	eCommand = E_HmiCommand.hydraulics_reset OR eCommand = E_HmiCommand.roof_reset OR eCommand = E_HmiCommand.dome_reset;
]]></ST>
</Implementation>
</Method>
<Method Name="Init" Id="{ff8100d6-2eb4-416f-abb3-1e5b6da0c1dc}">
<Declaration><![CDATA[// Power on and initialise; bOpenCovers as MQTT power=1 (TRUE) / power=2 (FALSE). Local + bTelescopeCommands.
{attribute 'TcRpcEnable'}
METHOD Init : E_HmiResult
VAR_INPUT
	bOpenCovers	: BOOL;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[Init := _GateTelescope();
IF Init = E_HmiResult.queued THEN
	Init := _Post(nSlot := GVL_Hmi.SLOT_TELESCOPE, eCommand := E_HmiCommand.init, nAxis := 0, fA := 0.0, fB := 0.0, bFlag := bOpenCovers, nValue := 0);
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="Park" Id="{6f488d5e-cf13-44dc-b9d4-b0fa180e743e}">
<Declaration><![CDATA[// Local + bTelescopeCommands.
{attribute 'TcRpcEnable'}
METHOD Park : E_HmiResult
VAR_INPUT
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[Park := _GateTelescope();
IF Park = E_HmiResult.queued THEN
	Park := _Post(nSlot := GVL_Hmi.SLOT_TELESCOPE, eCommand := E_HmiCommand.park, nAxis := 0, fA := 0.0, fB := 0.0, bFlag := FALSE, nValue := 0);
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="Home" Id="{c1fc4779-2cc8-424a-aac0-7cbe0d2b11af}">
<Declaration><![CDATA[// Local + bTelescopeCommands.
{attribute 'TcRpcEnable'}
METHOD Home : E_HmiResult
VAR_INPUT
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[Home := _GateTelescope();
IF Home = E_HmiResult.queued THEN
	Home := _Post(nSlot := GVL_Hmi.SLOT_TELESCOPE, eCommand := E_HmiCommand.home, nAxis := 0, fA := 0.0, fB := 0.0, bFlag := FALSE, nValue := 0);
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="Slew" Id="{b5106e16-481b-4131-ac8c-885bb17c04dd}">
<Declaration><![CDATA[// Alt-az pointing in degrees. Local + bTelescopeCommands.
{attribute 'TcRpcEnable'}
METHOD Slew : E_HmiResult
VAR_INPUT
	fAzimuth	: LREAL;
	fAltitude	: LREAL;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[Slew := _GateTelescope();
IF Slew <> E_HmiResult.queued THEN
	RETURN;
END_IF
// the same ranges as the MQTT handler; NaN and infinity fail every comparison
IF NOT (fAzimuth >= -360.0 AND fAzimuth <= 360.0 AND fAltitude >= -90.0 AND fAltitude <= 90.0) THEN
	Slew := E_HmiResult.rejected_argument;
	RETURN;
END_IF
Slew := _Post(nSlot := GVL_Hmi.SLOT_TELESCOPE, eCommand := E_HmiCommand.slew, nAxis := 0, fA := fAzimuth, fB := fAltitude, bFlag := FALSE, nValue := 0);
]]></ST>
</Implementation>
</Method>
<Method Name="SlewHaDec" Id="{797d1c3f-1e54-4380-9f0a-ce166cebef22}">
<Declaration><![CDATA[// Native move to apparent HA/Dec in degrees without tracking (I_RaDecTelescope.SlewHaDec); radec mounts only. Local + bTelescopeCommands.
{attribute 'TcRpcEnable'}
METHOD SlewHaDec : E_HmiResult
VAR_INPUT
	fHourAngle	: LREAL;
	fDeclination	: LREAL;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[SlewHaDec := _GateTelescope();
IF SlewHaDec <> E_HmiResult.queued THEN
	RETURN;
END_IF
IF ipRaDec = 0 THEN
	SlewHaDec := E_HmiResult.rejected_absent;
	RETURN;
END_IF
IF NOT (fHourAngle >= -360.0 AND fHourAngle <= 360.0 AND fDeclination >= -90.0 AND fDeclination <= 90.0) THEN
	SlewHaDec := E_HmiResult.rejected_argument;
	RETURN;
END_IF
SlewHaDec := _Post(nSlot := GVL_Hmi.SLOT_TELESCOPE, eCommand := E_HmiCommand.slew_ha_dec, nAxis := 0, fA := fHourAngle, fB := fDeclination, bFlag := FALSE, nValue := 0);
]]></ST>
</Implementation>
</Method>
<Method Name="Track" Id="{300fb3cf-2d4d-4aca-a1a7-07ae6c7520b4}">
<Declaration><![CDATA[// ICRS degrees (the HMI converts from h:m:s). Local + bTelescopeCommands.
{attribute 'TcRpcEnable'}
METHOD Track : E_HmiResult
VAR_INPUT
	fRightAscension	: LREAL;
	fDeclination	: LREAL;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[Track := _GateTelescope();
IF Track <> E_HmiResult.queued THEN
	RETURN;
END_IF
IF NOT (fRightAscension >= 0.0 AND fRightAscension <= 360.0 AND fDeclination >= -90.0 AND fDeclination <= 90.0) THEN
	Track := E_HmiResult.rejected_argument;
	RETURN;
END_IF
Track := _Post(nSlot := GVL_Hmi.SLOT_TELESCOPE, eCommand := E_HmiCommand.track, nAxis := 0, fA := fRightAscension, fB := fDeclination, bFlag := FALSE, nValue := 0);
]]></ST>
</Implementation>
</Method>
<Method Name="Stop" Id="{15a878fa-d449-4046-9233-fb11611cba39}">
<Declaration><![CDATA[// Stops the telescope and the focus, releases an HMI jog and stops a running HMI MoveAxisTo. Allowed in every mode.
{attribute 'TcRpcEnable'}
METHOD Stop : E_HmiResult
VAR_INPUT
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[// stop direction: allowed in every mode, also while the pendant is active
IF ipTelescope = 0 AND nAxes = 0 THEN
	Stop := E_HmiResult.rejected_absent;
	RETURN;
END_IF
Stop := _Post(nSlot := GVL_Hmi.SLOT_STOP, eCommand := E_HmiCommand.stop, nAxis := 0, fA := 0.0, fB := 0.0, bFlag := FALSE, nValue := 0);
]]></ST>
</Implementation>
</Method>
<Method Name="Reset" Id="{5edb791e-5c77-4fa4-9de7-0c5955ed8786}">
<Declaration><![CDATA[// Reset counts as motion: Local + bTelescopeCommands.
{attribute 'TcRpcEnable'}
METHOD Reset : E_HmiResult
VAR_INPUT
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[Reset := _GateTelescope();
IF Reset = E_HmiResult.queued THEN
	Reset := _Post(nSlot := GVL_Hmi.SLOT_TELESCOPE, eCommand := E_HmiCommand.reset, nAxis := 0, fA := 0.0, fB := 0.0, bFlag := FALSE, nValue := 0);
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="Jog" Id="{88f8c175-f55a-4169-912e-9b5600f66dfe}">
<Declaration><![CDATA[// Jog while pressed (section 7): the HMI calls every 150 ms while the button is held and once with nDirection 0 on release.
// nDirection -1/0/+1, 0 = release (a stop direction command, any mode). nToken identifies the browser session (7.2).
{attribute 'TcRpcEnable'}
METHOD Jog : E_HmiResult
VAR_INPUT
	nAxis	: USINT;
	nDirection	: SINT;
	bSlow	: BOOL;
	nToken	: UDINT;
END_VAR
VAR
	i	: INT;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[Jog := E_HmiResult.queued;
IF nDirection < -1 OR nDirection > 1 THEN
	Jog := E_HmiResult.rejected_argument;
	RETURN;
END_IF
i := nAxis;
IF nDirection = 0 THEN
	// release: not gated by the mode, but only the owner can release
	IF bJogOwned THEN
		IF nToken = nJogToken THEN
			bJogRelease := TRUE;
		ELSE
			Jog := E_HmiResult.rejected_jog_owner;
		END_IF
	END_IF
	RETURN;
END_IF
Jog := _GateAxis(i);
IF Jog <> E_HmiResult.queued THEN
	RETURN;
END_IF
IF NOT aInfo[i].bCanJog OR bEstop OR bSafetyError THEN
	Jog := E_HmiResult.rejected_not_allowed;
ELSIF bJogOwned AND nToken <> nJogToken THEN
	Jog := E_HmiResult.rejected_jog_owner;
ELSIF aMove[i].nState <> 0 THEN
	Jog := E_HmiResult.rejected_axis_busy;
ELSIF bJogOwned AND (i <> nJogAxis OR nDirection <> nJogDir) THEN
	// another axis or a reversal: the old jog is released first, the new one needs a call of its own
	bJogRelease := TRUE;
	Jog := E_HmiResult.rejected_axis_busy;
ELSIF (nDirection > 0 AND (aipSlot[i].InPosLimit OR aipSlot[i].ActualPosition >= aInfo[i].fMax)) OR
		(nDirection < 0 AND (aipSlot[i].InNegLimit OR aipSlot[i].ActualPosition <= aInfo[i].fMin)) THEN
	Jog := E_HmiResult.rejected_not_allowed;
ELSIF NOT bJogOwned AND aipSlot[i].Busy THEN
	Jog := E_HmiResult.rejected_axis_busy;
ELSE
	// the levels are written by the cyclic body
	bJogOwned := TRUE;
	nJogAxis := i;
	nJogDir := nDirection;
	bJogSlow := bSlow;
	nJogToken := nToken;
	bJogCalled := TRUE;
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="HomeAxis" Id="{d8412504-b15b-495a-9388-a6863b4e4a7b}">
<Declaration><![CDATA[// Rising edge of HomeAxis. Local; only if bCanHome.
{attribute 'TcRpcEnable'}
METHOD HomeAxis : E_HmiResult
VAR_INPUT
	nAxis	: USINT;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[HomeAxis := _GateAxis(nAxis);
IF HomeAxis <> E_HmiResult.queued THEN
	RETURN;
END_IF
IF NOT aInfo[nAxis].bCanHome THEN
	HomeAxis := E_HmiResult.rejected_not_allowed;
	RETURN;
END_IF
IF aipSlot[nAxis].HomeAxis THEN
	// a homing is already requested or running: a write would not be an edge
	HomeAxis := E_HmiResult.rejected_axis_busy;
	RETURN;
END_IF
HomeAxis := _Post(nSlot := GVL_Hmi.SLOT_AXIS + nAxis, eCommand := E_HmiCommand.home_axis, nAxis := nAxis, fA := 0.0, fB := 0.0, bFlag := FALSE, nValue := 0);
]]></ST>
</Implementation>
</Method>
<Method Name="EnableAxis" Id="{f93a86ff-854a-4b58-996d-76cbdf3e8358}">
<Declaration><![CDATA[// Switches the axis enable (disable too: a motion command). Local; only if bCanEnable.
{attribute 'TcRpcEnable'}
METHOD EnableAxis : E_HmiResult
VAR_INPUT
	nAxis	: USINT;
	bEnable	: BOOL;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[EnableAxis := _GateAxis(nAxis);
IF EnableAxis <> E_HmiResult.queued THEN
	RETURN;
END_IF
IF NOT aInfo[nAxis].bCanEnable THEN
	EnableAxis := E_HmiResult.rejected_not_allowed;
	RETURN;
END_IF
EnableAxis := _Post(nSlot := GVL_Hmi.SLOT_AXIS + nAxis, eCommand := E_HmiCommand.enable_axis, nAxis := nAxis, fA := 0.0, fB := 0.0, bFlag := bEnable, nValue := 0);
]]></ST>
</Implementation>
</Method>
<Method Name="MoveAxisTo" Id="{aeece181-944f-4de2-9a25-faa333eefd92}">
<Declaration><![CDATA[// Go-to-position of one axis in its unit, within the descriptor's fMin..fMax (section 5.4.1). A command, not hold-to-run;
// stopped by Stop(), by the switch going to Remote, by the pendant and by E-stop/safety error. Local; only if bCanMoveTo.
{attribute 'TcRpcEnable'}
METHOD MoveAxisTo : E_HmiResult
VAR_INPUT
	nAxis	: USINT;
	fPosition	: LREAL;
END_VAR
VAR
	i	: INT;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[i := nAxis;
MoveAxisTo := _GateAxis(i);
IF MoveAxisTo <> E_HmiResult.queued THEN
	RETURN;
END_IF
IF NOT aInfo[i].bCanMoveTo OR aipAxis[i] = 0 THEN
	MoveAxisTo := E_HmiResult.rejected_not_allowed;
ELSIF NOT (fPosition >= aInfo[i].fMin AND fPosition <= aInfo[i].fMax) THEN
	MoveAxisTo := E_HmiResult.rejected_argument;
ELSIF bEstop OR bSafetyError OR NOT aipSlot[i].Ready OR NOT aipSlot[i].Calibrated OR aipSlot[i].Error THEN
	MoveAxisTo := E_HmiResult.rejected_not_allowed;
ELSIF aipSlot[i].Busy OR aipAxis[i].isTracking OR aipAxis[i].MoveAxis OR aMove[i].nState <> 0 OR (bJogOwned AND nJogAxis = i) THEN
	MoveAxisTo := E_HmiResult.rejected_axis_busy;
ELSE
	MoveAxisTo := _Post(nSlot := GVL_Hmi.SLOT_AXIS + i, eCommand := E_HmiCommand.move_axis_to, nAxis := nAxis, fA := fPosition, fB := 0.0, bFlag := FALSE, nValue := 0);
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="ResetAxis" Id="{4c74c57c-712f-4f39-9db2-0fe701387715}">
<Declaration><![CDATA[// Resets one axis (counts as motion): Local.
{attribute 'TcRpcEnable'}
METHOD ResetAxis : E_HmiResult
VAR_INPUT
	nAxis	: USINT;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[ResetAxis := _GateAxis(nAxis);
IF ResetAxis = E_HmiResult.queued THEN
	ResetAxis := _Post(nSlot := GVL_Hmi.SLOT_AXIS + nAxis, eCommand := E_HmiCommand.reset_axis, nAxis := nAxis, fA := 0.0, fB := 0.0, bFlag := FALSE, nValue := 0);
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="MoveFocus" Id="{66d49e42-b36a-4ccc-bbb8-c95ee5689eb6}">
<Declaration><![CDATA[// Sets the focus target within I_Focus.MinPosition..MaxPosition (the focus follower moves it). Local.
{attribute 'TcRpcEnable'}
METHOD MoveFocus : E_HmiResult
VAR_INPUT
	fPosition	: LREAL;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[MoveFocus := _GateMotion();
IF MoveFocus <> E_HmiResult.queued THEN
	RETURN;
END_IF
IF nFocusSlot = 0 THEN
	MoveFocus := E_HmiResult.rejected_absent;
ELSIF NOT (fPosition >= aInfo[nFocusSlot].fMin AND fPosition <= aInfo[nFocusSlot].fMax) THEN
	// MinPosition..MaxPosition of the focus, as the MQTT focus verb checks it
	MoveFocus := E_HmiResult.rejected_argument;
ELSIF bJogOwned AND nJogAxis = nFocusSlot THEN
	MoveFocus := E_HmiResult.rejected_axis_busy;
ELSE
	MoveFocus := _Post(nSlot := GVL_Hmi.SLOT_AXIS + nFocusSlot, eCommand := E_HmiCommand.move_focus, nAxis := INT_TO_USINT(nFocusSlot), fA := fPosition, fB := 0.0, bFlag := FALSE, nValue := 0);
END_IF
]]></ST>
</Implementation>
</Method>
