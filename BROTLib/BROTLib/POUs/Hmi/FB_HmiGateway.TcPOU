<Method Name="_Derive" Id="{97de1396-10a5-480a-918e-151758f0fd35}">
<Declaration><![CDATA[METHOD PRIVATE _Derive
VAR
	i	: INT;
	j	: INT;
	bTelescopeRuns	: BOOL;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[// Everything the gates and the status need, from the actual state of the interfaces, every cycle (section 5.3).
bCabinet := ipCabinet <> 0;
IF bCabinet THEN
	bLocal := ipCabinet.ControlMode = E_ControlMode.local;
	bPendant := ipCabinet.PendantActive;
	bEstop := ipCabinet.EstopActive;
	bSafetyError := ipCabinet.SafetyError;
ELSE
	bLocal := FALSE;
	bPendant := FALSE;
	bEstop := FALSE;
	bSafetyError := FALSE;
END_IF
bMotionAllowed := bCabinet AND bLocal AND NOT bPendant;
bConfigError := FALSE;

// mount type: derived from which telescope input is wired, never configured
IF ipAltAz <> 0 AND ipRaDec <> 0 THEN
	bConfigError := TRUE;
	eMount := E_HmiMountType.none;
	ipTelescope := 0;
ELSIF ipAltAz <> 0 THEN
	eMount := E_HmiMountType.altaz;
	ipTelescope := ipAltAz;
ELSIF ipRaDec <> 0 THEN
	eMount := E_HmiMountType.radec;
	ipTelescope := ipRaDec;
ELSE
	eMount := E_HmiMountType.none;
	ipTelescope := 0;
END_IF
IF ipTelescopeStatus <> 0 THEN
	bTelescopeRuns := NOT ipTelescopeStatus.Suspended;
ELSE
	bTelescopeRuns := bTelescopeRunsInLocal;
END_IF
bTelescopeCmds := eMount <> E_HmiMountType.none AND bMotionAllowed AND bTelescopeRuns;

// axis slots: the assigned axes in order, then the focus
FOR i := 1 TO GVL_Hmi.MAX_AXES DO
	aipSlot[i] := 0;
	aipAxis[i] := 0;
END_FOR
nAxes := 0;
nFocusSlot := 0;
FOR i := 1 TO GVL_Hmi.MAX_AXES DO
	IF aipAxes[i] <> 0 THEN
		nAxes := nAxes + 1;
		aipSlot[nAxes] := aipAxes[i];
		aipAxis[nAxes] := aipAxes[i];
		aInfo[nAxes] := astAxisInfo[i];
	END_IF
END_FOR
IF ipFocus <> 0 THEN
	IF nAxes < GVL_Hmi.MAX_AXES THEN
		nAxes := nAxes + 1;
		nFocusSlot := nAxes;
		aipSlot[nAxes] := ipFocus;
		aInfo[nAxes] := stFocusInfo;
		aInfo[nAxes].eRole := E_HmiAxisRole.focus;
		aInfo[nAxes].fMin := ipFocus.MinPosition;	// the travel the focus accepts, not the descriptor
		aInfo[nAxes].fMax := ipFocus.MaxPosition;
	ELSE
		bConfigError := TRUE;
	END_IF
END_IF
// duplicate axis roles are a configuration error (role other may repeat)
FOR i := 1 TO nAxes - 1 DO
	FOR j := i + 1 TO nAxes DO
		IF aInfo[i].eRole <> E_HmiAxisRole.other AND aInfo[i].eRole = aInfo[j].eRole THEN
			bConfigError := TRUE;
		END_IF
	END_FOR
END_FOR
]]></ST>
</Implementation>
</Method>
<Method Name="_Record" Id="{3d87c280-7fc1-49da-bf3b-56c0ed88d401}">
<Declaration><![CDATA[METHOD PRIVATE _Record
VAR_INPUT
	nId	: UDINT;
	eCommand	: E_HmiCommand;
	bAccepted	: BOOL;
	eReason	: E_CommandRejectReason;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[stLast.nId := nId;
stLast.eCommand := eCommand;
stLast.bAccepted := bAccepted;
stLast.eTelescopeReason := eReason;
stLast.nCycle := nHeartbeat;
]]></ST>
</Implementation>
</Method>
<Method Name="_ExecuteRequests" Id="{b67f4a39-fefb-4ca1-a268-211cd8c42a93}">
<Declaration><![CDATA[METHOD PRIVATE _ExecuteRequests
VAR
	nPass	: INT;
	i	: INT;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[// One command per group per cycle, in a defined order: stop direction first, then resets, then the rest (section 5.5).
FOR nPass := 0 TO 2 DO
	FOR i := GVL_Hmi.SLOT_STOP TO GVL_Hmi.SLOT_LAST DO
		IF aRequest[i].bFull THEN
			IF (nPass = 0 AND _IsStopDirection(aRequest[i].eCommand)) OR
				(nPass = 1 AND NOT _IsStopDirection(aRequest[i].eCommand) AND _IsReset(aRequest[i].eCommand)) OR
				(nPass = 2 AND NOT _IsStopDirection(aRequest[i].eCommand) AND NOT _IsReset(aRequest[i].eCommand)) THEN
				_Execute(nSlot := i);
			END_IF
		END_IF
	END_FOR
END_FOR
]]></ST>
</Implementation>
</Method>
<Method Name="_Execute" Id="{e994ae2d-92b0-4887-ac1e-6f3b9bdd8378}">
<Declaration><![CDATA[METHOD PRIVATE _Execute
VAR_INPUT
	nSlot	: INT;
END_VAR
VAR
	stReq	: ST_HmiRequest;
	bOk	: BOOL;
	i	: INT;
	nRejBefore	: UDINT;
	eReason	: E_CommandRejectReason;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[// Takes the request out of its slot, re-checks the gates of this cycle and calls the interface. Only here (and in the
// service methods below) are the I_* interfaces written, never in an RPC.
stReq := aRequest[nSlot];
aRequest[nSlot].bFull := FALSE;
IF (NOT _IsStopDirection(stReq.eCommand) AND NOT bMotionAllowed) OR (_IsTelescopeLevel(stReq.eCommand) AND NOT bTelescopeCmds) THEN
	// the switch, the pendant or the telescope state changed between the RPC and this cycle
	_Record(stReq.nId, stReq.eCommand, FALSE, E_CommandRejectReason.none);
	RETURN;
END_IF
IF ipTelescopeStatus <> 0 THEN
	nRejBefore := ipTelescopeStatus.RejectCount;
END_IF
i := stReq.nAxis;
bOk := FALSE;
CASE stReq.eCommand OF
E_HmiCommand.init:
	ipTelescope.CoverAutoOpen := stReq.bFlag;
	bOk := ipTelescope.Init();
E_HmiCommand.park:
	bOk := ipTelescope.Park();
E_HmiCommand.home:
	bOk := ipTelescope.Home();
E_HmiCommand.slew:
	bOk := ipTelescope.Slew(stReq.fA, stReq.fB);
E_HmiCommand.slew_ha_dec:
	IF ipRaDec <> 0 THEN
		bOk := ipRaDec.SlewHaDec(stReq.fA, stReq.fB);
	END_IF
E_HmiCommand.track:
	bOk := ipTelescope.Track(stReq.fA, stReq.fB);
E_HmiCommand.reset:
	bOk := ipTelescope.Reset();
E_HmiCommand.stop:
	// stops the telescope and the focus, releases the HMI jog and stops the HMI moves
	IF ipTelescope <> 0 THEN
		ipTelescope.Stop();
	END_IF
	IF ipFocus <> 0 THEN
		ipFocus.Stop();
	END_IF
	_ReleaseJog();
	FOR i := 1 TO nAxes DO
		IF aMove[i].nState <> 0 THEN
			_StopMove(nAxis := i);
		END_IF
	END_FOR
	bOk := TRUE;
E_HmiCommand.home_axis:
	IF i >= 1 AND i <= nAxes THEN
		aipSlot[i].HomeAxis := TRUE;	// FALSE -> TRUE starts homing; TRUE already means a homing is requested or running
		bOk := TRUE;
	END_IF
E_HmiCommand.enable_axis:
	IF i >= 1 AND i <= nAxes THEN
		aipSlot[i].Enable := stReq.bFlag;
		bOk := TRUE;
	END_IF
E_HmiCommand.reset_axis:
	IF i >= 1 AND i <= nAxes THEN
		bOk := aipSlot[i].Reset();
	END_IF
E_HmiCommand.move_axis_to:
	IF i >= 1 AND i <= nAxes AND_THEN aipAxis[i] <> 0 THEN
		// maintenance velocity by write-and-restore (5.4.1); restored once the axis reports the move started
		aMove[i].fSavedVelocity := aipSlot[i].Velocity;
		aMove[i].fMaintVelocity := 0.0;
		IF aInfo[i].fMaintVelocity > 0.0 THEN
			aMove[i].fMaintVelocity := aInfo[i].fMaintVelocity;
			aipSlot[i].Velocity := aInfo[i].fMaintVelocity;
		END_IF
		aipSlot[i].Position := stReq.fA;
		aipAxis[i].MoveAxis := FALSE;
		aipAxis[i].MoveAxis := TRUE;	// each request is an edge of its own
		aMove[i].nState := 2;
		aTonMove[i](IN := FALSE, PT := T#1S);
		bOk := TRUE;
	END_IF
E_HmiCommand.move_focus:
	IF ipFocus <> 0 THEN
		ipFocus.Position := stReq.fA;
		bOk := TRUE;
	END_IF
E_HmiCommand.covers_open:
	IF ipCovers <> 0 THEN
		bOk := ipCovers.Open();
	END_IF
E_HmiCommand.covers_close:
	IF ipCovers <> 0 THEN
		bOk := ipCovers.Close();
	END_IF
E_HmiCommand.covers_stop:
	IF ipCovers <> 0 THEN
		bOk := ipCovers.Stop();
	END_IF
E_HmiCommand.covers_reset:
	IF ipCovers <> 0 THEN
		bOk := ipCovers.Reset();
	END_IF
E_HmiCommand.hydraulics_enable:
	IF ipHydraulics <> 0 THEN
		ipHydraulics.Enable := stReq.bFlag;
		bOk := TRUE;
	END_IF
E_HmiCommand.hydraulics_reset:
	IF ipHydraulics <> 0 THEN
		bOk := ipHydraulics.Reset();
	END_IF
E_HmiCommand.roof_open:
	IF ipRoof <> 0 THEN
		bOk := ipRoof.Open();
	END_IF
E_HmiCommand.roof_close:
	IF ipRoof <> 0 THEN
		bOk := ipRoof.Close();
	END_IF
E_HmiCommand.roof_stop:
	IF ipRoof <> 0 THEN
		bOk := ipRoof.Stop();
	END_IF
E_HmiCommand.roof_reset:
	IF ipRoof <> 0 THEN
		bOk := ipRoof.Reset();
	END_IF
E_HmiCommand.dome_open:
	IF ipDome <> 0 THEN
		bOk := ipDome.Open();
	END_IF
E_HmiCommand.dome_close:
	IF ipDome <> 0 THEN
		bOk := ipDome.Close();
	END_IF
E_HmiCommand.dome_park:
	IF ipDome <> 0 THEN
		bOk := ipDome.Park();
	END_IF
E_HmiCommand.dome_stop:
	IF ipDome <> 0 THEN
		bOk := ipDome.Stop();
	END_IF
E_HmiCommand.dome_reset:
	IF ipDome <> 0 THEN
		bOk := ipDome.Reset();
	END_IF
E_HmiCommand.set_filter:
	IF ipFilter <> 0 THEN
		bOk := ipFilter.SetFilter(DINT_TO_USINT(stReq.nValue));
	END_IF
E_HmiCommand.set_nasmyth:
	IF ipNasmyth <> 0 THEN
		bOk := ipNasmyth.SetNasmyth(DINT_TO_INT(stReq.nValue));
	END_IF
END_CASE
eReason := E_CommandRejectReason.none;
IF _IsTelescopeLevel(stReq.eCommand) AND_THEN ipTelescopeStatus <> 0 AND_THEN ipTelescopeStatus.RejectCount <> nRejBefore THEN
	eReason := ipTelescopeStatus.LastRejectReason;
END_IF
_Record(stReq.nId, stReq.eCommand, bOk, eReason);
]]></ST>
</Implementation>
</Method>
<Method Name="_ReleaseJog" Id="{3f5422a6-3346-4cc7-a520-952ac82ff756}">
<Declaration><![CDATA[METHOD PRIVATE _ReleaseJog
]]></Declaration>
<Implementation>
<ST><![CDATA[// Writes the jog levels of the owned axis FALSE ONCE and drops the ownership, the way the pendant releases (MONETcommon#3), so a
// jog that the pendant or the VISU starts later is not overwritten.
IF bJogOwned AND_THEN nJogAxis >= 1 AND_THEN nJogAxis <= nAxes THEN
	aipSlot[nJogAxis].MovePos := FALSE;
	aipSlot[nJogAxis].MoveNeg := FALSE;
	aipSlot[nJogAxis].JogSlow := FALSE;
END_IF
bJogOwned := FALSE;
nJogDir := 0;
bJogRelease := FALSE;
bJogCalled := FALSE;
]]></ST>
</Implementation>
</Method>
<Method Name="_ServiceJog" Id="{ad33d683-fc04-4c5c-8c6c-66217973b505}">
<Declaration><![CDATA[METHOD PRIVATE _ServiceJog
VAR
	i	: INT;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[// The dead-man (section 7): the levels are written every cycle while the jog is valid and released on any condition of 7.1.
IF NOT bJogOwned THEN
	bJogRelease := FALSE;
	bJogCalled := FALSE;
	tonJog(IN := FALSE, PT := tJogTimeout);
	RETURN;
END_IF
i := nJogAxis;
tonJog(IN := NOT bJogCalled, PT := tJogTimeout);	// every valid call restarts the watchdog
bJogCalled := FALSE;
IF i < 1 OR i > nAxes THEN
	_ReleaseJog();
ELSIF bJogRelease OR NOT bMotionAllowed OR bEstop OR bSafetyError OR aipSlot[i].Error THEN
	// release request, switch to Remote, pendant, E-stop, safety error or axis error
	_ReleaseJog();
ELSIF (nJogDir > 0 AND (aipSlot[i].InPosLimit OR aipSlot[i].ActualPosition >= aInfo[i].fMax)) OR
		(nJogDir < 0 AND (aipSlot[i].InNegLimit OR aipSlot[i].ActualPosition <= aInfo[i].fMin)) THEN
	_ReleaseJog();
ELSIF tonJog.Q THEN
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'HMI jog %s released: no keep-alive', aInfo[i].sName);
	_ReleaseJog();
ELSE
	aipSlot[i].MovePos := nJogDir > 0;
	aipSlot[i].MoveNeg := nJogDir < 0;
	aipSlot[i].JogSlow := bJogSlow;
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="_RestoreVelocity" Id="{26329332-d518-443c-bf51-daa3ca1a8535}">
<Declaration><![CDATA[METHOD PRIVATE _RestoreVelocity
VAR_INPUT
	nAxis	: INT;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[// Restores the velocity the move overwrote, but never over a value someone else wrote meanwhile (5.4.1).
IF aMove[nAxis].fMaintVelocity > 0.0 AND_THEN aipSlot[nAxis].Velocity = aMove[nAxis].fMaintVelocity THEN
	aipSlot[nAxis].Velocity := aMove[nAxis].fSavedVelocity;
END_IF
aMove[nAxis].fMaintVelocity := 0.0;
]]></ST>
</Implementation>
</Method>
<Method Name="_StopMove" Id="{24d76a0f-8b21-42dd-b865-2b5cc28d7f60}">
<Declaration><![CDATA[METHOD PRIVATE _StopMove
VAR_INPUT
	nAxis	: INT;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[// One StopAxis edge on an axis with a running HMI MoveAxisTo.
_RestoreVelocity(nAxis := nAxis);
IF aipAxis[nAxis] <> 0 THEN
	aipAxis[nAxis].StopAxis := FALSE;
	aipAxis[nAxis].StopAxis := TRUE;
END_IF
aMove[nAxis].nState := 0;
]]></ST>
</Implementation>
</Method>
<Method Name="_ServiceMoves" Id="{b4bf79ab-da49-4184-bf99-86c7f6e19378}">
<Declaration><![CDATA[METHOD PRIVATE _ServiceMoves
VAR
	i	: INT;
	bStopNow	: BOOL;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[// Follows the HMI MoveAxisTo moves (5.4.1): restores the velocity once the axis reports the move started, ends when it is over,
// stops it once when the switch goes to Remote, the pendant takes over, or E-stop / safety error.
bStopNow := NOT bMotionAllowed OR bEstop OR bSafetyError;
FOR i := 1 TO nAxes DO
	IF aMove[i].nState = 0 THEN
		aTonMove[i](IN := FALSE, PT := T#1S);
	ELSIF bStopNow THEN
		_StopMove(nAxis := i);
	ELSIF aMove[i].nState = 2 THEN
		aTonMove[i](IN := TRUE, PT := T#1S);
		IF aipSlot[i].Busy THEN
			_RestoreVelocity(nAxis := i);
			aMove[i].nState := 3;
		ELSIF aTonMove[i].Q THEN
			// not started within 1 s (the axis refused it): the move is over
			_RestoreVelocity(nAxis := i);
			aMove[i].nState := 0;
		END_IF
	ELSIF aMove[i].nState = 3 THEN
		IF NOT aipSlot[i].Busy OR aipSlot[i].Error THEN
			aMove[i].nState := 0;
		END_IF
	END_IF
END_FOR
]]></ST>
</Implementation>
</Method>
<Method Name="_Set" Id="{397bdc7c-c284-47e4-a0c5-b46bda0d7d0f}">
<Declaration><![CDATA[// Sets the bit of one blocker in stStatus.nBlockers.
METHOD PRIVATE _Set
VAR_INPUT
	bCondition	: BOOL;
	eBlocker	: E_HmiBlocker;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[IF bCondition THEN
	stStatus.nBlockers := stStatus.nBlockers OR SHL(DWORD#1, TO_INT(eBlocker));
END_IF
]]></ST>
</Implementation>
</Method>
<Method Name="_PublishStatus" Id="{91e9d53e-6e19-4511-9754-6cbf56df3098}">
<Declaration><![CDATA[METHOD PRIVATE _PublishStatus
VAR
	i	: INT;
	bAxisError	: BOOL;
	bNotCalibrated	: BOOL;
	bInLimit	: BOOL;
	bItemNotOk	: BOOL;
END_VAR
]]></Declaration>
<Implementation>
<ST><![CDATA[stStatus.nContractMajor := GVL_Hmi.CONTRACT_MAJOR;
stStatus.nContractMinor := GVL_Hmi.CONTRACT_MINOR;
stStatus.sLibVersion := Global_Version.stLibVersion_BROTLib.sVersion;
stStatus.nHeartbeat := nHeartbeat;
stStatus.nBlockers := 0;

// cabinet and safety
IF bCabinet THEN
	stStatus.eControlMode := ipCabinet.ControlMode;
	stStatus.bSwitchPresent := ipCabinet.SwitchPresent;
	stStatus.bSafetyAckPending := ipCabinet.SafetyAckPending;
ELSE
	stStatus.eControlMode := E_ControlMode.remote;
	stStatus.bSwitchPresent := FALSE;
	stStatus.bSafetyAckPending := FALSE;
END_IF
stStatus.bEstop := bEstop;
stStatus.bSafetyError := bSafetyError;
stStatus.bPendantActive := bPendant;
stStatus.bHmiMotionAllowed := bMotionAllowed;
stStatus.bTelescopeCommands := bTelescopeCmds;

// telescope
stStatus.eMountType := eMount;
stStatus.bTelescope := eMount <> E_HmiMountType.none;
IF stStatus.bTelescope THEN
	stStatus.fReadyState := ipTelescope.ReadyState;
	stStatus.fAzimuth := ipTelescope.Azimuth;
	stStatus.fAltitude := ipTelescope.Altitude;
	stStatus.fTargetRA := ipTelescope.RightAscension;
	stStatus.fTargetDec := ipTelescope.Declination;
ELSE
	stStatus.fReadyState := 0.0;
	stStatus.fAzimuth := 0.0;
	stStatus.fAltitude := 0.0;
	stStatus.fTargetRA := 0.0;
	stStatus.fTargetDec := 0.0;
END_IF
stStatus.stLastCommand := stLast;
IF ipTelescopeStatus <> 0 THEN
	stStatus.stTelescopeStatus.bStatusPresent := TRUE;
	stStatus.stTelescopeStatus.bError := ipTelescopeStatus.Error;
	stStatus.stTelescopeStatus.nErrorID := ipTelescopeStatus.ErrorID;
	stStatus.stTelescopeStatus.bBusy := ipTelescopeStatus.Busy;
	stStatus.stTelescopeStatus.bIsParked := ipTelescopeStatus.IsParked;
	stStatus.stTelescopeStatus.bSuspended := ipTelescopeStatus.Suspended;
	stStatus.stTelescopeStatus.eLastRejectedCommand := ipTelescopeStatus.LastRejectedCommand;
	stStatus.stTelescopeStatus.eLastRejectReason := ipTelescopeStatus.LastRejectReason;
	stStatus.stTelescopeStatus.nRejectCount := ipTelescopeStatus.RejectCount;
	stStatus.stTelescopeStatus.fCurrentRA := ipTelescopeStatus.CurrentRightAscension;
	stStatus.stTelescopeStatus.fCurrentDec := ipTelescopeStatus.CurrentDeclination;
ELSE
	stStatus.stTelescopeStatus.bStatusPresent := FALSE;
	stStatus.stTelescopeStatus.bError := FALSE;
	stStatus.stTelescopeStatus.nErrorID := 0;
	stStatus.stTelescopeStatus.bBusy := FALSE;
	stStatus.stTelescopeStatus.bIsParked := FALSE;
	stStatus.stTelescopeStatus.bSuspended := FALSE;
	stStatus.stTelescopeStatus.eLastRejectedCommand := E_TCSCommand.no_command;
	stStatus.stTelescopeStatus.eLastRejectReason := E_CommandRejectReason.none;
	stStatus.stTelescopeStatus.nRejectCount := 0;
	stStatus.stTelescopeStatus.fCurrentRA := 0.0;
	stStatus.stTelescopeStatus.fCurrentDec := 0.0;
END_IF

// axes
stStatus.nAxisCount := INT_TO_USINT(nAxes);
FOR i := 1 TO GVL_Hmi.MAX_AXES DO
	IF i <= nAxes THEN
		stStatus.aAxis[i].bPresent := TRUE;
		stStatus.aAxis[i].stInfo := aInfo[i];
		stStatus.aAxis[i].fPosition := aipSlot[i].ActualPosition;
		stStatus.aAxis[i].fTarget := aipSlot[i].Position;
		stStatus.aAxis[i].bEnabled := aipSlot[i].Enable;
		stStatus.aAxis[i].bReady := aipSlot[i].Ready;
		stStatus.aAxis[i].bBusy := aipSlot[i].Busy;
		stStatus.aAxis[i].bCalibrated := aipSlot[i].Calibrated;
		stStatus.aAxis[i].bError := aipSlot[i].Error;
		stStatus.aAxis[i].nErrorID := aipSlot[i].ErrorID;
		stStatus.aAxis[i].bInPosLimit := aipSlot[i].InPosLimit;
		stStatus.aAxis[i].bInNegLimit := aipSlot[i].InNegLimit;
		stStatus.aAxis[i].bTracking := aipAxis[i] <> 0 AND_THEN aipAxis[i].isTracking;
		IF bJogOwned AND nJogAxis = i THEN
			stStatus.aAxis[i].nJogDirection := nJogDir;
		ELSE
			stStatus.aAxis[i].nJogDirection := 0;
		END_IF
		stStatus.aAxis[i].bHmiMoveActive := aMove[i].nState <> 0;
		bAxisError := bAxisError OR aipSlot[i].Error;
		bNotCalibrated := bNotCalibrated OR (aInfo[i].bCanHome AND NOT aipSlot[i].Calibrated);
		bInLimit := bInLimit OR aipSlot[i].InPosLimit OR aipSlot[i].InNegLimit;
	ELSE
		stStatus.aAxis[i] := stEmptyAxis;
	END_IF
END_FOR

// subsystems
stStatus.stCovers.bPresent := ipCovers <> 0;
IF ipCovers <> 0 THEN
	stStatus.stCovers.bOpened := ipCovers.Opened;
	stStatus.stCovers.bClosed := ipCovers.Closed;
	stStatus.stCovers.bError := ipCovers.Error;
ELSE
	stStatus.stCovers.bOpened := FALSE;
	stStatus.stCovers.bClosed := FALSE;
	stStatus.stCovers.bError := FALSE;
END_IF
stStatus.stHydraulics.bPresent := ipHydraulics <> 0;
IF ipHydraulics <> 0 THEN
	stStatus.stHydraulics.bEnabled := ipHydraulics.Enable;
	stStatus.stHydraulics.bPumpRunning := ipHydraulics.PumpRunning;
	stStatus.stHydraulics.bSuctionRunning := ipHydraulics.SuctionRunning;
	stStatus.stHydraulics.bOilPressureOK := ipHydraulics.OilPressureOK;
	stStatus.stHydraulics.bError := ipHydraulics.Error;
ELSE
	stStatus.stHydraulics.bEnabled := FALSE;
	stStatus.stHydraulics.bPumpRunning := FALSE;
	stStatus.stHydraulics.bSuctionRunning := FALSE;
	stStatus.stHydraulics.bOilPressureOK := FALSE;
	stStatus.stHydraulics.bError := FALSE;
END_IF
stStatus.stBrake.bPresent := ipBrake <> 0;
IF ipBrake <> 0 THEN
	stStatus.stBrake.bOpen := ipBrake.BrakeOpen;
ELSE
	stStatus.stBrake.bOpen := FALSE;
END_IF
stStatus.stRoof.bPresent := ipRoof <> 0;
IF ipRoof <> 0 THEN
	stStatus.stRoof.eState := ipRoof.State;
ELSE
	stStatus.stRoof.eState := E_RoofState.unknown;
END_IF
stStatus.stDome.bPresent := ipDome <> 0;
IF ipDome <> 0 THEN
	stStatus.stDome.fPosition := ipDome.Position;
	stStatus.stDome.eRotState := ipDome.RotState;
	stStatus.stDome.eShutterState := ipDome.ShutterState;
	stStatus.stDome.bParked := ipDome.Parked;
	stStatus.stDome.bTracking := ipDome.Tracking;
	stStatus.stDome.bError := ipDome.Error;
	stStatus.stDome.nErrorID := ipDome.ErrorID;
	stStatus.stDome.nCapabilities := ipDome.Capabilities;
ELSE
	stStatus.stDome.fPosition := 0.0;
	stStatus.stDome.eShutterState := E_RoofState.unknown;
	stStatus.stDome.bParked := FALSE;
	stStatus.stDome.bTracking := FALSE;
	stStatus.stDome.bError := FALSE;
	stStatus.stDome.nErrorID := 0;
	stStatus.stDome.nCapabilities := 0;
END_IF
stStatus.bFilter := ipFilter <> 0;
stStatus.bNasmyth := ipNasmyth <> 0;

// safety detail
stStatus.bSafetyDiagPresent := ipSafety <> 0;
IF ipSafety <> 0 THEN
	stStatus.bStoActive := ipSafety.StoActive;
	stStatus.bRestartPending := ipSafety.RestartPending;
	stStatus.stSafety := ipSafety.Items;
	FOR i := 1 TO stStatus.stSafety.nCount DO
		IF i <= 8 THEN
			bItemNotOk := bItemNotOk OR NOT stStatus.stSafety.aItem[i].bOk;
		END_IF
	END_FOR
	bItemNotOk := bItemNotOk OR stStatus.bStoActive;
END_IF

// why not ready / blockers (section 5.8)
_Set(bCondition := bEstop, eBlocker := E_HmiBlocker.estop);
_Set(bCondition := bSafetyError, eBlocker := E_HmiBlocker.safety_error);
_Set(bCondition := stStatus.bSafetyAckPending, eBlocker := E_HmiBlocker.safety_ack_pending);
_Set(bCondition := stStatus.bTelescope AND (stStatus.fReadyState = -1.0 OR stStatus.stTelescopeStatus.bError), eBlocker := E_HmiBlocker.telescope_error);
_Set(bCondition := stStatus.bTelescope AND stStatus.fReadyState <> 1.0, eBlocker := E_HmiBlocker.not_online);
_Set(bCondition := bAxisError, eBlocker := E_HmiBlocker.axis_error);
_Set(bCondition := bNotCalibrated, eBlocker := E_HmiBlocker.axis_not_calibrated);
_Set(bCondition := bInLimit, eBlocker := E_HmiBlocker.axis_in_limit);
_Set(bCondition := stStatus.stCovers.bError, eBlocker := E_HmiBlocker.covers_error);
_Set(bCondition := stStatus.stHydraulics.bError OR (stStatus.stHydraulics.bEnabled AND NOT stStatus.stHydraulics.bOilPressureOK AND stStatus.stHydraulics.bPresent), eBlocker := E_HmiBlocker.hydraulics_error);
_Set(bCondition := stStatus.stRoof.bPresent AND stStatus.stRoof.eState = E_RoofState.error, eBlocker := E_HmiBlocker.roof_error);
_Set(bCondition := stStatus.stDome.bError, eBlocker := E_HmiBlocker.dome_error);
_Set(bCondition := bCabinet AND NOT bLocal, eBlocker := E_HmiBlocker.mode_remote);
_Set(bCondition := bPendant, eBlocker := E_HmiBlocker.pendant_active);
_Set(bCondition := NOT bCabinet, eBlocker := E_HmiBlocker.no_cabinet);
_Set(bCondition := bConfigError, eBlocker := E_HmiBlocker.config_error);
_Set(bCondition := bLocal AND stStatus.bTelescope AND NOT bTelescopeCmds AND NOT bPendant, eBlocker := E_HmiBlocker.telescope_suspended_local);
_Set(bCondition := bItemNotOk, eBlocker := E_HmiBlocker.safety_item_not_ok);
]]></ST>
</Implementation>
</Method>
</POU>
</TcPlcObject>