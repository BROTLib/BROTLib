<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Axis" Id="{a3e55664-127b-4a99-a2ba-301ba26f68b3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Axis
VAR_INPUT
	// enable the axis
	Enable:		BOOL;
	// reset the axis after error
	Reset: 		BOOL;
	// target position: of the move started by MoveTo() (taken at the next call) and of tracking. Commands are the
	// methods MoveTo(), Home(fReference), Stop(), CancelMove(), CancelHome() (#63); there are no command inputs.
	Position: 	LREAL;
	// maximum velocity
	Velocity:	LREAL := 10.0;
	// expected average tracking velocity
	TrackVelocityRef: LREAL := 0.0;
	// Tracking direction (-1,0,1)
	TrackDirectionRef: INT := 0;
	// PosDiff for isTracking (arcsec)
	TrackEnvelope: LREAL := 5.0;
	// Enable movement in positive direction (considering limit switch)
	Enable_Positive:	BOOL := TRUE;
	// Enable movement in negative direction (considering limit switch)
	Enable_Negative:	BOOL := TRUE;
	// jog forward while TRUE (a level, e.g. a pendant button; read only)
	Jog_Forward:		BOOL := FALSE;
	// jog backward while TRUE (a level, read only)
	Jog_Backwards:		BOOL := FALSE;
	// calibration input for homing
	bCalibrationCam:	BOOL;
	isModuloAxis:		BOOL := FALSE;
	// enable external setpoint generator
	Tracking:			BOOL;
	HomingMode:			MC_HomingMode := MC_HomingMode.MC_DefaultHoming;
END_VAR
VAR_OUTPUT
	// Reset has been executed
	ResetDone:	BOOL;
	// the axis is in target position
	MoveDone:	BOOL;
	// the axis hass jogged
	JogDone:	BOOL;
	// the axis has stopped
	StopDone: 	BOOL;
	// a MoveTo() is waiting to start (axis not Ready/Calibrated yet, or the one-cycle low before a restart)
	MovePending:	BOOL;
	// a Home() is waiting to start (axis not Ready yet)
	HomePending:	BOOL;
	// the NC reports the axis as homed (a level, see Calibrated). It is set by the NC before the homing procedure has
	// finished, so do not use it to end homing-related overrides (limit switch bypass): use HomeActive
	HomeDone:	BOOL;
	// a homing is running: from the start of Home() until the MC_Home block is finished (Execute or Busy). FALSE when
	// idle and when the homing is complete, also on drives where the Done pulse is not seen
	HomeActive:	BOOL;
	// the axis is ready
	Ready:		BOOL;
	// the command has been aborted (a pulse of the MC block; Execute of the aborted command is released on it, #92);
	// not for the move that a MoveTo() during a move supersedes (HalfBROT#103)
	CommandAborted: BOOL;
	// axis busy
	Busy: 		BOOL;
	// axis is moving
	Active: 	BOOL;
	// axis is stopping
	Stopping:	BOOL;
	// axis is standing still (no commands issued) this should be the default
	StandStill:	BOOL;
	// axis is in motion
	InMotion:	BOOL;
	// axis is homing
	Homing:		BOOL;
	// axis is Accelerating or Decelerating
	InRamp:		BOOL;
	// axis is tracking on position
	isTracking:	BOOL;
	//	error condition
	Error: 		BOOL;
	// number of error
	ErrorID: 	UDINT;
	// actual position of the axis
	ActualPosition: LREAL;
	// axis is calibrated;
	Calibrated:	BOOL := FALSE;

END_VAR
VAR
	Axis_Power:		MC_Power;
	Axis_Reset:		MC_Reset;
	Axis_Move:		ARRAY[0..1] OF MC_MoveAbsolute;	// used alternately, see FB_MoveChannel (HalfBROT#103)
	Axis_Modulo:	ARRAY[0..1] OF MC_MoveModulo;
	//Axis_Position:	MC_ReadActualPosition;
	Axis_Stop:		MC_Stop;
	Axis_Status:	MC_ReadStatus;
	Axis_Home:		MC_Home;
	Axis_Jog: 		MC_Jog;
	Axis_SetpointEnable:	MC_ExtSetPointGenEnable;
	MoveChannel:	FB_MoveChannel;	// MoveTo()/CancelMove() (#63), a new target while moving goes to the other instance (HalfBROT#103)
	MoveSlot:		INT;			// loop index of the two move instances
	aMoveDone:		ARRAY[0..1] OF BOOL;
	aMoveAborted:	ARRAY[0..1] OF BOOL;
	aMoveBusy:		ARRAY[0..1] OF BOOL;
	HomeCommand:	FB_AxisCommand;	// Home()/CancelHome()
	StopCommand:	FB_AxisCommand;	// Stop(), idempotent (#93)
	HomeReference:	LREAL;			// reference position of the last Home() (#62)
	SetpointEnableFailed:	BOOL;	// setpoint enable failed; no retry until Reset or the end of the track request (#9)
	Axis_SetpointDisable:	MC_ExtSetPointGenDisable;
	StopAllowed:	BOOL;
	ExtActive:	BOOL;	// the setpoint generator is on or being disabled: no motion command (#101)
	// Direction for Axis_SetpointFeed
	Direction:			DINT;
	// difference between set position and measured position
	PositionDifference:	LREAL;
	TrackPosition:		LREAL;
	TrackVelocity:		LREAL;
	TrackAcceleration:	LREAL;
END_VAR

VAR_IN_OUT
	// axis reference
	AxisRef:	AXIS_REF;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// query the status of the axis at the beginning of the cycle
Axis_Status(Enable := TRUE,
			Axis := AxisRef);

// Enable the axis (power signal or manual enable)
Axis_Power(
	Axis := AxisRef,
	Enable := Enable,
	Enable_Positive := Enable_Positive,
	Enable_Negative := Enable_Negative,
	Override := 100.0,
	Status => Ready);

Axis_Reset(
	Axis := 	AxisRef,
	Execute := 	Reset,
	Done => 	ResetDone);

(* Tracking section ********************************************** *)

IF Tracking THEN
	PositionDifference := Position - ActualPosition;
	TrackPosition := Position;
	IF ABS(PositionDifference) > 0.01 THEN
		TrackVelocity := 0.05;
		TrackAcceleration := 0.05;
	ELSE
		TrackAcceleration := 0.005;
	END_IF
ELSE
	TrackPosition := ActualPosition;
	TrackVelocity := 0.0;
	TrackAcceleration := 0.0;
END_IF


IF NOT Tracking OR ABS(PositionDifference) < 1E-5 THEN
	Direction := TrackDirectionRef;
	TrackAcceleration := 0.005;
ELSIF PositionDifference < 0.0 THEN
	Direction := -1;
	IF TrackDirectionRef = -1 THEN
		TrackVelocity := ABS(LIMIT(0.0, Velocity, 0.009));
	ELSE
		TrackVelocity := ABS(LIMIT(0.0, Velocity-TrackVelocityRef, 0.009));
	END_IF

ELSE
	Direction := 1;
	IF TrackDirectionRef = 1 THEN
		TrackVelocity := ABS(LIMIT(0.0, Velocity, 0.009));
	ELSE
		TrackVelocity := ABS(LIMIT(0.0, Velocity-TrackVelocityRef, 0.009));
	END_IF
END_IF



isTracking := Tracking AND ABS(Position - ActualPosition) < (TrackEnvelope/3600.0);
// drops Execute on an error and re-arms on Reset or a new track request (#9), see F_SetpointEnableExecute
Axis_SetpointEnable.Execute := F_SetpointEnableExecute(
	Request :=	Tracking AND Ready AND Calibrated AND NOT StopCommand.Execute AND NOT StopCommand.Pending,
	Tracking :=	Tracking,
	Reset :=	Reset,
	Execute :=	Axis_SetpointEnable.Execute,
	Busy :=		Axis_SetpointEnable.Busy,
	Done :=		Axis_SetpointEnable.Done,
	Error :=	Axis_SetpointEnable.Error,
	Failed :=	SetpointEnableFailed);

// The NC target during tracking is the TrackPosition latched when MC_ExtSetPointGenEnable starts. With
// TargetPosControl Range 0.5 deg (IAG50cm), the NC InTargetPosition bit (StateDWord bit 4) of an axis moving at
// the sidereal rate (HA, 0.00418 deg/s) drops about 120 s into the track and returns on stop; Dec normally stays
// in range. This is expected (IAG50cm#121): use isTracking / bTracking, not InTargetPosition, as the tracking
// indicator. MC_Stop on an axis outside its window may need about 2 extra scans for Done (handled, IAG50cm#117).
Axis_SetpointEnable(Axis := AxisRef,
	Position :=		TrackPosition,	// final destination
	PositionType := POSITIONTYPE_ABSOLUTE);

MC_ExtSetPointGenFeed(
	Position :=		TrackPosition,
	Velocity :=		Direction*TrackVelocity,
	Acceleration :=	TrackAcceleration,
	Direction :=	Direction,
	Axis :=			AxisRef);

// #101: a stop request also disables the generator (a stop with Tracking still TRUE would otherwise wait for ever)
Axis_SetpointDisable(Axis := AxisRef,
	Execute := NOT Tracking OR StopCommand.Pending OR StopCommand.Execute);
// the NC rejects stop, move and jog with 0x4257 while the generator is on: the commands wait until it is off
ExtActive := F_ExtSetpointActive(
	StatusEnabled :=	Axis_Status.Status.ExtSetPointGenEnabled,
	DisableBusy :=		Axis_SetpointDisable.Busy,
	DisableDone :=		Axis_SetpointDisable.Done,
	DisableError :=		Axis_SetpointDisable.Error);

(* end of tracking section  ********************************************** *)

// outputs of the move instances from their last call
FOR MoveSlot := 0 TO 1 DO
	IF isModuloAxis THEN
		aMoveDone[MoveSlot] := Axis_Modulo[MoveSlot].Done;
		aMoveAborted[MoveSlot] := Axis_Modulo[MoveSlot].CommandAborted;
		aMoveBusy[MoveSlot] := Axis_Modulo[MoveSlot].Busy;
	ELSE
		aMoveDone[MoveSlot] := Axis_Move[MoveSlot].Done;
		aMoveAborted[MoveSlot] := Axis_Move[MoveSlot].CommandAborted;
		aMoveBusy[MoveSlot] := Axis_Move[MoveSlot].Busy;
	END_IF
END_FOR
// #92: Execute is released on Done or CommandAborted of the active instance
MoveChannel(Allowed := Ready AND Calibrated AND NOT ExtActive, Reset := Reset,
	aDone := aMoveDone, aAborted := aMoveAborted, aBusy := aMoveBusy);
MovePending := MoveChannel.Pending;
// HalfBROT#103: the NC ignores a rising Execute on an instance that is still Busy, so each new command goes to the
// other instance, which makes the NC abort the running move. The default BufferMode is MC_Aborting.
FOR MoveSlot := 0 TO 1 DO
	IF isModuloAxis THEN
		Axis_Modulo[MoveSlot](
			Axis := 		AxisRef,
			Execute := 		MoveChannel.aExecute[MoveSlot],
			Position := 	Position,
			Velocity :=		Velocity,
			Direction := 	MC_Shortest_Way);
	ELSE
		Axis_Move[MoveSlot](
			Axis := 		AxisRef,
			Execute := 		MoveChannel.aExecute[MoveSlot],
			Position := 	Position,
			Velocity := 	Velocity);
	END_IF
END_FOR
// the arrival of the latest command only, and not while a newer MoveTo() waits (the old move's Done is not its)
IF isModuloAxis THEN
	MoveDone := Axis_Modulo[MoveChannel.nActive].Done AND NOT MoveChannel.Pending;
ELSE
	MoveDone := Axis_Move[MoveChannel.nActive].Done AND NOT MoveChannel.Pending;
END_IF

Axis_Jog(
	JogForward := 	Jog_Forward AND Ready AND Enable_Positive AND NOT ExtActive,
	JogBackwards := Jog_Backwards AND Ready AND Enable_Negative AND NOT ExtActive,
	Mode := 		MC_JOGMODE_STANDARD_FAST,
	Done => 		JogDone,
	Axis := 		AxisRef);


HomeCommand(Allowed := Ready, Reset := Reset, Done := Axis_Home.Done, Aborted := Axis_Home.CommandAborted);	// #92
HomePending := HomeCommand.Pending;
Axis_Home(
	Axis := 			AxisRef,
	Execute := 			HomeCommand.Execute,
	Position := 		HomeReference,	// from Home(fReference), never the move target (#62)
	HomingMode :=		HomingMode,
	bCalibrationCam := 	bCalibrationCam,
	Done => 			HomeDone);
HomeActive := HomeCommand.Execute OR Axis_Home.Busy;

IF Axis_Status.Status.Homed THEN
	Calibrated := TRUE;
	// NOTE: HomeDone is a level (TRUE while the axis is homed), not a one-cycle pulse; IAG50cm's
	// FB_HourAngleControl/FB_DeclinationControl combine it with FB_LatchHome.Done. Use Calibrated.
	HomeDone := TRUE;
ELSE
	Calibrated := FALSE;
	HomeDone := FALSE;
END_IF

StopAllowed :=	Axis_Status.StandStill OR
				Axis_Status.ContinuousMotion OR
				Axis_Status.DiscreteMotion OR
				Axis_Status.SynchronizedMotion OR
				Axis_Status.Homing;

StopCommand(Allowed := StopAllowed AND NOT ExtActive, Reset := Reset, Done := Axis_Stop.Done, Aborted := Axis_Stop.CommandAborted,
	Busy := Axis_Status.Stopping, Idle := Axis_Status.StandStill);
Axis_Stop(
	Axis := 	AxisRef,
	Execute := 	StopCommand.Execute,
	Done => 	StopDone);
// #93: a Stop() joined to a stop that was already finishing reports StopDone once the axis is at rest
StopDone := StopDone OR StopCommand.Joined;
(*
Axis_Position(
	Axis := 	AxisRef,
	Enable := 	Calibrated,
	Position => AbsolutePosition);
*)
IF isModuloAxis THEN
	ActualPosition := AxisRef.NcToPlc.ModuloActPos; // required e.g. for Filterwheel
ELSE
	ActualPosition := AxisRef.NcToPlc.ActPos;
END_IF

IF Axis_Power.Error THEN
	ErrorID := Axis_Power.ErrorID;
END_IF

IF Axis_SetpointEnable.Error THEN
	ErrorID := Axis_SetpointEnable.ErrorID;
END_IF

IF Axis_Reset.Error THEN
	ErrorID := Axis_Reset.ErrorID;
END_IF

FOR MoveSlot := 0 TO 1 DO
	IF Axis_Modulo[MoveSlot].Error THEN
		ErrorID := Axis_Modulo[MoveSlot].ErrorID;
	END_IF

	IF Axis_Move[MoveSlot].Error THEN
		ErrorID := Axis_Move[MoveSlot].ErrorID;
	END_IF
END_FOR

IF Axis_Home.Error THEN
	ErrorID := Axis_Home.ErrorID;
END_IF

IF Axis_Jog.Error THEN
	ErrorID := Axis_Jog.ErrorID;
END_IF

IF Axis_Stop.Error THEN
	ErrorID := Axis_Stop.ErrorID;
END_IF

IF Axis_Status.Error THEN
	ErrorID := Axis_Status.ErrorID;
END_IF
Busy := 	Axis_SetpointEnable.Busy OR
			Axis_Reset.Busy OR
			Axis_Modulo[0].Busy OR Axis_Modulo[1].Busy OR
			Axis_Move[0].Busy OR Axis_Move[1].Busy OR
			Axis_Home.Busy OR
			Axis_Jog.Busy;

Error := 	Axis_Power.Error OR
			Axis_SetpointEnable.Error OR
			SetpointEnableFailed OR		// keeps a setpoint enable error visible after Execute dropped (#9)
			Axis_Reset.Error OR
			Axis_Modulo[0].Error OR Axis_Modulo[1].Error OR
			Axis_Move[0].Error OR Axis_Move[1].Error OR
			Axis_Home.Error OR
			Axis_Jog.Error OR
			Axis_Stop.Error OR
			Axis_Status.Error;

Active := 	// Axis_Power.Active OR //alsways true if enabled
			Axis_Modulo[0].Active OR Axis_Modulo[1].Active OR
			Axis_Move[0].Active OR Axis_Move[1].Active OR
			Axis_Home.Active OR
			Axis_Jog.Active OR
			Axis_Stop.Active;

// the abort of a superseded move instance (a MoveTo() during a move, HalfBROT#103) is not reported: it is not the end of the move
CommandAborted :=	MoveChannel.Aborted OR
					Axis_Home.CommandAborted OR
					Axis_Jog.CommandAborted OR
					Axis_Stop.CommandAborted;

IF NOT Error THEN
	ErrorID := 0;
END_IF

InMotion := Axis_Status.ConstantVelocity OR
			Axis_Status.DiscreteMotion OR
			Axis_Status.ContinuousMotion OR
			Axis_Status.SynchronizedMotion;
InRamp :=	Axis_Status.Accelerating OR
			Axis_Status.Decelerating;
Stopping := Axis_Status.Stopping;
StandStill := Axis_Status.StandStill;
Homing :=	Axis_Status.Homing;
// InPosition := AxisRef.NcToPlc.TargetPos;]]></ST>
    </Implementation>
    <Method Name="MoveTo" Id="{784bf5f8-2806-405c-9e5e-c434da6fb245}">
      <Declaration><![CDATA[// Move to Position as passed in the next call (so the caller's limits on Position apply). Starts once the axis is
// Ready and Calibrated; a MoveTo() while moving goes to the other move instance, which makes the NC abort the running
// move: the axis turns to the new Position without stopping (HalfBROT#103). MoveDone pulses when it is reached.
METHOD MoveTo : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MoveChannel.Request();
MovePending := TRUE;
MoveTo := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home" Id="{ed6fdeba-4192-411f-b040-7e71e16b4feb}">
      <Declaration><![CDATA[// Home the axis. fReference is the reference position for homing modes that assign one (cam homing: the position at
// the cam; MC_Direct: set as the current position). MC_ForceCalibration ignores it: it only sets the calibrated flag,
// no motion, position unchanged (HalfBROT #17). VAR_IN_OUT CONSTANT so that every call has to pass it (#62); it must be a variable (TwinCAT
// rejects literals and expressions here). Starts once the axis is Ready. A call while a homing is running (HomeActive)
// is ignored and returns FALSE: a second MC_Home edge would restart the homing procedure.
METHOD Home : BOOL
VAR_IN_OUT CONSTANT
	fReference	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF HomeActive THEN
	Home := FALSE;
	RETURN;
END_IF
HomeReference := fReference;
HomeCommand.Request();
HomePending := TRUE;
Home := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{3f23c5e2-5b72-477a-8fc0-71b441e818d2}">
      <Declaration><![CDATA[// Stop the axis (MC_Stop). Also drops pending MoveTo()/Home() requests, so they do not start after the stop.
// Idempotent (#93): while a stop is pending, running or still finishing (Stopping), no second MC_Stop is started and
// the call returns FALSE; StopDone still follows (from the running stop, or once the axis is at rest, so a caller can
// see two StopDone pulses for one stop). After an MC_Stop error the stop is retried. TRUE when a new MC_Stop was
// requested.
METHOD Stop : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MoveChannel.Cancel();
HomeCommand.Cancel();
MovePending := FALSE;
HomePending := FALSE;
Stop := StopCommand.RequestIfIdle(Busy := Stopping, Done := StopDone, Failed := Axis_Stop.Error);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CancelMove" Id="{806802e2-c3b4-4c4c-a991-a730460dd426}">
      <Declaration><![CDATA[// Drop a pending MoveTo() that has not started yet (e.g. the axis was not ready). A running move is not stopped.
METHOD CancelMove : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MoveChannel.Cancel();
MovePending := FALSE;
CancelMove := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CancelHome" Id="{45236ce3-06ce-4fda-bd4a-949a09bd3699}">
      <Declaration><![CDATA[// Drop a pending Home() that has not started yet. A running homing is not stopped.
METHOD CancelHome : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[HomeCommand.Cancel();
HomePending := FALSE;
CancelHome := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_Axis">
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>
