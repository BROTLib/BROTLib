<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.8">
  <POU Name="F_YREAL" Id="{de87cd9e-9e50-4d38-82bb-04f167b6bbb8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_YREAL : REAL
VAR_INPUT
	fX:		LREAL;
	fXmin:	REAL := 0.0;
	fXmax:	REAL := 32767.0;
	fYmin:	REAL := 0.0;
	fYmax:	REAL := 1.0;
	cut:    BOOL := TRUE;
END_VAR
VAR
	fgain:		LREAL;
	foffset:	LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
y = mx+b

		    delta Y	  fYmax - fYmin
m = fgain = ------- = -------------
			delta X	  fXmax - fXmin

b = foffset = y - m*x = y - fgain*x
					  = fYmin - fgain * fXmin
*)

// y = fgain * x + foffset

IF (fXmax - fXmin) <> 0 THEN

	// Berechnung der Steigung
	fgain := (fYmax - fYmin) / (fXmax - fXmin);

	// Berechnung des Offsets
	foffset := fYmin - (fgain * fXmin);

	// Berechnung von F_Y

	F_YREAL := LREAL_TO_REAL(fgain * fX + foffset);
	IF cut THEN
		// LIMIT(MN, IN, MX) requires MN <= MX; fYmin/fYmax can be given inverted
		// (e.g. mapping onto a descending range), so clamp against the actual
		// low/high bound instead of assuming fYmin is the low one
		F_YREAL := LIMIT(MIN(fYmin, fYmax), F_YREAL, MAX(fYmin, fYmax));
	END_IF
END_IF
]]></ST>
    </Implementation>
    <LineIds Name="F_YREAL">
      <LineId Id="1" Count="23" />
      <LineId Id="29" Count="0" />
      <LineId Id="25" Count="0" />
      <LineId Id="30" Count="0" />
      <LineId Id="26" Count="1" />
    </LineIds>
  </POU>
</TcPlcObject>