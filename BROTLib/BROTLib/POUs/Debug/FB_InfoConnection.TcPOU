<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_InfoConnection" Id="{20866d00-a67f-4183-9603-a0bbdd91ae1d}" SpecialFunc="None">
    <Declaration><![CDATA[// Decodes the Map State / Map Diag bytes of a TwinSAFE (FSoE) connection into text for debugging.
// Map Diag (Beckhoff H0003 "TwinSAFE Diagnostik"): bits 0-3 hold a numeric error code (1..12),
// bits 4-7 are independent flags. Bit 4 is confirmed there; the texts of bits 5-7 are the ones this
// block always used.
FUNCTION_BLOCK FB_InfoConnection
VAR_INPUT
	stInfoData	:ST_InfoDataConnection;
END_VAR
VAR_OUTPUT
	sState		:STRING;
	sDiag		:STRING(255);	// error code text followed by any set flags, separated by '; '
	nDiagCode	:USINT;			// bits 0-3 of usiMapDiag
	bSlaveError			:BOOL;	// bit 4: error detected by the FSoE slave
	bSlaveFailsafe		:BOOL;	// bit 5: FSoE slave reports failsafe value active
	bStartUp			:BOOL;	// bit 6: start-up
	bMasterFailsafe		:BOOL;	// bit 7: FSoE master reports failsafe value active
	bChannel1	:BOOL;
	bChannel2	:BOOL;
	bChannel3	:BOOL;
	bChannel4	:BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE stInfoData.usiMapState OF
	100: sState := 'State Reset';
	101: sState := 'State Session';
	102: sState := 'State Connection';
	103: sState := 'State Parameter';
	104: sState := 'State Data';
	105: sState := 'State Shutdown';
ELSE
	sState := 'Error';
END_CASE

// the low nibble is a number, not a set of bits: 3 is "Invalid Connection ID", not "Invalid Command"
nDiagCode := stInfoData.usiMapDiag AND 16#0F;
CASE nDiagCode OF
	0:  sDiag := '';
	1:  sDiag := 'Invalid Command';
	2:  sDiag := 'Unknown Command';
	3:  sDiag := 'Invalid Connection ID';
	4:  sDiag := 'Invalid CRC';
	5:  sDiag := 'Watchdog expired';
	6:  sDiag := 'Invalid FSoE address';
	7:  sDiag := 'Invalid data';
	8:  sDiag := 'Invalid Com.-Parameter length';
	9:  sDiag := 'Invalid Com.-Parameter';
	10: sDiag := 'Invalid User-Parameter length';
	11: sDiag := 'Invalid User-Parameter';
	12: sDiag := 'FSoE Master Reset';
ELSE
	sDiag := CONCAT('Unknown error code ', USINT_TO_STRING(nDiagCode));
END_CASE

// the high nibble is flags that can be set together with any code
bSlaveError		:= stInfoData.usiMapDiag.4;
bSlaveFailsafe	:= stInfoData.usiMapDiag.5;
bStartUp		:= stInfoData.usiMapDiag.6;
bMasterFailsafe	:= stInfoData.usiMapDiag.7;
IF bSlaveError THEN
	_Append('Error by FSoE Slave detected');
END_IF
IF bSlaveFailsafe THEN
	_Append('FSoE Slave reports Failsafe value active');
END_IF
IF bStartUp THEN
	_Append('StartUp');
END_IF
IF bMasterFailsafe THEN
	_Append('FSoE Master reports Failsafe value active');
END_IF
IF sDiag = '' THEN
	sDiag := 'No error';
END_IF

(*Signals*)
bChannel1 := stInfoData.bySignal.0;
bChannel2 := stInfoData.bySignal.1;
bChannel3 := stInfoData.bySignal.2;
bChannel4 := stInfoData.bySignal.3;
]]></ST>
    </Implementation>
    <Method Name="_Append" Id="{25ba46a9-3cb8-456c-879c-1ebc03ba1be4}">
      <Declaration><![CDATA[// Appends sText to sDiag, separated by '; ' when sDiag is not empty.
METHOD PRIVATE _Append
VAR_INPUT
	sText	: STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF sDiag <> '' THEN
	sDiag := CONCAT(sDiag, '; ');
END_IF
sDiag := CONCAT(sDiag, sText);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
