<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_IsNumericValue" Id="{162bafbc-45ea-4fd0-9c6e-10ab74542813}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_IsNumericValue : BOOL
VAR_INPUT
	sValue		: STRING(255);
END_VAR
VAR
	i				: INT;
	nLen			: INT;
	bSeenDigit		: BOOL := FALSE;
	bSeenDot		: BOOL := FALSE;
	bSeenExp		: BOOL := FALSE;
	bSeenExpDigit	: BOOL := FALSE;
	bPrevWasExp		: BOOL := FALSE;
	c			: STRING(1);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_IsNumericValue := FALSE;
nLen := LEN(sValue);
IF nLen = 0 THEN
	RETURN;
END_IF

FOR i := 1 TO nLen DO
	c := MID(sValue, 1, i);
	IF (c = '-' OR c = '+') AND (i = 1 OR bPrevWasExp) THEN
		; // leading sign, or sign right after 'e'/'E', OK
	ELSIF c = '.' AND NOT bSeenDot AND NOT bSeenExp THEN
		bSeenDot := TRUE;
	ELSIF (c = 'e' OR c = 'E') AND NOT bSeenExp AND bSeenDigit THEN
		bSeenExp := TRUE;
	ELSIF c >= '0' AND c <= '9' THEN
		IF bSeenExp THEN
			bSeenExpDigit := TRUE;
		ELSE
			bSeenDigit := TRUE;
		END_IF
	ELSE
		RETURN; // any other char -> not purely numeric
	END_IF
	bPrevWasExp := (c = 'e' OR c = 'E');
END_FOR

// a trailing exponent marker with no digits (e.g. "1e") is not a complete number
F_IsNumericValue := bSeenDigit AND (NOT bSeenExp OR bSeenExpDigit);
]]></ST>
    </Implementation>
    <LineIds Name="F_IsNumericValue">
      <LineId Id="1" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>