<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Comm_MQTT_Influx" Id="{48590b1c-8149-4a75-a4a7-086285ed3fbf}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Comm_MQTT_Influx EXTENDS FB_Comm_MQTT
VAR_INPUT
	nLogPerCycle	: UINT := 5;	// log lines sent per cycle while the broker is connected; 0 = none
	tWeatherTimeout	: TIME := T#10M;	// a weather field without a new value for this long becomes invalid (the publisher sends every 60 s and drops readings older than 300 s)
END_VAR
VAR_OUTPUT
	logFailed	: INT := 0;	// _DrainLog: fbMqttClient.Publish() returned FALSE; counts attempts, the line stays in the queue and is sent again (#130)
	logDropped	: INT := 0;	// PublishLog: line too long for the 255 character buffer, not queued (never retried by FB_EventLog)
	logQueued	: UINT := 0;	// log lines waiting for the broker (#138)
	logQueuedMax	: UINT := 0;	// largest logQueued since the start
	logLost		: UDINT := 0;	// log lines pushed out of a full queue; lines never sent = logLost + logDropped (#138)
END_VAR
VAR
	fbLogQueue		: FB_LogQueue;
	nLostSinceNotice	: UDINT;	// lost lines not yet announced on the log topic
	RaDec		: ST_RaDecCoordinate := (RightAscension := GVL_Math.LREAL_MIN, Declination := GVL_Math.LREAL_MIN);
	AltAz		: ST_AltAzCoordinate := (Altitude := GVL_Math.LREAL_MIN, Azimuth := GVL_Math.LREAL_MIN);
	dropped		: INT := 0;	// lines too long for the 255 character buffer, not published
	deliveryFailed	: INT := 0;	// fbMqttClient.Publish() returned FALSE (e.g. client busy/not connected); periodic telemetry, not retried on purpose (#5)
	// Live weather as sent by an external bridge (pybrotlib.weather) on {site}/Telescope/SET. Units are fixed: deg C,
	// hPa (= mbar), % relative humidity. Each field has its own validity: it is valid from its first accepted value until
	// no new value arrived for tWeatherTimeout. 0.0 deg C is a value, never "no data" (BROTLib#33).
	stWeather				: ST_Weather;
	bTemperatureReceived	: BOOL;
	bPressureReceived		: BOOL;
	bHumidityReceived		: BOOL;
	tonTemperatureStale	: TON;
	tonPressureStale		: TON;
	tonHumidityStale		: TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();

_DrainLog();
_UpdateWeather();]]></ST>
    </Implementation>
    <Method Name="_UpdateWeather" Id="{c6a1975e-6137-4d49-aa91-4de3d592ba14}">
      <Declaration><![CDATA[// Runs every cycle (body): ages the three weather fields and pushes the snapshot to the telescope. A field that got no
// new value for tWeatherTimeout becomes invalid (the last value is kept in stWeather for display). Logs once per
// transition valid -> stale.
METHOD _UpdateWeather
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tonTemperatureStale(IN := stWeather.bTemperatureValid AND NOT bTemperatureReceived, PT := tWeatherTimeout);
IF tonTemperatureStale.Q THEN
	stWeather.bTemperatureValid := FALSE;
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT weather: %s is stale, the estimate is used', 'temperature');
END_IF
bTemperatureReceived := FALSE;

tonPressureStale(IN := stWeather.bPressureValid AND NOT bPressureReceived, PT := tWeatherTimeout);
IF tonPressureStale.Q THEN
	stWeather.bPressureValid := FALSE;
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT weather: %s is stale, the estimate is used', 'pressure');
END_IF
bPressureReceived := FALSE;

tonHumidityStale(IN := stWeather.bHumidityValid AND NOT bHumidityReceived, PT := tWeatherTimeout);
IF tonHumidityStale.Q THEN
	stWeather.bHumidityValid := FALSE;
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT weather: %s is stale', 'humidity');
END_IF
bHumidityReceived := FALSE;

// pushed every cycle (not on receipt) so the telescope sees a field become invalid; this body always runs, while the
// body of FB_AltAzTelescopeControl does not in every application
IF AltAzTelescope <> 0 THEN
	AltAzTelescope.Weather := stWeather;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Weather" Id="{f856a7d0-efd7-4e82-9b36-b4aa3a1645ef}">
      <Declaration><![CDATA[// The current weather snapshot (read only), for applications without an I_AltAzTelescope (IAG50cm) and for tests.
PROPERTY Weather : ST_Weather
]]></Declaration>
      <Get Name="Get" Id="{d2010ac9-e0b3-4f73-abaf-410054cbb0bc}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Weather := stWeather;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="_handleMQTTMessage" Id="{6b8170c3-1db8-4027-aca0-99823e943d46}">
      <Declaration><![CDATA[METHOD _handleMQTTMessage : BOOL
VAR_INPUT
	sPayloadRcv		: STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// A message can carry several parameter=value pairs (command a=1,b=2). Data fields (rightascension, declination,
// elevation, azimuth, ...) are applied first and track/slew last, so they always use the coordinates of this
// message, whatever the field order; for a single-field message nothing changes (BROTLib#39).
// Fields separated by spaces instead of commas are dropped by the parser (BROTLib#79): the warning is logged in the
// data pass and track/slew of that message are not run, since they would use a half-applied target.
IF _DispatchPass(sPayloadRcv := sPayloadRcv, bVerbPass := FALSE) THEN
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT command: track/slew of this message not run %s', sPayloadRcv);
ELSE
	_DispatchPass(sPayloadRcv := sPayloadRcv, bVerbPass := TRUE);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ApplyField" Id="{b1996a41-13ee-4523-87f0-a3610dac6f65}">
      <Declaration><![CDATA[// Runs one parameter=value pair of a 'command' message. Same dispatch as before the multi-field change (BROTLib#39).
METHOD PRIVATE _ApplyField
VAR_INPUT
	parameter		: STRING(255);
	value			: STRING(255);
	sPayloadRcv		: STRING(255);	// the whole payload, only for the log messages
END_VAR
VAR
	fValue			: LREAL;	// a number accepted by _ParseLREAL, before it is written
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF parameter = 'power' AND Telescope <> 0 THEN
	// there is no power-off command: Park() serves that role
	IF STRING_TO_UINT(value) = 1 THEN
		Telescope.CoverAutoOpen := TRUE;
		Telescope.Init();
	ELSIF STRING_TO_UINT(value) = 2 THEN
		Telescope.CoverAutoOpen := FALSE;
		Telescope.Init();
	ELSE
		ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT power: unrecognized value (want 1 or 2) %s', sPayloadRcv);
	END_IF
ELSIF parameter = 'park' AND Telescope <> 0 THEN
	Telescope.Park();
ELSIF parameter = 'gohome' AND Telescope <> 0 THEN
	Telescope.Home();
ELSIF parameter = 'track' AND Telescope <> 0 THEN
	// rightascension/declination are buffered here: they arrive either as separate messages beforehand (pyBROT,
	// BROTgui today) or in the same message as track (the data pass in _DispatchPass runs first, BROTLib#39);
	// an incomplete pair is dropped with a log entry
	IF RaDec.RightAscension > GVL_Math.LREAL_MIN AND RaDec.Declination > GVL_Math.LREAL_MIN THEN
		Telescope.Track(RaDec.RightAscension, RaDec.Declination);
	ELSE
		ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT track: rightascension/declination incomplete, command dropped %s', sPayloadRcv);
	END_IF
	RaDec.RightAscension := GVL_Math.LREAL_MIN;
	RaDec.Declination := GVL_Math.LREAL_MIN;
ELSIF parameter = 'slew' AND Telescope <> 0 THEN
	// see 'track' above -- same buffer-and-consume pattern, same incomplete-pair gap
	IF AltAz.Azimuth > GVL_Math.LREAL_MIN AND AltAz.Altitude > GVL_Math.LREAL_MIN THEN
		Telescope.Slew(AltAz.Azimuth, AltAz.Altitude);
	ELSE
		ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT slew: azimuth/elevation incomplete, command dropped %s', sPayloadRcv);
	END_IF
	AltAz.Azimuth := GVL_Math.LREAL_MIN;
	AltAz.Altitude := GVL_Math.LREAL_MIN;
ELSIF parameter = 'stop' AND Telescope <> 0 THEN
	Telescope.Stop();
ELSIF parameter = 'reset' AND Telescope <> 0 THEN
	Telescope.Reset();
ELSIF parameter = 'nasmyth' AND Nasmyth <> 0 THEN
	IF _ParseLREAL(parameter := parameter, value := value, fMin := 0.0, fMax := 255.0, fValue => fValue) THEN
		Nasmyth.SetNasmyth(LREAL_TO_USINT(fValue));
	END_IF
// Every number below goes through _ParseLREAL: text that is not a number, NaN/inf and values outside the range
// are rejected with a log entry instead of being written (#27). The ranges only catch garbage; the limits of the
// mount, focus and derotator are still the consumer's job. Angles in degrees.
// A rejected coordinate clears its buffer, so a following track/slew is dropped as incomplete instead of using
// a value buffered by an earlier message.
ELSIF parameter = 'rightascension' THEN
	IF NOT _ParseLREAL(parameter := parameter, value := value, fMin := 0.0, fMax := 360.0, fValue => RaDec.RightAscension) THEN
		RaDec.RightAscension := GVL_Math.LREAL_MIN;
	END_IF
ELSIF parameter = 'declination' THEN
	IF NOT _ParseLREAL(parameter := parameter, value := value, fMin := -90.0, fMax := 90.0, fValue => RaDec.Declination) THEN
		RaDec.Declination := GVL_Math.LREAL_MIN;
	END_IF
ELSIF parameter = 'elevation' THEN
	IF NOT _ParseLREAL(parameter := parameter, value := value, fMin := -90.0, fMax := 90.0, fValue => AltAz.Altitude) THEN
		AltAz.Altitude := GVL_Math.LREAL_MIN;
	END_IF
ELSIF parameter = 'azimuth' THEN
	IF NOT _ParseLREAL(parameter := parameter, value := value, fMin := -360.0, fMax := 360.0, fValue => AltAz.Azimuth) THEN
		AltAz.Azimuth := GVL_Math.LREAL_MIN;
	END_IF
ELSIF parameter = 'temperature' THEN
	// deg C; the range only rejects garbage such as Kelvin (283) or Fahrenheit
	IF _ParseLREAL(parameter := parameter, value := value, fMin := -60.0, fMax := 60.0, fValue => fValue) THEN
		stWeather.fTemperature := fValue;
		stWeather.bTemperatureValid := TRUE;
		bTemperatureReceived := TRUE;
	END_IF
ELSIF parameter = 'humidity' THEN
	// % relative humidity
	IF _ParseLREAL(parameter := parameter, value := value, fMin := 0.0, fMax := 100.0, fValue => fValue) THEN
		stWeather.fHumidity := fValue;
		stWeather.bHumidityValid := TRUE;
		bHumidityReceived := TRUE;
	END_IF
ELSIF parameter = 'pressure' THEN
	// hPa (= mbar), station pressure. 300 hPa is below any observatory site; this rejects kPa (101.3) and inHg (29.9)
	// at the door. 0.0 is no longer a "no data" value (BROTLib#33). Whether a value fits the site is F_RefractionWeather's job.
	IF _ParseLREAL(parameter := parameter, value := value, fMin := 300.0, fMax := 1100.0, fValue => fValue) THEN
		stWeather.fPressure := fValue;
		stWeather.bPressureValid := TRUE;
		bPressureReceived := TRUE;
	END_IF
ELSIF parameter = 'dut1' AND AltAzTelescope <> 0 THEN
	// seconds; |UT1-UTC| is kept below 0.9 s by definition
	IF _ParseLREAL(parameter := parameter, value := value, fMin := -1.0, fMax := 1.0, fValue => fValue) THEN
		AltAzTelescope.Dut1 := fValue;
	END_IF
ELSIF parameter = 'focus' AND Focus <> 0 THEN
	// BROTLib#74: a client may move the focus only while the telescope is online (READY_STATE 1). Parked, parking,
	// starting up, in error, not operational, in manual mode (suspended) or with no telescope connected, the command
	// is rejected and logged. The park and startup sequences write Focus.Position directly and are not affected.
	// Unit and travel depend on the telescope: garbage is rejected by _ParseLREAL, a target outside the travel of the
	// focus (Focus.MinPosition..MaxPosition) is rejected here and the old target kept (MONETcommon#122: a clamp
	// turned focus=500 into an unattended run to the end of travel)
	IF _FocusAllowed(sPayloadRcv := sPayloadRcv)
		AND_THEN _ParseLREAL(parameter := parameter, value := value, fMin := -1.0E6, fMax := 1.0E6, fValue => fValue) THEN
		IF fValue < Focus.MinPosition OR fValue > Focus.MaxPosition THEN
			ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT focus rejected: outside the focus range %s',
				CONCAT(CONCAT(CONCAT(CONCAT(value, ' not in '), LREAL_TO_STRING(Focus.MinPosition)), '..'),
				LREAL_TO_STRING(Focus.MaxPosition)));
		ELSE
			Focus.Position := fValue;
		END_IF
	END_IF
ELSIF parameter = 'cover_open' AND MirrorCovers <> 0 THEN
	MirrorCovers.Open();
ELSIF parameter = 'cover_close' AND MirrorCovers <> 0 THEN
	MirrorCovers.Close();	
ELSIF parameter = 'dome_open' THEN
	IF Dome <> 0 THEN
		Dome.Open();
	ELSIF Roof <> 0 THEN
		Roof.Open();
	END_IF
ELSIF parameter = 'dome_close' THEN
	IF Dome <> 0 THEN
		Dome.Close();
	ELSIF Roof <> 0 THEN
		Roof.Close();
	END_IF
ELSIF parameter = 'dome_stop' AND (Dome <> 0 OR Roof <> 0) THEN
	IF Dome <> 0 THEN
		Dome.Stop();
	ELSIF Roof <> 0 THEN
		Roof.Stop();
	END_IF		
ELSIF parameter = 'dome_park' AND Dome <> 0 THEN
	Dome.Park();
ELSIF parameter = 'dome_track' AND Dome <> 0 THEN
	IF value = '1'THEN
		Dome.Track();
	ELSE
		Dome.StopTrack();
	END_IF	
ELSIF parameter = 'dome_reset' AND Dome <> 0 THEN
	Dome.Reset();
ELSIF parameter = 'filter' AND Filter <> 0 THEN
	// garbage used to become filter 0
	IF _ParseLREAL(parameter := parameter, value := value, fMin := 0.0, fMax := 255.0, fValue => fValue) THEN
		Filter.SetFilter(LREAL_TO_USINT(fValue));
	END_IF
ELSIF (parameter = 'derotator' OR parameter = 'derotatoroffset') AND AltAzTelescope <> 0 THEN
	// two client-facing names for the same thing -- I_AltAzTelescope only has one derotator
	// property (DerotatorOffset), there's no separate "absolute derotator position" concept
	IF _ParseLREAL(parameter := parameter, value := value, fMin := -360.0, fMax := 360.0, fValue => fValue) THEN
		AltAzTelescope.DerotatorOffset := fValue;
	END_IF
// pointing offsets: 10 degrees is far beyond any real offset. Near the zenith the consumers still divide the
// azimuth offset by COS(elevation), so they need their own cap there (#27).
ELSIF parameter = 'elevationoffset' AND AltAzTelescope <> 0 THEN
	IF _ParseLREAL(parameter := parameter, value := value, fMin := -10.0, fMax := 10.0, fValue => fValue) THEN
		AltAzTelescope.AltitudeOffset := fValue;
	END_IF
ELSIF parameter = 'azimuthoffset' AND AltAzTelescope <> 0 THEN
	IF _ParseLREAL(parameter := parameter, value := value, fMin := -10.0, fMax := 10.0, fValue => fValue) THEN
		AltAzTelescope.AzimuthOffset := fValue;
	END_IF
ELSIF parameter = 'declinationoffset' AND RaDecTelescope <> 0 THEN
	IF _ParseLREAL(parameter := parameter, value := value, fMin := -10.0, fMax := 10.0, fValue => fValue) THEN
		RaDecTelescope.DeclinationOffset := fValue;
	END_IF
ELSIF parameter = 'hourangleoffset' AND RaDecTelescope <> 0 THEN
	IF _ParseLREAL(parameter := parameter, value := value, fMin := -10.0, fMax := 10.0, fValue => fValue) THEN
		RaDecTelescope.HourAngleOffset := fValue;
	END_IF
ELSE
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT not understood %s', sPayloadRcv);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_FocusAllowed" Id="{81b01c44-858b-4578-b7f1-b31b90a60e3f}">
      <Declaration><![CDATA[// TRUE when a 'focus' command may be applied: a telescope is connected and reports READY_STATE 1 (online).
// Logs the reason otherwise (BROTLib#74).
METHOD PRIVATE _FocusAllowed : BOOL
VAR_INPUT
	sPayloadRcv		: STRING(255);
END_VAR
VAR
	fState			: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Telescope = 0 THEN
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT focus rejected: no telescope connected %s', sPayloadRcv);
	RETURN;
END_IF
fState := Telescope.ReadyState;
// FB_StartupReadiness assigns the literal 1.0, so the comparison is exact
IF fState <> 1.0 THEN
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT focus rejected: telescope not online, READY_STATE %s',
		LREAL_TO_STRING(fState));
	RETURN;
END_IF
_FocusAllowed := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_ParseLREAL" Id="{c8d3d723-7616-446a-8ff6-0828ada7a8e6}">
      <Declaration><![CDATA[// Converts the value of a command field to a number. Returns FALSE, with a log entry, when the text is not a
// number (STRING_TO_LREAL would turn it into 0.0, a valid coordinate), or when the number is NaN, infinite or
// outside fMin..fMax (#27). fValue is only meaningful when it returns TRUE.
METHOD PRIVATE _ParseLREAL : BOOL
VAR_INPUT
	parameter		: STRING(255);
	value			: STRING(255);
	fMin			: LREAL;
	fMax			: LREAL;
END_VAR
VAR_OUTPUT
	fValue			: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fValue := 0.0;
IF F_IsNumericValue(sValue := value) THEN
	fValue := STRING_TO_LREAL(value);
	// written this way round so that NaN, which fails every comparison, is rejected too
	_ParseLREAL := fValue >= fMin AND fValue <= fMax;
END_IF
IF NOT _ParseLREAL THEN
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT %s rejected: not a number or out of range',
		CONCAT(CONCAT(parameter, '='), value));
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_DispatchPass" Id="{7e928bbe-332a-4f98-8267-b812825faa63}">
      <Declaration><![CDATA[// Walks the parameter=value pairs of a payload via FB_InfluxMessage.remaining and applies the ones that belong to
// this pass: bVerbPass FALSE applies everything except track/slew, TRUE applies only track/slew. Running the
// data pass first means track/slew always see the coordinates of the SAME message (any field order), and a
// single-field message behaves exactly as before. At most MAX_FIELDS pairs are walked per message.
// Returns TRUE (data pass only) when text after a space was ignored and logged, see BROTLib#79.
METHOD PRIVATE _DispatchPass : BOOL
VAR_INPUT
	sPayloadRcv		: STRING(255);
	bVerbPass		: BOOL;
END_VAR
VAR
	influxMessage	: FB_InfluxMessage;
	sNext			: STRING(255);
	nFields			: INT;
	bVerb			: BOOL;
	bTrailingLogged	: BOOL;
END_VAR
VAR CONSTANT
	MAX_FIELDS		: INT := 8;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_DispatchPass := FALSE;
sNext := sPayloadRcv;
WHILE sNext <> '' AND nFields < MAX_FIELDS DO
	nFields := nFields + 1;
	influxMessage(sPayload := sNext);
	IF influxMessage.measurement <> 'command' THEN
		RETURN;
	END_IF
	// fields separated by spaces instead of commas: everything after the space was dropped by the parser.
	// Logged once per message, in the data pass only (both passes see the same pairs), BROTLib#79.
	IF influxMessage.trailingIgnored AND NOT bVerbPass AND NOT bTrailingLogged THEN
		bTrailingLogged := TRUE;
		_DispatchPass := TRUE;
		ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG,
			'MQTT command: fields must be separated by commas, ignored: %s', influxMessage.trailing);
	END_IF
	bVerb := influxMessage.parameter = 'track' OR influxMessage.parameter = 'slew';
	IF bVerb = bVerbPass THEN
		_ApplyField(parameter := influxMessage.parameter, value := influxMessage.value, sPayloadRcv := sPayloadRcv);
	END_IF
	sNext := influxMessage.remaining;
END_WHILE
IF sNext <> '' AND NOT bVerbPass THEN
	ADSLOGSTR( ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT more than 8 fields in one message, the rest is ignored %s', sPayloadRcv);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_PublishField" Id="{5ce041dc-36d3-4a57-81ae-eb1cb355f463}">
      <Declaration><![CDATA[// Builds the line for one field and sends it. sFieldVal is the field value as it is written in line protocol, typed
// by the caller (F_InfluxFloatValue, F_InfluxIntValue, F_InfluxStringValue, a boolean, or F_InfluxFieldValue for the
// deprecated string Publish); empty means "do not publish" (BROTLib#4).
METHOD PRIVATE _PublishField : BOOL
VAR_INPUT
	domain			: STRING(255);
	location		: STRING(255);
	parameter		: STRING(255);
	sFieldVal		: STRING(255);
	bRetain			: BOOL;
END_VAR
VAR
	sPayloadPub		: STRING(255) := '';
	fbFormat		: FB_FormatString;
	bError			: BOOL;
	nErrID			: UDINT;
	retain_message	: BOOL := FALSE;
	published		: BOOL;
	sDomain			: STRING(255);
	sLocation		: STRING(255);
	sHost			: STRING(255);
	sKey			: STRING(255);
	sTopic			: STRING(255);
	sTimestamp		: STRING(255);	// F_STRING takes a T_MaxString by reference
	sFormat			: STRING(40);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//sPayloadPub := 'environment,location=roof,host=CX-4E6032 ';
// tag values and the field key are escaped (a space or comma in the host name would break the line); sFieldVal is
// the field value already typed by the caller (BROTLib#4)
sDomain := F_EscapeInfluxTag(domain, FALSE);
sLocation := F_EscapeInfluxTag(location, TRUE);
sHost := F_EscapeInfluxTag(HostName, TRUE);
sKey := F_EscapeInfluxTag(parameter, TRUE);

// booleans are retained: they are meant to be published on change only, so a subscriber that connects later
// gets the current state from the broker
retain_message := bRetain;

// a retained line carries the time it was published, so a replay after a Telegraf restart is stored at that time
// and not at the time of the replay (#38). Consumers must accept the optional timestamp (pyBROT#40).
sTimestamp := '';
IF retain_message THEN
	sTimestamp := F_InfluxTimestamp(F_GetSystemTime());
END_IF
IF sTimestamp <> '' THEN
	sFormat := '%s,location=%s,host=%s %s=%s %s';
ELSE
	sFormat := '%s,location=%s,host=%s %s=%s';
END_IF

fbFormat(
	sFormat 	:= sFormat,
	arg1 		:= F_STRING(sDomain),
	arg2 		:= F_STRING(sLocation),
	arg3 		:= F_STRING(sHost),
	arg4 		:= F_STRING(sKey),
	arg5 		:= F_STRING(sFieldVal),
	arg6 		:= F_STRING(sTimestamp),
	sOut 		=> sPayloadPub,
	bError 		=> bError,
	nErrID 		=> nErrID
);

// a line that did not fit the buffer is cut off and would be invalid (or wrong): do not publish it. An empty field
// value (NaN or infinity from PublishLREAL) is no valid line either.
IF sFieldVal = '' OR bError OR LEN(sPayloadPub) >= 255 THEN
	published := FALSE;
	IF dropped < 32767 THEN
		dropped := dropped + 1;
	END_IF
	IF dropped = 1 OR (dropped MOD 100) = 0 THEN
		ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'Influx line too long or value not finite, not published: %s', parameter);
	END_IF
	_PublishField := published;
	RETURN;
END_IF

// publish under a per-subsystem sub-topic (domain is already the Influx measurement, e.g.
// 'telescope'/'power'/'electronics'/'hydraulics'/'diagnostics') so a consumer that only cares
// about one subsystem can subscribe to just that sub-topic instead of the whole site's firehose
sTopic := CONCAT(CONCAT(sTopicPublish, '/'), domain);

// bQueue left FALSE on purpose: this is periodic telemetry (republished every 1-5s or on the
// static-fields timer), so a dropped publish under load is self-healing next cycle -- queuing
// would just build a backlog of stale values behind whatever caused the client to be busy.
// One-time events (PublishLog) are queued in fbLogQueue instead, see there. (#5, #138)
published := fbMqttClient.Publish(
	sTopic			:= sTopic,
	pPayload		:= ADR(sPayloadPub),
	nPayloadSize	:= LEN2(ADR(sPayloadPub)),
	eQoS			:= TcIotMqttQos.AtMostOnceDelivery,
	bRetain			:= retain_message,
	bQueue			:= FALSE
);

IF NOT published THEN
	IF deliveryFailed < 32767 THEN
		deliveryFailed := deliveryFailed + 1;
	END_IF
	IF deliveryFailed = 1 OR (deliveryFailed MOD 100) = 0 THEN
		ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT publish failed (client busy/not connected): %s', parameter);
	END_IF
END_IF

_PublishField := published;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Publish" Id="{0b9304dc-7cd5-4e61-ac34-34dd3afe6924}">
      <Declaration><![CDATA[{attribute 'deprecated' := 'use PublishLREAL, PublishINT, PublishBOOL or PublishString: the type is decided at the call site (BROTLib#4)'}
METHOD Publish : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// The type is guessed from the text of the value (F_InfluxFieldValue), so the same field can flip between integer
// and float. Kept for one release for the consumers that have not migrated yet (BROTLib#4).
published := _PublishField(
	domain := domain,
	location := location,
	parameter := parameter,
	sFieldVal := F_InfluxFieldValue(value),
	bRetain := (value = 'TRUE') OR (value = 'FALSE') OR (value = 'true') OR (value = 'false'));
Publish := published;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishLREAL" Id="{0f46ee5d-6000-4f35-a420-24de2e4745dc}">
      <Declaration><![CDATA[// Float field, never an integer: a whole number is sent without the trailing i. NaN and infinity are not published (BROTLib#4).
METHOD PublishLREAL : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: LREAL;
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[published := _PublishField(domain := domain, location := location, parameter := parameter, sFieldVal := F_InfluxFloatValue(value), bRetain := FALSE);
PublishLREAL := published;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishINT" Id="{b5bda2d2-835c-4a6d-9b97-ec35173a3231}">
      <Declaration><![CDATA[// Integer field: <n>i (BROTLib#4).
METHOD PublishINT : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: LINT;
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[published := _PublishField(domain := domain, location := location, parameter := parameter, sFieldVal := F_InfluxIntValue(value), bRetain := FALSE);
PublishINT := published;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishBOOL" Id="{3182a0f3-504a-4fcc-9cd3-e8fb082f9699}">
      <Declaration><![CDATA[// Boolean field, retained and stamped like every boolean (BROTLib#4).
METHOD PublishBOOL : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: BOOL;
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[published := _PublishField(domain := domain, location := location, parameter := parameter, sFieldVal := SEL(value, 'FALSE', 'TRUE'), bRetain := TRUE);
PublishBOOL := published;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishString" Id="{352156b0-2213-4230-bfbe-fb303f0b194e}">
      <Declaration><![CDATA[// String field: always quoted, even if the text looks like a number or a boolean (BROTLib#4).
METHOD PublishString : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[published := _PublishField(domain := domain, location := location, parameter := parameter, sFieldVal := F_InfluxStringValue(value), bRetain := FALSE);
PublishString := published;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishLog" Id="{dd46de85-b82a-4d9d-9238-d6c509f88651}">
      <Declaration><![CDATA[METHOD PublishLog : BOOL
VAR_INPUT
	level		: STRING(255) := 'INFO';
	message		: STRING(255);
END_VAR
VAR
	sPayloadPub		: STRING(255) := '';
	fbFormat		: FB_FormatString;
	bError			: BOOL;
	nErrID			: UDINT;
	sEscapedMessage	: STRING(255);
	sHost			: STRING(255);
	sLevel			: STRING(255);
	nMaxMessage		: INT;
	sInfo			: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//sPayloadPub := 'environment,location=roof,host=CX-4E6032 ';
sHost := F_EscapeInfluxTag(HostName, TRUE);
sLevel := F_EscapeInfluxTag(level, TRUE);
sEscapedMessage := F_EscapeInfluxString(message);

// a long message is shortened so that the line fits the 255 character buffer and its closing quote is kept:
// 255 minus 'log,host=' (9), ',level=' (7), ' message="' (10) and the closing '"' (1)
nMaxMessage := 255 - 27 - LEN(sHost) - LEN(sLevel);
sEscapedMessage := F_TruncateInfluxEscaped(sEscapedMessage, nMaxMessage);

fbFormat(
	sFormat := 'log,host=%s,level=%s message="%s"',
	arg1 	:= F_STRING(sHost),
	arg2 	:= F_STRING(sLevel),
	arg3 	:= F_STRING(sEscapedMessage),
	sOut 	=> sPayloadPub,
	bError 	=> bError,
	nErrID 	=> nErrID
);

// still too long (very long host name or level): publish nothing rather than a broken line
IF bError OR LEN(sPayloadPub) >= 255 THEN
	published := FALSE;
	IF logDropped < 32767 THEN
		logDropped := logDropped + 1;
	END_IF
	IF logDropped = 1 OR (logDropped MOD 100) = 0 THEN
		sInfo := CONCAT(CONCAT(level, ': '), message);
		ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT log line too long, not published: %s', sInfo);
	END_IF
	PublishLog := published;
	RETURN;
END_IF

// The line is only queued here. _DrainLog sends it while the broker is connected, in the order the lines were
// pushed, so it is kept while the broker is away or the client is busy and when the caller is a method-local
// FB_EventLog that is gone after this call (#138, #139). A full queue loses its oldest line, counted in logLost.
IF fbLogQueue.Push(sPayloadPub) THEN
	nLostSinceNotice := nLostSinceNotice + 1;
	logLost := fbLogQueue.nOverwritten;
	IF logLost = 1 OR (logLost MOD 100) = 0 THEN
		ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT log queue full, oldest line lost: %s', fbLogQueue.sOverwritten);
	END_IF
END_IF
logQueued := fbLogQueue.nCount;
logQueuedMax := fbLogQueue.nHighWater;

published := TRUE;
PublishLog := published;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_LogLinkUp" Id="{6ac0cf11-70e1-4fcc-a4fe-b1ed6efa0089}">
      <Declaration><![CDATA[// The broker is connected and the subscription is done: log lines are sent. Not private so that a test can override it.
METHOD _LogLinkUp : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_LogLinkUp := bConnected AND fbMqttClient.bConnected;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_SendLogLine" Id="{d21ab84a-c99c-4b7b-9181-67731f8a8c47}">
      <Declaration><![CDATA[// One MQTT publish of a finished log line; FALSE if the client did not take it. Not private so that a test can override it.
METHOD _SendLogLine : BOOL
VAR_INPUT
	sLine	: STRING(255);
END_VAR
VAR
	sPayloadPub	: STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[sPayloadPub := sLine;
// bQueue FALSE: the queue of this FB is the only queue, so what is waiting is counted and readable (logQueued);
// the client's own queue has an unknown size and no way to ask what it dropped (#138)
_SendLogLine := fbMqttClient.Publish(
	sTopic			:= sTopicLog,
	pPayload		:= ADR(sPayloadPub),
	nPayloadSize	:= LEN2(ADR(sPayloadPub)),
	eQoS			:= TcIotMqttQos.AtMostOnceDelivery,
	bRetain			:= FALSE,
	bQueue			:= FALSE
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_DrainLog" Id="{392860a9-5a9f-4071-924b-c533e5c553ee}">
      <Declaration><![CDATA[// Runs every cycle (body): sends up to nLogPerCycle queued lines, oldest first, while the broker is connected. A line
// leaves the queue only after the client took it; a refused one stays at the head and is tried again next cycle, so
// the order is never changed. After a queue overflow, one line tells the subscribers how many lines are missing.
METHOD _DrainLog
VAR
	i		: UINT;
	sLine	: STRING(255);
	sInfo	: STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _LogLinkUp() THEN
	FOR i := 1 TO nLogPerCycle DO
		IF fbLogQueue.nCount = 0 THEN
			EXIT;
		END_IF
		sLine := fbLogQueue.Peek();
		IF _SendLogLine(sLine) THEN
			fbLogQueue.Pop();
		ELSE
			IF logFailed < 32767 THEN
				logFailed := logFailed + 1;
			END_IF
			IF logFailed = 1 OR (logFailed MOD 100) = 0 THEN
				ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'MQTT log publish failed (client busy/not connected), kept in the queue: %s', sLine);
			END_IF
			EXIT;
		END_IF
	END_FOR

	IF fbLogQueue.nCount = 0 AND nLostSinceNotice > 0 THEN
		sInfo := CONCAT(CONCAT('MQTT log: ', UDINT_TO_STRING(nLostSinceNotice)), ' lines lost, the queue was full while the broker was away');
		nLostSinceNotice := 0;
		PublishLog(level := 'WARNING', message := sInfo);
	END_IF
END_IF
logQueued := fbLogQueue.nCount;
]]></ST>
      </Implementation>
    </Method>
