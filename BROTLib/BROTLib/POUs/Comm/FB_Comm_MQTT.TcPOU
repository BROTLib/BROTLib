<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Comm_MQTT" Id="{d8bbe4b4-77fa-45ad-bf12-17a65647a3ca}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK ABSTRACT FB_Comm_MQTT IMPLEMENTS I_Comm
VAR_INPUT
	sHostName     	: STRING(255);
    nHostPort     	: UINT := 1883;
    nKeepAlive    	: UINT := 60;
	sTopicSub    	: STRING(255);
	sTopicPublish  	: STRING(255);
	sTopicLog     	: STRING(255);
	Telescope     	: I_Telescope;
	AltAzTelescope 	: I_AltAzTelescope;
	RaDecTelescope	: I_RaDecTelescope;
	Focus			: I_Focus;
	Filter			: I_Filter;
	Nasmyth			: I_Nasmyth;
	Dome			: I_Dome;
	Roof			: I_Roof;
	MirrorCovers	: I_MirrorCovers;
END_VAR
VAR_OUTPUT
	bConnected    	: BOOL := FALSE;
END_VAR
VAR
	state     		: INT := 0;
	GetHostName		: FB_GetHostName;
	HostName		: STRING(255);
	
	{attribute 'TcEncoding':='UTF-8'}
	sTopicRcv: 			STRING(255);
	{attribute 'TcEncoding':='UTF-8'}
	fbMessageQueue:		FB_IotMqttMessageQueue;
    fbMessage:			FB_IotMqttMessage;
	fbMqttClient:		FB_IotMqttClient;
	// match _handleMQTTMessage's sPayloadRcv : STRING(255) -- plain STRING (80 chars) here
	// truncated any longer message before it ever reached the 255-capable handler (#24)
	sPayloadRcv: 		STRING(255);
	tonHostNameStuck	: TON := (PT := T#30S);	// warn once if state 0 never completes (#5)
	bHostNameStuckLogged: BOOL;
	sStatusTopic		: STRING(255);	// {sTopicPublish}/status: 'online'/'offline' presence (#5)
	sOnlinePayload		: STRING(20);
	sOfflinePayload		: STRING(20);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
MQTT Communication section

Source:
https://infosys.beckhoff.com/english.php?content=../content/1033/tf6701_tc3_iot_communication_mqtt/3518541195.html&id=

*)

CASE state OF
0:
	// get hostname of this machine
	GetHostName(bExecute := TRUE, sHostName => HostName);

	// finished?
	IF HostName <> '' THEN
		GetHostName(bExecute := FALSE);
		state := 1;
	ELSE
		// GetHostName failing would otherwise leave this state (and the whole connection) stuck
		// forever with nothing reporting it (#5); log once, keep waiting either way
		tonHostNameStuck(IN := TRUE, PT := T#30S);
		IF tonHostNameStuck.Q AND NOT bHostNameStuckLogged THEN
			bHostNameStuckLogged := TRUE;
			ADSLOGSTR(ADSLOG_MSGTYPE_ERROR OR ADSLOG_MSGTYPE_LOG, 'MQTT: FB_GetHostName has not returned a hostname after 30s, still waiting', '');
		END_IF
	END_IF
	
1:
	// set parameters
    fbMqttClient.sHostName      := sHostName;
    fbMqttClient.nHostPort      := nHostPort;
    fbMqttClient.sClientId      := HostName;
    fbMqttClient.sTopicPrefix   := '';
	fbMqttClient.nKeepAlive     := nKeepAlive;
    fbMqttClient.ipMessageQueue := fbMessageQueue;

	// last will: the broker publishes this (retained) if this client disconnects uncleanly
	// (crash, power loss, network loss), so a consumer can tell the PLC is actually gone instead
	// of telemetry just having gone quiet (#5). Paired with the explicit 'online' publish below
	// once actually connected, so the retained value on this topic always reflects current status
	sStatusTopic := CONCAT(sTopicPublish, '/status');
	sOfflinePayload := 'offline';
	fbMqttClient.stWill.sTopic := sStatusTopic;
	fbMqttClient.stWill.eQoS := TcIotMqttQos.AtLeastOnceDelivery;
	fbMqttClient.stWill.bRetain := TRUE;
	fbMqttClient.stWill.fbPayload.SetData(ADR(sOfflinePayload), LEN2(ADR(sOfflinePayload)));

	// connect
	fbMqttClient.Execute(bConnect := TRUE);
	IF fbMqttClient.bConnected THEN
		state := 2;
	END_IF

2:
  	// subscribe
	fbMqttClient.Execute(bConnect := TRUE);
	IF fbMqttClient.Subscribe(sTopic:=sTopicSub, eQoS:=TcIotMqttQos.AtMostOnceDelivery) THEN
		bConnected := TRUE;
		// birth message: overwrites the retained 'offline' left by an earlier unclean disconnect
		sOnlinePayload := 'online';
		fbMqttClient.Publish(sTopic := sStatusTopic, pPayload := ADR(sOnlinePayload), nPayloadSize := LEN2(ADR(sOnlinePayload)),
			eQoS := TcIotMqttQos.AtLeastOnceDelivery, bRetain := TRUE, bQueue := TRUE);
		state := 3;
	END_IF
	
3:
	// keep bConnected honest: reflect the live underlying client state
	bConnected := fbMqttClient.bConnected;
	
	// if the broker dropped us, fall back to reconnect
	IF NOT fbMqttClient.bConnected THEN
		bConnected := FALSE;
		state := 1;
	END_IF
	
	// receive queued messages
	fbMqttClient.Execute(bConnect := TRUE);
	IF fbMessageQueue.nQueuedMessages > 0 THEN
		IF fbMessageQueue.Dequeue(fbMessage:=fbMessage) THEN
			fbMessage.GetTopic(pTopic:=ADR(sTopicRcv), nTopicSize:=SIZEOF(sTopicRcv) );
			fbMessage.GetPayload(pPayload:=ADR(sPayloadRcv), nPayloadSize:=SIZEOF(sPayloadRcv), bSetNullTermination:=TRUE);
			ADSLOGSTR(ADSLOG_MSGTYPE_HINT OR ADSLOG_MSGTYPE_LOG, 'MQTT %s', sPayloadRcv);
			IF sTopicRcv = sTopicSub THEN
				_handleMQTTMessage(sPayloadRcv);
			END_IF // measurement
		END_IF // Topic
		sPayloadRcv := '';
    END_IF // Dequeue
	
END_CASE
]]></ST>
    </Implementation>
    <Method Name="_handleMQTTMessage" Id="{3fc5e2b4-d47a-4c7b-b15d-e4c641e066c5}">
      <Declaration><![CDATA[METHOD ABSTRACT _handleMQTTMessage : BOOL
VAR_INPUT
	sPayloadRcv	: STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="Publish" Id="{8c84bc73-5131-48d3-9d98-8c3aca716aef}">
      <Declaration><![CDATA[METHOD Publish : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishLog" Id="{887bcbbd-6ea5-41c8-8b6d-52f19ad54d4d}">
      <Declaration><![CDATA[METHOD PublishLog : BOOL
VAR_INPUT
	level		: STRING(255) := 'INFO';
	message		: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
