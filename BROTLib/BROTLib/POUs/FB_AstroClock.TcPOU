<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.8">
  <POU Name="FB_AstroClock" Id="{9eeab12b-19b9-408a-b96c-52351be0dfa7}" SpecialFunc="None">
    <Declaration><![CDATA[// Software clock (RTC_EX2, microsecond resolution) resynchronised from the Windows system time every 5 s.
// NT_GetTime returns the LOCAL Windows time and nothing here converts it, so the PLC's Windows time zone must be
// UTC: DateTime2JD and everything downstream (LST, pointing, tracking) expect UTC. The production PCs are set to UTC.
// Check bValid before using time_RTCEX2 (see FB_AstroClockSync).
FUNCTION_BLOCK FB_AstroClock
VAR_INPUT
END_VAR
VAR_OUTPUT
        bValid          : BOOL;         // FALSE until the first successful sync, and after too many failed ones in a row
        nSyncErrors     : UINT;         // failed syncs in a row
        time_RTCEX2     : TIMESTRUCT;
        nMicroseconds   : DWORD;
END_VAR
VAR
	        fbGetLocalTime  : NT_GetTime;
        bBusy           : BOOL;
        bError          : BOOL;
        nErrID          : UDINT;
        presetTime      : TIMESTRUCT;

        syncTimer       : TON;
        fbSync          : FB_AstroClockSync;
        bSynchronize    : BOOL;

        fbRTC_EX2       : RTC_EX2;
        bValid_RTCEX2   : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
TYPE TIMESTRUCT
STRUCT
   wYear            : WORD;
   wMonth           : WORD;
   wDayOfWeek       : WORD;
   wDay             : WORD;
   wHour            : WORD;
   wMinute          : WORD;
   wSecond          : WORD;
   wMilliseconds    : WORD;
END_STRUCT
END_TYPE
*)

syncTimer(IN := NOT SyncTimer.Q, PT := T#5S);
fbGetLocalTime(START := syncTimer.Q,
	TMOUT := DEFAULT_ADS_TIMEOUT,
	Busy => bBusy,
	ERR => bError,
	ERRID => nErrID,
	TIMESTR => presetTime);

// the RTC is loaded only after a successful read; bValid tells callers whether time_RTCEX2 can be used
fbSync(bBusy := bBusy, bError := bError,
	bSynchronize => bSynchronize,
	bValid => bValid,
	nErrors => nSyncErrors);

fbRTC_EX2(EN := bSynchronize,
	PDT := presetTime,
	PMICRO := 0,
	Q => bValid_RTCEX2,
	CDT => time_RTCEX2,
	CMICRO => nMicroseconds);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
