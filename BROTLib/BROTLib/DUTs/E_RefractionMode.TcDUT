<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="E_RefractionMode" Id="{648cec28-4d17-4458-9851-f417054e5d00}">
    <Declaration><![CDATA[// Which refraction the equatorial pointing path uses (IAG50cm#7, #3; moved here from IAG50cm for IAG50cm#17).
// OLD: a pointing model with fitted refraction terms, the AstroBROT calls with their defaults, as before.
// NEW: AstroBROT refraction (live weather or the site estimate) in front of a model without refraction terms.
{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_RefractionMode :
(
	OLD := 0,
	NEW := 1
) INT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
