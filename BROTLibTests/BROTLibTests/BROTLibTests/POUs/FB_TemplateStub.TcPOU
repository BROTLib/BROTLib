<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_TemplateStub" Id="{1671c852-67fc-4177-a9d4-87655e3e61e0}" SpecialFunc="None">
    <Declaration><![CDATA[// Minimal concrete telescope for the tests of the template body of FB_BaseTelescopeControl (BROTLib#25 step 5.4): every hook is a
// counter, and the few inputs below steer the hooks the tests need to steer. It does not move anything.
FUNCTION_BLOCK FB_TemplateStub EXTENDS FB_AltAzTelescopeControl
VAR_INPUT
	bAcceptMoves	: BOOL := TRUE;		// _AcceptMove: FALSE rejects every move
	bReplaceOnGoto	: BOOL;				// _AcceptMove: a goto replaces the running move (the supersede request)
	bRaiseError		: BOOL;				// _ReadErrors: bError for the scan
	bParkWaits		: BOOL;				// _ParkPreStep: the pending park waits
	bSettled		: BOOL;				// _StopSettled
END_VAR
VAR_OUTPUT
	nAcceptMove		: UINT;				// calls of _AcceptMove
	eLastAccepted	: E_TCSCommand;		// the command of the last _AcceptMove
	nMoveEdgeAccepted	: UINT;
	nAutoStop		: UINT;
	nDoPowerOn, nDoPark, nDoGoHome, nDoGoto, nDoSlew, nDoTrack, nDoStop	: UINT;	// calls of the _Do* hooks
	nInterruptedDo	: UINT;				// _Do* calls made while bInterrupted was TRUE
	eRestartKeep	: E_TCSCommand;		// the argument of the last _RestartMoveTimeout
	nRestartMoveTimeout	: UINT;
	nSendTelemetry	: UINT;
	eTimeoutAsked	: E_TCSCommand;		// the argument of the last _CommandTimeout
	nSeq			: UINT;				// order of the hooks: nAt* is the value of nSeq when the hook ran last
	nAtReadInputs, nAtHandleReset, nAtReadErrors, nAtErrorReaction, nAtComputeTargets, nAtTimers, nAtParkRequests, nAtUpdateStatus,
	nAtReleaseReset, nAtSafeStateEndOfScan, nAtEndOfScan	: UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
]]></ST>
    </Implementation>
    <Method Name="_ReadInputs" Id="{078c48cb-3190-40db-99f8-d69a9aea4844}">
      <Declaration><![CDATA[METHOD PROTECTED _ReadInputs
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nSeq := nSeq + 1;
nAtReadInputs := nSeq;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_HandleReset" Id="{2745af26-30b7-4749-a5bd-5e123196f676}">
