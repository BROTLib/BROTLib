    <Method Name="_ReadErrors" Id="{22b6578e-a493-47f3-a843-4017a95c18eb}">
      <Declaration><![CDATA[METHOD PROTECTED _ReadErrors
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nSeq := nSeq + 1;
nAtReadErrors := nSeq;
IF bRaiseError THEN
	bError := TRUE;
	nErrorID := 16#1;
ELSE
	bError := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
