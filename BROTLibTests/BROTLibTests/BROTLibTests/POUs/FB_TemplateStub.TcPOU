    <Method Name="_AutoStop" Id="{b0244105-0386-4195-872b-13e4670e0f6e}">
      <Declaration><![CDATA[METHOD PROTECTED _AutoStop
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nAutoStop := nAutoStop + 1;	// the clock of the stub is never valid: no stop, the tests drive the requests themselves
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_AcceptMove" Id="{ee058a84-571b-4cd4-8a13-629c076a1822}">
      <Declaration><![CDATA[METHOD PROTECTED _AcceptMove : BOOL
VAR_INPUT
	eCommand	: E_TCSCommand;
	eExcludeOwn	: E_TCSCommand;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nAcceptMove := nAcceptMove + 1;
eLastAccepted := eCommand;
_AcceptMove := bAcceptMoves;
IF bAcceptMoves AND bReplaceOnGoto AND eCommand = E_TCSCommand.goto THEN
	bSupersedeRequest := TRUE;
	eSupersedeKeep := eCommand;
END_IF
]]></ST>
      </Implementation>
    </Method>
