<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Axis_Tests" Id="{4b1d7a52-93c6-4e08-a1f4-5d2c8e7b3a10}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for the parts of FB_Axis that do not need a real NC axis: the AXIS_REF is a plain local structure with
// no NC behind it, so the MC_* blocks report errors and never confirm a command. What can be checked is what
// FB_Axis computes itself: the actual position (plain and modulo), isTracking, and that homing/move requests are
// kept or ignored as intended. Homing completion (Homed) and the setpoint generator need the NC and are covered
// by the hardware checks, not here. The same holds for the running-homing side of HomeActive (Home() ignored while a
// homing runs, HomeActive TRUE from the start until MC_Home is finished): MC_Home never starts without an NC axis.
// Each test calls the block twice because ActualPosition is read at the end of a cycle and used in the next.
FUNCTION_BLOCK FB_Axis_Tests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ActualPosition_Reads_ActPos();
ActualPosition_Modulo_Reads_ModuloActPos();
IsTracking_Envelope();
IsTracking_Requires_Tracking();
IsTracking_Modulo_Wrap_Known_Limitation();
Move_Is_Ignored_Without_Calibration();
Home_Request_Is_Kept_While_Not_Homed();
HomeActive_Is_Low_While_Idle();
Home_Call_Is_Accepted_While_Idle();
Stop_Twice_In_One_Scan();
Stop_Repeated_Next_Scan();
Ignored_Stop_Still_Cancels_Move();
Stop_On_Axis_Not_Allowed_Stays_Pending_Until_Reset();
]]></ST>
    </Implementation>
    <Method Name="SetActPos" Id="{2b7e4c91-8d35-4f06-a1c8-9e3d5b70f214}">
      <Declaration><![CDATA[// AXIS_REF is a function block whose NcToPlc is not writable from outside; a pointer sidesteps that.
METHOD PRIVATE SetActPos
VAR_INPUT
	fValue	: LREAL;
END_VAR
VAR_IN_OUT
	axisRef	: AXIS_REF;
END_VAR
VAR
	pValue	: POINTER TO LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pValue := ADR(axisRef.NcToPlc.ActPos);
pValue^ := fValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetModuloActPos" Id="{3c8f5da2-9e46-4017-b2d9-af4e6c81a325}">
      <Declaration><![CDATA[// AXIS_REF is a function block whose NcToPlc is not writable from outside; a pointer sidesteps that.
METHOD PRIVATE SetModuloActPos
VAR_INPUT
	fValue	: LREAL;
END_VAR
VAR_IN_OUT
	axisRef	: AXIS_REF;
END_VAR
VAR
	pValue	: POINTER TO LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pValue := ADR(axisRef.NcToPlc.ModuloActPos);
pValue^ := fValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ActualPosition_Reads_ActPos" Id="{0a6e1c3d-5f7b-4d29-8c41-b3e9a7d20f61}">
      <Declaration><![CDATA[METHOD PRIVATE ActualPosition_Reads_ActPos
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('ActualPosition_Reads_ActPos');
SetActPos(axisRef := axisRef, fValue := 123.456);
SetModuloActPos(axisRef := axisRef, fValue := 7.0);
fbAxis(AxisRef := axisRef);
AssertEquals_LREAL(Expected := 123.456, Actual := fbAxis.ActualPosition, Delta := 1.0E-12, Message := 'plain axis reports ActPos');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ActualPosition_Modulo_Reads_ModuloActPos" Id="{6c2f9b84-1e3a-4a75-9d06-e8b4c1f57a23}">
      <Declaration><![CDATA[METHOD PRIVATE ActualPosition_Modulo_Reads_ModuloActPos
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('ActualPosition_Modulo_Reads_ModuloActPos');
SetActPos(axisRef := axisRef, fValue := 725.0);
SetModuloActPos(axisRef := axisRef, fValue := 5.0);
fbAxis.isModuloAxis := TRUE;
fbAxis(AxisRef := axisRef);
AssertEquals_LREAL(Expected := 5.0, Actual := fbAxis.ActualPosition, Delta := 1.0E-12, Message := 'modulo axis reports ModuloActPos');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsTracking_Envelope" Id="{b83d5e17-2c4f-4b90-a6e1-7f09d3c8b542}">
      <Declaration><![CDATA[METHOD PRIVATE IsTracking_Envelope
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('IsTracking_Envelope');
fbAxis.Tracking := TRUE;
fbAxis.Position := 10.0;
fbAxis.TrackEnvelope := 5.0;	// arcsec

SetActPos(axisRef := axisRef, fValue := 10.0 + 4.0 / 3600.0);
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertTrue(Condition := fbAxis.isTracking, Message := '4 arcsec off, envelope 5 arcsec: tracking');

SetActPos(axisRef := axisRef, fValue := 10.0 - 6.0 / 3600.0);
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.isTracking, Message := '6 arcsec off, envelope 5 arcsec: not tracking');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsTracking_Requires_Tracking" Id="{d94a0f68-3b5e-4c17-b2d8-1a6f8e0c7934}">
      <Declaration><![CDATA[METHOD PRIVATE IsTracking_Requires_Tracking
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('IsTracking_Requires_Tracking');
fbAxis.Tracking := FALSE;
fbAxis.Position := 10.0;
SetActPos(axisRef := axisRef, fValue := 10.0);
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.isTracking, Message := 'on position but tracking not requested');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsTracking_Modulo_Wrap_Known_Limitation" Id="{e5b1c279-4d60-4f83-9a2e-c0d7b4f19a65}">
      <Declaration><![CDATA[METHOD PRIVATE IsTracking_Modulo_Wrap_Known_Limitation
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('IsTracking_Modulo_Wrap_Known_Limitation');
// Pins the CURRENT behaviour: the position difference is not wrapped on a modulo axis, so 0.001 deg
// against 359.999 deg (0.002 deg apart on the circle) is not seen as tracking. Flip the assertion when
// FB_Axis handles the wrap.
fbAxis.isModuloAxis := TRUE;
fbAxis.Tracking := TRUE;
fbAxis.Position := 0.001;
fbAxis.TrackEnvelope := 10.0;	// arcsec, 0.002 deg = 7.2 arcsec is inside
SetModuloActPos(axisRef := axisRef, fValue := 359.999);
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.isTracking, Message := 'modulo wrap is not handled (known limitation)');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Move_Is_Ignored_Without_Calibration" Id="{f6c2d38a-5e71-4094-8b3f-d1e8c5a02b76}">
      <Declaration><![CDATA[METHOD PRIVATE Move_Is_Ignored_Without_Calibration
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Move_Is_Ignored_Without_Calibration');
fbAxis.Position := 50.0;
fbAxis.MoveTo();
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.Calibrated, Message := 'a fresh axis is not calibrated');
AssertFalse(Condition := fbAxis.MoveDone, Message := 'no move without calibration');
AssertTrue(Condition := fbAxis.MovePending, Message := 'the request is kept, not consumed');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home_Request_Is_Kept_While_Not_Homed" Id="{07d3e49b-6f82-41a5-9c40-e2f9d6b13c87}">
      <Declaration><![CDATA[METHOD PRIVATE Home_Request_Is_Kept_While_Not_Homed
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	fReference	: LREAL := 0.0;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Home_Request_Is_Kept_While_Not_Homed');
fbAxis.Home(fReference := fReference);
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.Calibrated, Message := 'not calibrated without Homed');
AssertFalse(Condition := fbAxis.HomeDone, Message := 'HomeDone is low while not homed');
AssertTrue(Condition := fbAxis.HomePending, Message := 'the home request waits until the axis is ready');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="HomeActive_Is_Low_While_Idle" Id="{5e1f9b27-3d84-4c06-8a52-7c0e4d91b3a8}">
      <Declaration><![CDATA[METHOD PRIVATE HomeActive_Is_Low_While_Idle
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('HomeActive_Is_Low_While_Idle');
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.HomeActive, Message := 'no homing runs without a Home() call');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home_Call_Is_Accepted_While_Idle" Id="{8a3c6d14-2b59-4e70-9f18-d4b7e2a5c601}">
      <Declaration><![CDATA[METHOD PRIVATE Home_Call_Is_Accepted_While_Idle
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	fReference	: LREAL := 0.0;
	bAccepted	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Home_Call_Is_Accepted_While_Idle');
fbAxis(AxisRef := axisRef);
bAccepted := fbAxis.Home(fReference := fReference);
AssertTrue(Condition := bAccepted, Message := 'Home() is accepted when no homing runs (the guard only ignores calls during a homing)');
AssertTrue(Condition := fbAxis.HomePending, Message := 'the accepted request is pending');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Twice_In_One_Scan" Id="{27f9fd59-94b4-4508-811e-8f96312e4049}">
      <Declaration><![CDATA[// #93: the second Stop() in a scan is ignored.
METHOD PRIVATE Stop_Twice_In_One_Scan
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	bFirst	: BOOL;
	bSecond	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Twice_In_One_Scan');
fbAxis(AxisRef := axisRef);
bFirst := fbAxis.Stop();
bSecond := fbAxis.Stop();
AssertTrue(Condition := bFirst, Message := 'first Stop() requests an MC_Stop');
AssertFalse(Condition := bSecond, Message := 'second Stop() in the same scan is ignored');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Repeated_Next_Scan" Id="{8181193f-ebae-46c1-b8cf-f4d318f567ac}">
      <Declaration><![CDATA[// #93: a Stop() in the next scan, while the first request is still pending or running, is ignored.
METHOD PRIVATE Stop_Repeated_Next_Scan
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	bFirst	: BOOL;
	bSecond	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Repeated_Next_Scan');
fbAxis(AxisRef := axisRef);
bFirst := fbAxis.Stop();
fbAxis(AxisRef := axisRef);
bSecond := fbAxis.Stop();
AssertTrue(Condition := bFirst, Message := 'first Stop() requests an MC_Stop');
AssertFalse(Condition := bSecond, Message := 'repeated Stop() while the stop is on its way is ignored');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Ignored_Stop_Still_Cancels_Move" Id="{8d24cf24-3308-4d08-9479-07d4ad46d6d1}">
      <Declaration><![CDATA[// #93: an ignored Stop() still drops a MoveTo() requested after the first one.
METHOD PRIVATE Ignored_Stop_Still_Cancels_Move
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Ignored_Stop_Still_Cancels_Move');
fbAxis(AxisRef := axisRef);
fbAxis.Stop();
fbAxis.MoveTo();
fbAxis.Stop();
AssertFalse(Condition := fbAxis.MovePending, Message := 'the ignored Stop() cancelled the pending move');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_On_Axis_Not_Allowed_Stays_Pending_Until_Reset" Id="{0ab53c8f-1969-49e4-91b4-c44e91261ea9}">
      <Declaration><![CDATA[// MONETcommon#150, characterisation of today's behaviour: the AXIS_REF has no NC behind it, so no axis state is set and
// StopAllowed is FALSE, like an axis that is not enabled yet. A Stop() on such an axis is latched in StopCommand and
// waits for Allowed with no timeout; it is not dropped by time or by the stop being "done". It starts as soon as the axis
// reaches StandStill (the next power-on), which the NC refuses with 0x42EF. Only Reset drops it. If a fix drops the
// request on a disabled axis, this test is the one to change.
METHOD PRIVATE Stop_On_Axis_Not_Allowed_Stays_Pending_Until_Reset
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	n		: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_On_Axis_Not_Allowed_Stays_Pending_Until_Reset');
fbAxis(AxisRef := axisRef);
fbAxis.Stop();
FOR n := 1 TO 50 DO
	fbAxis(AxisRef := axisRef);
END_FOR
AssertTrue(Condition := fbAxis.StopCommand.Pending, Message := 'the stop request is still pending after 50 scans');
AssertFalse(Condition := fbAxis.StopCommand.Execute, Message := 'MC_Stop is not started on an axis that is not allowed');
fbAxis(AxisRef := axisRef, Reset := TRUE);
fbAxis(AxisRef := axisRef, Reset := FALSE);
AssertFalse(Condition := fbAxis.StopCommand.Pending, Message := 'Reset drops the request');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
