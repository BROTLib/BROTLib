<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Axis_Tests" Id="{4b1d7a52-93c6-4e08-a1f4-5d2c8e7b3a10}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for the parts of FB_Axis that do not need a real NC axis: the AXIS_REF is a plain local structure with
// no NC behind it, so the MC_* blocks report errors and never confirm a command. What can be checked is what
// FB_Axis computes itself: the actual position (plain and modulo), isTracking, and that homing/move requests are
// kept or ignored as intended. Homing completion (Homed) and the setpoint generator need the NC and are covered
// by the hardware checks, not here. The same holds for the running-homing side of HomeActive (Home() ignored while a
// homing runs, HomeActive TRUE from the start until MC_Home is finished): MC_Home never starts without an NC axis.
// Each test calls the block twice because ActualPosition is read at the end of a cycle and used in the next.
FUNCTION_BLOCK FB_Axis_Tests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ActualPosition_Reads_ActPos();
ActualPosition_Modulo_Reads_ModuloActPos();
SetPosition_Reads_SetPos();
SetPosition_Modulo_Reads_ModuloSetPos();
IsTracking_Envelope();
IsTracking_Requires_Tracking();
IsTracking_Modulo_Wrap_Known_Limitation();
Feed_Velocity_Is_The_Fixed_Value_By_Default();
Feed_Velocity_Follows_The_Fed_Position();
Move_Is_Ignored_Without_Calibration();
Home_Request_Is_Kept_While_Not_Homed();
HomeActive_Is_Low_While_Idle();
Home_Call_Is_Accepted_While_Idle();
Stop_Twice_In_One_Scan();
Stop_Repeated_Next_Scan();
Ignored_Stop_Still_Cancels_Move();
Stop_Dynamics_Default_To_The_NC_Parameters();
Stop_Locks_Motion_Commands();
]]></ST>
    </Implementation>
    <Method Name="SetActPos" Id="{2b7e4c91-8d35-4f06-a1c8-9e3d5b70f214}">
      <Declaration><![CDATA[// AXIS_REF is a function block whose NcToPlc is not writable from outside; a pointer sidesteps that.
METHOD PRIVATE SetActPos
VAR_INPUT
	fValue	: LREAL;
END_VAR
VAR_IN_OUT
	axisRef	: AXIS_REF;
END_VAR
VAR
	pValue	: POINTER TO LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pValue := ADR(axisRef.NcToPlc.ActPos);
pValue^ := fValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetModuloActPos" Id="{3c8f5da2-9e46-4017-b2d9-af4e6c81a325}">
      <Declaration><![CDATA[// AXIS_REF is a function block whose NcToPlc is not writable from outside; a pointer sidesteps that.
METHOD PRIVATE SetModuloActPos
VAR_INPUT
	fValue	: LREAL;
END_VAR
VAR_IN_OUT
	axisRef	: AXIS_REF;
END_VAR
VAR
	pValue	: POINTER TO LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pValue := ADR(axisRef.NcToPlc.ModuloActPos);
pValue^ := fValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ActualPosition_Reads_ActPos" Id="{0a6e1c3d-5f7b-4d29-8c41-b3e9a7d20f61}">
      <Declaration><![CDATA[METHOD PRIVATE ActualPosition_Reads_ActPos
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('ActualPosition_Reads_ActPos');
SetActPos(axisRef := axisRef, fValue := 123.456);
SetModuloActPos(axisRef := axisRef, fValue := 7.0);
fbAxis(AxisRef := axisRef);
AssertEquals_LREAL(Expected := 123.456, Actual := fbAxis.ActualPosition, Delta := 1.0E-12, Message := 'plain axis reports ActPos');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ActualPosition_Modulo_Reads_ModuloActPos" Id="{6c2f9b84-1e3a-4a75-9d06-e8b4c1f57a23}">
      <Declaration><![CDATA[METHOD PRIVATE ActualPosition_Modulo_Reads_ModuloActPos
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('ActualPosition_Modulo_Reads_ModuloActPos');
SetActPos(axisRef := axisRef, fValue := 725.0);
SetModuloActPos(axisRef := axisRef, fValue := 5.0);
fbAxis.isModuloAxis := TRUE;
fbAxis(AxisRef := axisRef);
AssertEquals_LREAL(Expected := 5.0, Actual := fbAxis.ActualPosition, Delta := 1.0E-12, Message := 'modulo axis reports ModuloActPos');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="WriteSetPos" Id="{ade5b065-c9c9-4541-bcbd-40c3dbdbb7d9}">
      <Declaration><![CDATA[// AXIS_REF is a function block whose NcToPlc is not writable from outside; a pointer sidesteps that.
METHOD PRIVATE WriteSetPos
VAR_INPUT
	fSetPos			: LREAL;
	fModuloSetPos	: LREAL;
END_VAR
VAR_IN_OUT
	axisRef	: AXIS_REF;
END_VAR
VAR
	pValue	: POINTER TO LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pValue := ADR(axisRef.NcToPlc.SetPos);
pValue^ := fSetPos;
pValue := ADR(axisRef.NcToPlc.ModuloSetPos);
pValue^ := fModuloSetPos;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPosition_Reads_SetPos" Id="{7a2060c9-a34f-4ec4-a333-55922c401039}">
      <Declaration><![CDATA[// MONETcommon#267: the NC set position, not the encoder; a following error (ActPos <> SetPos) must not leak into it
METHOD PRIVATE SetPosition_Reads_SetPos
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('SetPosition_Reads_SetPos');
SetActPos(axisRef := axisRef, fValue := 123.453);
WriteSetPos(axisRef := axisRef, fSetPos := 123.456, fModuloSetPos := 7.0);
fbAxis(AxisRef := axisRef);
AssertEquals_LREAL(Expected := 123.456, Actual := fbAxis.SetPosition, Delta := 1.0E-12, Message := 'plain axis reports SetPos');
AssertEquals_LREAL(Expected := 123.453, Actual := fbAxis.ActualPosition, Delta := 1.0E-12, Message := 'ActualPosition stays the encoder');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetPosition_Modulo_Reads_ModuloSetPos" Id="{281ec159-b8a0-467a-8024-d1250a7cb1a5}">
      <Declaration><![CDATA[METHOD PRIVATE SetPosition_Modulo_Reads_ModuloSetPos
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('SetPosition_Modulo_Reads_ModuloSetPos');
WriteSetPos(axisRef := axisRef, fSetPos := 725.0, fModuloSetPos := 5.0);
fbAxis.isModuloAxis := TRUE;
fbAxis(AxisRef := axisRef);
AssertEquals_LREAL(Expected := 5.0, Actual := fbAxis.SetPosition, Delta := 1.0E-12, Message := 'modulo axis reports ModuloSetPos');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsTracking_Envelope" Id="{b83d5e17-2c4f-4b90-a6e1-7f09d3c8b542}">
      <Declaration><![CDATA[METHOD PRIVATE IsTracking_Envelope
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('IsTracking_Envelope');
fbAxis.Tracking := TRUE;
fbAxis.Position := 10.0;
fbAxis.TrackEnvelope := 5.0;	// arcsec

SetActPos(axisRef := axisRef, fValue := 10.0 + 4.0 / 3600.0);
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertTrue(Condition := fbAxis.isTracking, Message := '4 arcsec off, envelope 5 arcsec: tracking');

SetActPos(axisRef := axisRef, fValue := 10.0 - 6.0 / 3600.0);
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.isTracking, Message := '6 arcsec off, envelope 5 arcsec: not tracking');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsTracking_Requires_Tracking" Id="{d94a0f68-3b5e-4c17-b2d8-1a6f8e0c7934}">
      <Declaration><![CDATA[METHOD PRIVATE IsTracking_Requires_Tracking
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('IsTracking_Requires_Tracking');
fbAxis.Tracking := FALSE;
fbAxis.Position := 10.0;
SetActPos(axisRef := axisRef, fValue := 10.0);
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.isTracking, Message := 'on position but tracking not requested');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsTracking_Modulo_Wrap_Known_Limitation" Id="{e5b1c279-4d60-4f83-9a2e-c0d7b4f19a65}">
      <Declaration><![CDATA[METHOD PRIVATE IsTracking_Modulo_Wrap_Known_Limitation
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('IsTracking_Modulo_Wrap_Known_Limitation');
// Pins the CURRENT behaviour: the position difference is not wrapped on a modulo axis, so 0.001 deg
// against 359.999 deg (0.002 deg apart on the circle) is not seen as tracking. Flip the assertion when
// FB_Axis handles the wrap.
fbAxis.isModuloAxis := TRUE;
fbAxis.Tracking := TRUE;
fbAxis.Position := 0.001;
fbAxis.TrackEnvelope := 10.0;	// arcsec, 0.002 deg = 7.2 arcsec is inside
SetModuloActPos(axisRef := axisRef, fValue := 359.999);
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.isTracking, Message := 'modulo wrap is not handled (known limitation)');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Move_Is_Ignored_Without_Calibration" Id="{f6c2d38a-5e71-4094-8b3f-d1e8c5a02b76}">
      <Declaration><![CDATA[METHOD PRIVATE Move_Is_Ignored_Without_Calibration
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Move_Is_Ignored_Without_Calibration');
fbAxis.Position := 50.0;
fbAxis.MoveTo();
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.Calibrated, Message := 'a fresh axis is not calibrated');
AssertFalse(Condition := fbAxis.MoveDone, Message := 'no move without calibration');
AssertTrue(Condition := fbAxis.MovePending, Message := 'the request is kept, not consumed');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home_Request_Is_Kept_While_Not_Homed" Id="{07d3e49b-6f82-41a5-9c40-e2f9d6b13c87}">
      <Declaration><![CDATA[METHOD PRIVATE Home_Request_Is_Kept_While_Not_Homed
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	fReference	: LREAL := 0.0;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Home_Request_Is_Kept_While_Not_Homed');
fbAxis.Home(fReference := fReference);
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.Calibrated, Message := 'not calibrated without Homed');
AssertFalse(Condition := fbAxis.HomeDone, Message := 'HomeDone is low while not homed');
AssertTrue(Condition := fbAxis.HomePending, Message := 'the home request waits until the axis is ready');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="HomeActive_Is_Low_While_Idle" Id="{5e1f9b27-3d84-4c06-8a52-7c0e4d91b3a8}">
      <Declaration><![CDATA[METHOD PRIVATE HomeActive_Is_Low_While_Idle
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('HomeActive_Is_Low_While_Idle');
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.HomeActive, Message := 'no homing runs without a Home() call');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home_Call_Is_Accepted_While_Idle" Id="{8a3c6d14-2b59-4e70-9f18-d4b7e2a5c601}">
      <Declaration><![CDATA[METHOD PRIVATE Home_Call_Is_Accepted_While_Idle
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	fReference	: LREAL := 0.0;
	bAccepted	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Home_Call_Is_Accepted_While_Idle');
fbAxis(AxisRef := axisRef);
bAccepted := fbAxis.Home(fReference := fReference);
AssertTrue(Condition := bAccepted, Message := 'Home() is accepted when no homing runs (the guard only ignores calls during a homing)');
AssertTrue(Condition := fbAxis.HomePending, Message := 'the accepted request is pending');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Twice_In_One_Scan" Id="{27f9fd59-94b4-4508-811e-8f96312e4049}">
      <Declaration><![CDATA[// #93: the second Stop() in a scan is ignored.
METHOD PRIVATE Stop_Twice_In_One_Scan
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	bFirst	: BOOL;
	bSecond	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Twice_In_One_Scan');
fbAxis(AxisRef := axisRef);
bFirst := fbAxis.Stop();
bSecond := fbAxis.Stop();
AssertTrue(Condition := bFirst, Message := 'first Stop() requests an MC_Stop');
AssertFalse(Condition := bSecond, Message := 'second Stop() in the same scan is ignored');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Repeated_Next_Scan" Id="{8181193f-ebae-46c1-b8cf-f4d318f567ac}">
      <Declaration><![CDATA[// #93: a Stop() in the next scan, while the first request is still pending or running, is ignored.
METHOD PRIVATE Stop_Repeated_Next_Scan
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	bFirst	: BOOL;
	bSecond	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Repeated_Next_Scan');
fbAxis(AxisRef := axisRef);
bFirst := fbAxis.Stop();
fbAxis(AxisRef := axisRef);
bSecond := fbAxis.Stop();
AssertTrue(Condition := bFirst, Message := 'first Stop() requests an MC_Stop');
AssertFalse(Condition := bSecond, Message := 'repeated Stop() while the stop is on its way is ignored');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Ignored_Stop_Still_Cancels_Move" Id="{8d24cf24-3308-4d08-9479-07d4ad46d6d1}">
      <Declaration><![CDATA[// #93: an ignored Stop() still drops a MoveTo() requested after the first one.
METHOD PRIVATE Ignored_Stop_Still_Cancels_Move
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Ignored_Stop_Still_Cancels_Move');
fbAxis(AxisRef := axisRef);
fbAxis.Stop();
fbAxis.MoveTo();
fbAxis.Stop();
AssertFalse(Condition := fbAxis.MovePending, Message := 'the ignored Stop() cancelled the pending move');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Dynamics_Default_To_The_NC_Parameters" Id="{879d7cbf-b35a-4b20-8d91-9c956c9484c3}">
      <Declaration><![CDATA[// MONETcommon#272: StopDeceleration and StopJerk are 0.0 by default, so MC_Stop takes the NC axis parameters (the stop
// of before). The MC_Stop itself needs an NC axis and is checked on the hardware.
METHOD PRIVATE Stop_Dynamics_Default_To_The_NC_Parameters
VAR
	fbAxis	: FB_Axis;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Dynamics_Default_To_The_NC_Parameters');
AssertEquals_LREAL(Expected := 0.0, Actual := fbAxis.StopDeceleration, Delta := 0.0, Message := 'deceleration');
AssertEquals_LREAL(Expected := 0.0, Actual := fbAxis.StopJerk, Delta := 0.0, Message := 'jerk');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Locks_Motion_Commands" Id="{ced76145-a1bb-48fb-9bb3-b7d7d8fd7694}">
      <Declaration><![CDATA[// MONETcommon#278: while an MC_Stop is pending or executing, StopLocked holds MoveTo(), Home() and jog (the NC would refuse them
// with 16#4260). Without an NC axis the stop never starts (StopAllowed stays FALSE), so it stays pending until Reset.
METHOD PRIVATE Stop_Locks_Motion_Commands
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Locks_Motion_Commands');
fbAxis(AxisRef := axisRef);
AssertFalse(Condition := fbAxis.StopLocked, Message := 'no stop, no lock');
fbAxis.Stop();
fbAxis(AxisRef := axisRef);
AssertTrue(Condition := fbAxis.StopLocked, Message := 'the pending MC_Stop locks the motion commands');
fbAxis.MoveTo();
fbAxis(AxisRef := axisRef);
AssertTrue(Condition := fbAxis.MovePending, Message := 'a MoveTo() during the stop waits');
fbAxis(AxisRef := axisRef, Reset := TRUE);
fbAxis(AxisRef := axisRef, Reset := FALSE);
AssertFalse(Condition := fbAxis.StopLocked, Message := 'Reset drops the pending stop and the lock');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Feed_Velocity_Is_The_Fixed_Value_By_Default" Id="{9823a9cd-661e-4e32-b82b-30db852ecc76}">
      <Declaration><![CDATA[// #167: FeedFromPosition is FALSE by default: the fed velocity is the old one (0.009 cap for 0.0 difference ramps), not the position derivative.
METHOD PRIVATE Feed_Velocity_Is_The_Fixed_Value_By_Default
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	i		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Feed_Velocity_Is_The_Fixed_Value_By_Default');
fbAxis.Tracking := TRUE;
fbAxis.Position := 10.0;
SetActPos(axisRef := axisRef, fValue := 10.0);
fbAxis(AxisRef := axisRef);
fbAxis.Position := 10.5;	// a 0.5 deg step in one scan would be 50 deg/s as a derivative
fbAxis(AxisRef := axisRef);
fbAxis(AxisRef := axisRef);
AssertTrue(Condition := fbAxis.TrackVelocity <= 0.05, Message := 'the old fixed feed velocity (at most 0.05)');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Feed_Velocity_Follows_The_Fed_Position" Id="{a37cd07c-023c-47d6-bf50-341ae0bf6d64}">
      <Declaration><![CDATA[// #167: with FeedFromPosition the fed velocity is the change of the fed position per CycleTime, signed by its direction, in the
// first scan of a track request the old values are kept.
METHOD PRIVATE Feed_Velocity_Follows_The_Fed_Position
VAR
	fbAxis	: FB_Axis;
	axisRef	: AXIS_REF;
	i		: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Feed_Velocity_Follows_The_Fed_Position');
fbAxis.FeedFromPosition := TRUE;
fbAxis.CycleTime := 0.01;
fbAxis.Tracking := TRUE;
SetActPos(axisRef := axisRef, fValue := 10.0);
fbAxis.Position := 10.0;
fbAxis(AxisRef := axisRef);
AssertTrue(Condition := fbAxis.TrackVelocity <= 0.05, Message := 'first scan of the track request: the old value');
// the fed position rises by 0.005 deg per scan: 0.5 deg/s
FOR i := 1 TO 3 DO
	fbAxis.Position := fbAxis.Position + 0.005;
	fbAxis(AxisRef := axisRef);
END_FOR
AssertTrue(Condition := ABS(fbAxis.TrackVelocity - 0.5) < 1.0E-6, Message := 'velocity 0.5 deg/s');
AssertTrue(Condition := fbAxis.Direction = 1, Message := 'direction +1');
AssertTrue(Condition := fbAxis.TrackAcceleration < 0.0051, Message := 'constant velocity: acceleration at its floor');
// falling
FOR i := 1 TO 3 DO
	fbAxis.Position := fbAxis.Position - 0.005;
	fbAxis(AxisRef := axisRef);
END_FOR
AssertTrue(Condition := ABS(fbAxis.TrackVelocity - 0.5) < 1.0E-6, Message := 'speed 0.5 deg/s falling');
AssertTrue(Condition := fbAxis.Direction = -1, Message := 'direction -1');
// tracking ends: the next track request starts with the old values again
fbAxis.Tracking := FALSE;
fbAxis(AxisRef := axisRef);
fbAxis.Tracking := TRUE;
fbAxis.Position := fbAxis.Position + 5.0;
fbAxis(AxisRef := axisRef);
AssertTrue(Condition := fbAxis.TrackVelocity <= 0.05, Message := 'a new track request: the old value in its first scan');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
