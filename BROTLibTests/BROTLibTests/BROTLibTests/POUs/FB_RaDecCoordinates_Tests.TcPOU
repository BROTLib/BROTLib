<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_RaDecCoordinates_Tests" Id="{3c0483a7-16fd-40e9-9b5c-2f446ea37670}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for BROTLib.FB_RaDecCoordinates (IAG50cm#17). The AstroBROT transforms are tested in AstroBROT; here: the wiring, the signs,
// the refraction direction and the held inversion. Every test has its own instance because FB_EQ2HOR keeps state between calls.
FUNCTION_BLOCK FB_RaDecCoordinates_Tests EXTENDS TcUnit.FB_TestSuite
VAR
	fbBase		: BROTLib.FB_RaDecCoordinates;
	fbLater		: BROTLib.FB_RaDecCoordinates;
	fbHeld		: BROTLib.FB_RaDecCoordinates;
	fbObs		: BROTLib.FB_RaDecCoordinates;
	fbTheo		: BROTLib.FB_RaDecCoordinates;
	fbPole		: BROTLib.FB_RaDecCoordinates;
	fbMeridian	: BROTLib.FB_RaDecCoordinates;
	fbRaw		: BROTLib.FB_RaDecCoordinates;
	fbOffset	: BROTLib.FB_RaDecCoordinates;
	fbProbe		: BROTLib.FB_RaDecCoordinates;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Time_Offset_Moves_The_Hour_Angle();
Target_On_The_Meridian_Is_At_The_Zenith();
Slew_Target_Refraction_Direction();
Current_Without_Corrections_Is_Raw();
Declination_Offset_Is_Subtracted();
Invalid_Inversion_Keeps_The_Last_Valid_One();
Pole_And_Horizon_Stay_Finite();
]]></ST>
    </Implementation>
    <Method Name="Time_Offset_Moves_The_Hour_Angle" Id="{277b89b8-5112-4382-909c-7e62a8c25f5a}">
      <Declaration><![CDATA[// One hour of time offset is 15.04 degrees of hour angle (sidereal rate).
METHOD PRIVATE Time_Offset_Moves_The_Hour_Angle
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Time_Offset_Moves_The_Hour_Angle');
fbBase.fJd := 2460000.5;
fbBase.fLongitude := 10.0;
fbBase.fLatitude := 50.0;
fbBase.fAltitude := 300.0;
fbBase.fRightAscension := 100.0;
fbBase.fDeclination := 20.0;
fbBase.Target();
fbLater.fJd := 2460000.5;
fbLater.fLongitude := 10.0;
fbLater.fLatitude := 50.0;
fbLater.fAltitude := 300.0;
fbLater.fRightAscension := 100.0;
fbLater.fDeclination := 20.0;
fbLater.fTimeOffset := 1.0 / 24.0;
fbLater.Target();
AssertEquals_LREAL(Expected := 15.04, Actual := fbLater.fHourAngleApparent - fbBase.fHourAngleApparent, Delta := 0.05, Message := 'one hour later: +15.04 deg of hour angle');
AssertEquals_LREAL(Expected := fbBase.fDeclinationApparent, Actual := fbLater.fDeclinationApparent, Delta := 0.01, Message := 'declination does not move with time');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Target_On_The_Meridian_Is_At_The_Zenith" Id="{ea83e800-9912-41b9-9e87-9b4c40e86865}">
      <Declaration><![CDATA[// A target at the latitude on the meridian (hour angle 0) is at the zenith.
METHOD PRIVATE Target_On_The_Meridian_Is_At_The_Zenith
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Target_On_The_Meridian_Is_At_The_Zenith');
fbProbe.fJd := 2460000.5;
fbProbe.fLongitude := 10.0;
fbProbe.fLatitude := 50.0;
fbProbe.fAltitude := 300.0;
fbProbe.fRightAscension := 100.0;
fbProbe.fDeclination := 50.0;
fbProbe.Target();
fbMeridian.fJd := 2460000.5;
fbMeridian.fLongitude := 10.0;
fbMeridian.fLatitude := 50.0;
fbMeridian.fAltitude := 300.0;
fbMeridian.fRightAscension := 100.0 + fbProbe.fHourAngleApparent;
fbMeridian.fDeclination := 50.0;
fbMeridian.Target();
AssertEquals_LREAL(Expected := 0.0, Actual := fbMeridian.fHourAngleApparent, Delta := 0.05, Message := 'on the meridian');
AssertTrue(Condition := fbMeridian.fElevationCalc > 89.0, Message := 'on the meridian at dec = latitude: near the zenith');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slew_Target_Refraction_Direction" Id="{51077f83-bd2a-4ee9-bf6f-57a58f6c277c}">
      <Declaration><![CDATA[// The same Alt/Az read as theoretical or as observed gives a declination that differs by about twice the refraction
// (0.17 deg at 10 deg altitude).
METHOD PRIVATE Slew_Target_Refraction_Direction
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_Target_Refraction_Direction');
fbObs.fJd := 2460000.5;
fbObs.fLongitude := 10.0;
fbObs.fLatitude := 50.0;
fbObs.fAltitude := 300.0;
fbObs.fElevation := 10.0;
fbObs.fAzimuth := 180.0;
fbObs.bSlewAltIsObserved := TRUE;
fbObs.Target();
fbTheo.fJd := 2460000.5;
fbTheo.fLongitude := 10.0;
fbTheo.fLatitude := 50.0;
fbTheo.fAltitude := 300.0;
fbTheo.fElevation := 10.0;
fbTheo.fAzimuth := 180.0;
fbTheo.bSlewAltIsObserved := FALSE;
fbTheo.Target();
AssertTrue(Condition := ABS(fbObs.fDeclinationCalc - fbTheo.fDeclinationCalc) > 0.05, Message := 'refraction direction moves the slew target by more than 3 arcmin');
AssertTrue(Condition := ABS(fbObs.fDeclinationCalc - fbTheo.fDeclinationCalc) < 0.4, Message := '... and by less than 24 arcmin');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Current_Without_Corrections_Is_Raw" Id="{190b3ed8-2151-4b52-b056-0c62b5611c95}">
      <Declaration><![CDATA[// With no offsets and no inversion the corrected position is the raw one.
METHOD PRIVATE Current_Without_Corrections_Is_Raw
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Current_Without_Corrections_Is_Raw');
fbRaw.fJd := 2460000.5;
fbRaw.fLongitude := 10.0;
fbRaw.fLatitude := 50.0;
fbRaw.fAltitude := 300.0;
fbRaw.fRightAscension := 100.0;
fbRaw.fDeclination := 20.0;
fbRaw.Target();
fbRaw.fHourAngleCurrent := 0.0;
fbRaw.fDeclinationCurrent := 50.0;
fbRaw.bInversionValid := TRUE;
fbRaw.Current();
AssertEquals_LREAL(Expected := fbRaw.fRightAscensionCurrentICRS, Actual := fbRaw.fRightAscensionCurrentICRScorr, Delta := 1.0E-9, Message := 'RA corrected = raw');
AssertEquals_LREAL(Expected := fbRaw.fDeclinationCurrentICRS, Actual := fbRaw.fDeclinationCurrentICRScorr, Delta := 1.0E-9, Message := 'Dec corrected = raw');
AssertEquals_LREAL(Expected := fbRaw.fElevationCurrent, Actual := fbRaw.fElevationCurrentSky, Delta := 1.0E-9, Message := 'elevation sky = raw');
AssertTrue(Condition := fbRaw.fElevationCurrent > 89.0, Message := 'hour angle 0 at dec = latitude: axes at the zenith');
AssertEquals_LREAL(Expected := 50.0, Actual := fbRaw.fDeclinationCurrentICRS, Delta := 1.0, Message := 'ICRS Dec within precession of the apparent Dec');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Declination_Offset_Is_Subtracted" Id="{d86307d6-3eea-4e9d-8a7e-5bd57521f769}">
      <Declaration><![CDATA[// The user offset is subtracted from the axis position to get the sky position (as in IAG50cm).
METHOD PRIVATE Declination_Offset_Is_Subtracted
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Declination_Offset_Is_Subtracted');
fbOffset.fJd := 2460000.5;
fbOffset.fLongitude := 10.0;
fbOffset.fLatitude := 50.0;
fbOffset.fAltitude := 300.0;
fbOffset.fRightAscension := 100.0;
fbOffset.fDeclination := 20.0;
fbOffset.Target();
fbOffset.fHourAngleCurrent := 0.0;
fbOffset.fDeclinationCurrent := 50.0;
fbOffset.fDeclinationOffset := 0.5;
fbOffset.bInversionValid := TRUE;
fbOffset.Current();
AssertEquals_LREAL(Expected := fbOffset.fDeclinationCurrentICRS - 0.5, Actual := fbOffset.fDeclinationCurrentICRScorr, Delta := 0.01, Message := 'sky Dec = axis Dec - offset');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Invalid_Inversion_Keeps_The_Last_Valid_One" Id="{6eed67ce-ddd4-40b0-a6e4-82208a16e62e}">
      <Declaration><![CDATA[METHOD PRIVATE Invalid_Inversion_Keeps_The_Last_Valid_One
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Invalid_Inversion_Keeps_The_Last_Valid_One');
fbHeld.fJd := 2460000.5;
fbHeld.fLongitude := 10.0;
fbHeld.fLatitude := 50.0;
fbHeld.fAltitude := 300.0;
fbHeld.fRightAscension := 100.0;
fbHeld.fDeclination := 20.0;
fbHeld.Target();
fbHeld.fHourAngleCurrent := 0.0;
fbHeld.fDeclinationCurrent := 50.0;
// nothing valid yet: no correction
fbHeld.fHourAngleInversion := 3.0;
fbHeld.fDeclinationInversion := 4.0;
fbHeld.bInversionValid := FALSE;
fbHeld.Current();
AssertEquals_LREAL(Expected := 0.0, Actual := fbHeld.fDeclinationInversionHeld, Delta := 1.0E-12, Message := 'invalid from the start: 0');
// valid
fbHeld.fHourAngleInversion := 1.0;
fbHeld.fDeclinationInversion := 0.2;
fbHeld.bInversionValid := TRUE;
fbHeld.Current();
AssertEquals_LREAL(Expected := 0.2, Actual := fbHeld.fDeclinationInversionHeld, Delta := 1.0E-12, Message := 'valid: taken');
AssertEquals_LREAL(Expected := 1.0, Actual := fbHeld.fHourAngleInversionHeld, Delta := 1.0E-12, Message := 'valid: HA taken');
AssertEquals_LREAL(Expected := fbHeld.fDeclinationCurrentICRS - 0.2, Actual := fbHeld.fDeclinationCurrentICRScorr, Delta := 0.01, Message := 'corrected by the inversion');
// invalid again: the garbage is ignored
fbHeld.fHourAngleInversion := 77.0;
fbHeld.fDeclinationInversion := -55.0;
fbHeld.bInversionValid := FALSE;
fbHeld.Current();
AssertEquals_LREAL(Expected := 0.2, Actual := fbHeld.fDeclinationInversionHeld, Delta := 1.0E-12, Message := 'invalid: last valid kept');
AssertEquals_LREAL(Expected := 1.0, Actual := fbHeld.fHourAngleInversionHeld, Delta := 1.0E-12, Message := 'invalid: HA kept');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Pole_And_Horizon_Stay_Finite" Id="{7792b469-519d-4460-8e49-2f8c66af454e}">
      <Declaration><![CDATA[METHOD PRIVATE Pole_And_Horizon_Stay_Finite
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Pole_And_Horizon_Stay_Finite');
fbPole.fJd := 2460000.5;
fbPole.fLongitude := 10.0;
fbPole.fLatitude := 50.0;
fbPole.fAltitude := 300.0;
fbPole.fRightAscension := 10.0;
fbPole.fDeclination := 89.9;
fbPole.fElevation := -5.0;
fbPole.fAzimuth := 0.0;
fbPole.Target();
fbPole.fHourAngleCurrent := 179.0;
fbPole.fDeclinationCurrent := 89.9;
fbPole.bInversionValid := TRUE;
fbPole.Current();
AssertTrue(Condition := ABS(fbPole.fHourAngleApparent) < 1.0E6, Message := 'HA finite');
AssertTrue(Condition := ABS(fbPole.fElevationCalc) < 1.0E6, Message := 'target elevation finite');
AssertTrue(Condition := ABS(fbPole.fDeclinationCalc) < 1.0E6, Message := 'slew target below the horizon finite');
AssertTrue(Condition := ABS(fbPole.fElevationCurrentSky) < 1.0E6, Message := 'sky elevation finite');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>