<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_RaDecTelescopeControl_Tests" Id="{f0bf5675-76b1-4a8b-a673-094bee10c05a}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for BROTLib.FB_RaDecTelescopeControl through a minimal concrete subclass (IAG50cm#17).
FUNCTION_BLOCK FB_RaDecTelescopeControl_Tests EXTENDS TcUnit.FB_TestSuite
VAR
	fbTel	: FB_RaDecTestTelescope(comm := 0);
	fbTelClock	: FB_RaDecTestTelescope(comm := 0);
	fbTelProps	: FB_RaDecTestTelescope(comm := 0);
	fbTelPublish	: FB_RaDecTestTelescope(comm := 0);
	fbTelCoord	: FB_RaDecTestTelescope(comm := 0);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Offsets_Through_The_Interface();
Clock_Not_Valid_Leaves_Jd_Alone();
Properties_Follow_The_Current_ICRS_Position();
Publish_Without_Comm_Does_Not_Crash();
Update_Target_And_Current_Fill_The_Inherited_Outputs();
]]></ST>
    </Implementation>
    <Method Name="Offsets_Through_The_Interface" Id="{ac17e69c-41d3-4bce-9b5c-6c1141b552a8}">
      <Declaration><![CDATA[METHOD PRIVATE Offsets_Through_The_Interface
VAR
	ipRaDec	: BROTLib.I_RaDecTelescope;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Offsets_Through_The_Interface');
ipRaDec := fbTel;
ipRaDec.HourAngleOffset := 0.25;
ipRaDec.DeclinationOffset := -0.5;
AssertEquals_LREAL(Expected := 0.25, Actual := ipRaDec.HourAngleOffset, Delta := 1.0E-12, Message := 'HA offset through I_RaDecTelescope');
AssertEquals_LREAL(Expected := -0.5, Actual := ipRaDec.DeclinationOffset, Delta := 1.0E-12, Message := 'Dec offset through I_RaDecTelescope');
AssertEquals_LREAL(Expected := 0.25, Actual := fbTel.fHourAngleOffset, Delta := 1.0E-12, Message := 'the input holds it');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clock_Not_Valid_Leaves_Jd_Alone" Id="{76745789-e629-4d4e-80ab-5d21e8469786}">
      <Declaration><![CDATA[// Without a synchronised clock (no ADS read happens in the test) fJd stays and the method says so.
METHOD PRIVATE Clock_Not_Valid_Leaves_Jd_Alone
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Clock_Not_Valid_Leaves_Jd_Alone');
AssertFalse(Condition := fbTelClock.UpdateClock(), Message := 'clock not valid yet');
AssertEquals_LREAL(Expected := 0.0, Actual := fbTelClock.fJd, Delta := 1.0E-12, Message := 'fJd not set from an invalid clock');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Properties_Follow_The_Current_ICRS_Position" Id="{f42aa776-ba15-44a7-815d-aabded30d76c}">
      <Declaration><![CDATA[METHOD PRIVATE Properties_Follow_The_Current_ICRS_Position
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Properties_Follow_The_Current_ICRS_Position');
fbTelProps.SetCurrentICRS(123.0, -12.5);
AssertEquals_LREAL(Expected := 123.0, Actual := fbTelProps.RightAscension, Delta := 1.0E-12, Message := 'RightAscension');
AssertEquals_LREAL(Expected := -12.5, Actual := fbTelProps.Declination, Delta := 1.0E-12, Message := 'Declination');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Publish_Without_Comm_Does_Not_Crash" Id="{2c8c14b3-6679-4ef9-908f-02a672cfe420}">
      <Declaration><![CDATA[// fbComm is only set through FB_Init(comm := ...); an unassigned interface reference would crash the PLC task (BROTLib#7).
METHOD PRIVATE Publish_Without_Comm_Does_Not_Crash
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Publish_Without_Comm_Does_Not_Crash');
fbTelPublish.fHourAngleOffset := 0.5;
fbTelPublish._PublishTelemetry();
AssertEquals_LREAL(Expected := 0.5, Actual := fbTelPublish.fHourAngleOffset, Delta := 1.0E-12, Message := 'returned without a crash');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Update_Target_And_Current_Fill_The_Inherited_Outputs" Id="{bbb756e4-8b65-4422-9f9b-1623477731aa}">
      <Declaration><![CDATA[METHOD PRIVATE Update_Target_And_Current_Fill_The_Inherited_Outputs
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Update_Target_And_Current_Fill_The_Inherited_Outputs');
fbTelCoord.telescopeConfig.longitude := 10.0;
fbTelCoord.telescopeConfig.latitude := 50.0;
fbTelCoord.telescopeConfig.altitude := 300.0;
fbTelCoord.SetJd(2460000.5);
fbTelCoord.fRightAscension := 100.0;
fbTelCoord.fDeclination := 50.0;
fbTelCoord._UpdateTarget();
fbTelCoord.SetAxes(0.0, 50.0);
fbTelCoord._UpdateCurrent(0.0, 0.0, TRUE);
AssertTrue(Condition := ABS(fbTelCoord.fDeclinationApparent - 50.0) < 1.0, Message := 'apparent Dec within precession of the catalog Dec');
AssertTrue(Condition := fbTelCoord.fElevationCurrent > 89.0, Message := 'axes at HA 0, Dec = latitude: zenith, in the inherited output');
AssertEquals_LREAL(Expected := fbTelCoord.fRightAscensionCurrentICRS, Actual := fbTelCoord.fRightAscensionCurrent, Delta := 1.0E-12, Message := 'the base fRightAscensionCurrent follows');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>