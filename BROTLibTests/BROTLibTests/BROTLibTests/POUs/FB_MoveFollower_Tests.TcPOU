<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_MoveFollower_Tests" Id="{007b757b-9653-4fa3-b5ee-3ee10b9b17eb}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for BROTLib.FB_MoveFollower, the start / re-target / stop logic of the focus blocks (MONETcommon#122). Each
// fbF(...) call is one cycle; MoveDone, Aborted and StopDone are what fbAxis reported in its last call.
FUNCTION_BLOCK FB_MoveFollower_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Start_When_Off_Target();
No_Start_Within_Tolerance();
No_Start_When_Not_Ready_Requests_Enable();
Pending_Move_Requests_Enable();
Pending_Move_Ready_Again_No_Restart();
Moving_And_Ready_No_Need_Enable();
Stopped_Or_Error_No_Need_Enable();
Retarget_While_Moving_Restarts();
Retarget_Within_Tolerance_No_Restart();
Hunting_Does_Not_Restart();
MoveDone_Ends_Move();
Abort_Ends_Move();
Abort_Of_Old_Move_After_Restart_Is_Ignored();
Error_Ends_Move();
Stop_Blocks_Restart_Until_New_Target();
Stop_Without_Move_Returns_False();
Inactive_Never_Starts();
Settles_Inside_HoldBand_No_Restart();
First_Cycle_Within_Tolerance_Settles();
Drift_Inside_HoldBand_No_NeedEnable();
Drift_Beyond_HoldBand_Moves_Again();
New_Small_Target_Still_Moves();
Miss_Beyond_HoldBand_Retries_Then_Gives_Up();
Hunting_Limited_By_Retries();
New_Target_Clears_Missed_And_Retries();
Inactive_Clears_Settled();
Legacy_Settings_Restart_After_Every_Miss();
]]></ST>
    </Implementation>
    <Method Name="Start_When_Off_Target" Id="{18c23736-7b2f-428e-83c0-4eaf8f8f397d}">
      <Declaration><![CDATA[// Off target and ready: one start, then it is moving.
METHOD PRIVATE Start_When_Off_Target
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Start_When_Off_Target');
fT := 50.0; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'start');
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bMoving, Message := 'moving');
AssertEquals_LREAL(Expected := 50.0, Actual := fbF.fMoveTarget, Delta := 1.0E-9, Message := 'move target');
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'no second start');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="No_Start_Within_Tolerance" Id="{841caf47-c3bf-4d54-aa6c-78ab5097a08c}">
      <Declaration><![CDATA[// At the target: nothing to do.
METHOD PRIVATE No_Start_Within_Tolerance
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('No_Start_Within_Tolerance');
fT := 36.002; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'start');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bMoving, Message := 'moving');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="No_Start_When_Not_Ready_Requests_Enable" Id="{10f888c7-a8e5-4525-a0fd-de04aaf40d3c}">
      <Declaration><![CDATA[// Off target but the axis is not ready: ask for the enable, start nothing.
METHOD PRIVATE No_Start_When_Not_Ready_Requests_Enable
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('No_Start_When_Not_Ready_Requests_Enable');
fT := 50.0; fA := 36.0; bR := FALSE;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'start');
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bNeedEnable, Message := 'need enable');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bMoving, Message := 'moving');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Retarget_While_Moving_Restarts" Id="{7af1b6f9-6939-409b-9855-cc337653606f}">
      <Declaration><![CDATA[// A new target during the move restarts it once (MONETcommon#122).
METHOD PRIVATE Retarget_While_Moving_Restarts
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Retarget_While_Moving_Restarts');
fT := 60.0; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fA := 40.0; fT := 40.5;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'restart');
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bMoving, Message := 'still moving');
AssertEquals_LREAL(Expected := 40.5, Actual := fbF.fMoveTarget, Delta := 1.0E-9, Message := 'new move target');
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'one restart only');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Retarget_Within_Tolerance_No_Restart" Id="{7ddc6fc2-940f-4598-ba2d-dee8ad75b48b}">
      <Declaration><![CDATA[// A target change below the tolerance does not restart.
METHOD PRIVATE Retarget_Within_Tolerance_No_Restart
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Retarget_Within_Tolerance_No_Restart');
fT := 60.0; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fT := 60.003;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'restart');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Hunting_Does_Not_Restart" Id="{6144aab4-06ee-4018-be60-de50f446f81c}">
      <Declaration><![CDATA[// The actual position oscillates around a fixed target: no restart (HalfBROT#85).
METHOD PRIVATE Hunting_Does_Not_Restart
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Hunting_Does_Not_Restart');
fT := 36.0; fA := 36.5;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fA := 35.96;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'restart low');
fA := 36.04;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'restart high');
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bMoving, Message := 'moving');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveDone_Ends_Move" Id="{32df6425-daa1-4768-a98e-ebcf4567ef1e}">
      <Declaration><![CDATA[// MoveDone ends the move; at the target nothing starts.
METHOD PRIVATE MoveDone_Ends_Move
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('MoveDone_Ends_Move');
fT := 50.0; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fA := 50.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bMoving, Message := 'moving');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'start');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Abort_Ends_Move" Id="{69275bb4-c5da-4246-8d55-b3a1b0f8c98d}">
      <Declaration><![CDATA[// An aborted move ends; the still open target starts it again.
METHOD PRIVATE Abort_Ends_Move
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Abort_Ends_Move');
fT := 50.0; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fA := 40.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := TRUE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'start again');
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bMoving, Message := 'moving');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Abort_Of_Old_Move_After_Restart_Is_Ignored" Id="{e3b4639a-bebc-40cb-9104-1b8d44b2f117}">
      <Declaration><![CDATA[// The abort that a restart causes for the old move does not end the new one.
METHOD PRIVATE Abort_Of_Old_Move_After_Restart_Is_Ignored
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Abort_Of_Old_Move_After_Restart_Is_Ignored');
fT := 60.0; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fT := 45.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := TRUE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bMoving, Message := 'moving');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'no extra start');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Error_Ends_Move" Id="{cf5bc90f-6c01-4af4-8168-c0ca0867b156}">
      <Declaration><![CDATA[// An axis error ends the move, nothing restarts it.
METHOD PRIVATE Error_Ends_Move
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Error_Ends_Move');
fT := 50.0; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := TRUE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bMoving, Message := 'moving');
// the error is gone, the target is still open: it starts again
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'start after the error');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Blocks_Restart_Until_New_Target" Id="{bd78d734-c06b-4178-bbf3-78609612032a}">
      <Declaration><![CDATA[// After Stop() the old target is held; a new one moves again.
METHOD PRIVATE Stop_Blocks_Restart_Until_New_Target
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Blocks_Restart_Until_New_Target');
fT := 50.0; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fA := 42.0;
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.Stop(), Message := 'Stop returns TRUE while moving');
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'held');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bMoving, Message := 'moving');
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := TRUE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'still held after StopDone');
fT := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'new target moves');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Without_Move_Returns_False" Id="{324eae43-8310-4fc2-a190-990b72de81d6}">
      <Declaration><![CDATA[// Stop() with nothing running returns FALSE.
METHOD PRIVATE Stop_Without_Move_Returns_False
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Without_Move_Returns_False');
fT := 36.0; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.Stop(), Message := 'Stop returns FALSE at rest');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Inactive_Never_Starts" Id="{1f5f65d9-fecc-403e-b010-1de0c0e7f4bb}">
      <Declaration><![CDATA[// Not active (manual mode, not calibrated): no start, no move.
METHOD PRIVATE Inactive_Never_Starts
VAR
	fbF	: BROTLib.FB_MoveFollower;
	fT		: LREAL;
	fA		: LREAL;
	bR		: BOOL := TRUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Inactive_Never_Starts');
fT := 50.0; fA := 36.0;
fbF(fTarget := fT, fActual := fA, fTolerance := 0.005, bActive := FALSE, bReady := bR, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'start');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bNeedEnable, Message := 'need enable');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bMoving, Message := 'moving');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Pending_Move_Requests_Enable" Id="{1b5a0d36-a5aa-4eea-9c9d-8bd864cf2f38}">
      <Declaration><![CDATA[// A started move whose axis is no longer ready (the drive was disabled, MoveTo() pending) asks for the enable (HalfBROT#108, #111).
METHOD PRIVATE Pending_Move_Requests_Enable
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Pending_Move_Requests_Enable');
fbF(fTarget := 36.0, fActual := 91.99, fTolerance := 0.005, bReady := TRUE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'start');
fbF(fTarget := 36.0, fActual := 91.99, fTolerance := 0.005, bReady := FALSE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bNeedEnable, Message := 'need enable');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'no second start');
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bMoving, Message := 'still moving');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Pending_Move_Ready_Again_No_Restart" Id="{35dd5958-a57e-45ae-b57b-b51b970c9041}">
      <Declaration><![CDATA[// When the axis is ready again the enable request ends and the move is not started a second time.
METHOD PRIVATE Pending_Move_Ready_Again_No_Restart
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Pending_Move_Ready_Again_No_Restart');
fbF(fTarget := 36.0, fActual := 91.99, fTolerance := 0.005, bReady := TRUE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 36.0, fActual := 91.99, fTolerance := 0.005, bReady := FALSE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 36.0, fActual := 91.99, fTolerance := 0.005, bReady := TRUE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bNeedEnable, Message := 'need enable');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'start');
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bMoving, Message := 'moving');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Moving_And_Ready_No_Need_Enable" Id="{649ee1d0-1ddf-40c5-89d6-362acd2e7229}">
      <Declaration><![CDATA[// A running move on a ready axis needs nothing.
METHOD PRIVATE Moving_And_Ready_No_Need_Enable
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Moving_And_Ready_No_Need_Enable');
fbF(fTarget := 36.0, fActual := 91.99, fTolerance := 0.005, bReady := TRUE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 36.0, fActual := 80.0, fTolerance := 0.005, bReady := TRUE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bNeedEnable, Message := 'need enable');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stopped_Or_Error_No_Need_Enable" Id="{9cec7a51-9cb6-460f-a4d7-f3ae5ef80ea9}">
      <Declaration><![CDATA[// After Stop() and after an error nothing asks for the enable, although the axis is not ready.
METHOD PRIVATE Stopped_Or_Error_No_Need_Enable
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stopped_Or_Error_No_Need_Enable');
fbF(fTarget := 36.0, fActual := 91.99, fTolerance := 0.005, bReady := TRUE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF.Stop();
fbF(fTarget := 36.0, fActual := 91.99, fTolerance := 0.005, bReady := FALSE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bNeedEnable, Message := 'after stop');
fbF(fTarget := 50.0, fActual := 91.99, fTolerance := 0.005, bReady := TRUE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 50.0, fActual := 91.99, fTolerance := 0.005, bReady := FALSE, bActive := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := TRUE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bNeedEnable, Message := 'after error');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Settles_Inside_HoldBand_No_Restart" Id="{6aa9c9ca-c6af-408b-86aa-efd5b52fa136}">
      <Declaration><![CDATA[// A move that ends 6 um off (tolerance 5 um) has arrived: no restart, no enable request, nothing for the brake to wait for (HalfBROT#85).
METHOD PRIVATE Settles_Inside_HoldBand_No_Restart
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Settles_Inside_HoldBand_No_Restart');
fbF(fTarget := 50.0, fActual := 36.0, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 50.0, fActual := 49.994, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bSettled, Message := 'settled');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'no restart');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bMoving, Message := 'moving');
fbF(fTarget := 50.0, fActual := 49.994, fTolerance := 0.005, bActive := TRUE, bReady := FALSE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'still no start');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bNeedEnable, Message := 'no enable request');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="First_Cycle_Within_Tolerance_Settles" Id="{79db265f-48b7-477f-95f2-b316e13bb16b}">
      <Declaration><![CDATA[// At the target from the start (target initialised to the actual position): settled at once, no move.
METHOD PRIVATE First_Cycle_Within_Tolerance_Settles
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('First_Cycle_Within_Tolerance_Settles');
fbF(fTarget := 36.0, fActual := 36.002, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bSettled, Message := 'settled');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'start');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Drift_Inside_HoldBand_No_NeedEnable" Id="{d2594c9e-99fd-4548-95c1-0b41b9154b62}">
      <Declaration><![CDATA[// A locked (not ready) settled axis that drifts 13 um does not ask for the enable (HalfBROT#85, after the power-on).
METHOD PRIVATE Drift_Inside_HoldBand_No_NeedEnable
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Drift_Inside_HoldBand_No_NeedEnable');
fbF(fTarget := 36.0, fActual := 36.002, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 36.0, fActual := 36.013, fTolerance := 0.005, bActive := TRUE, bReady := FALSE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bNeedEnable, Message := 'need enable');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'start');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Drift_Beyond_HoldBand_Moves_Again" Id="{936aad07-18f0-4ce5-ab96-1b095d24a519}">
      <Declaration><![CDATA[// A drift beyond the hold band asks for the enable, then moves back.
METHOD PRIVATE Drift_Beyond_HoldBand_Moves_Again
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Drift_Beyond_HoldBand_Moves_Again');
fbF(fTarget := 36.0, fActual := 36.002, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 36.0, fActual := 36.05, fTolerance := 0.005, bActive := TRUE, bReady := FALSE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bNeedEnable, Message := 'need enable');
fbF(fTarget := 36.0, fActual := 36.05, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'start');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bSettled, Message := 'not settled while moving');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="New_Small_Target_Still_Moves" Id="{e6300e5f-7fe4-450c-ad5a-6152cb4f8965}">
      <Declaration><![CDATA[// A new target 0.01 mm away (more than the tolerance) moves although it is inside the hold band.
METHOD PRIVATE New_Small_Target_Still_Moves
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('New_Small_Target_Still_Moves');
fbF(fTarget := 36.0, fActual := 36.002, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 36.01, fActual := 36.0, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'start');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Miss_Beyond_HoldBand_Retries_Then_Gives_Up" Id="{8219edbc-8f81-4069-a2b8-34518a710698}">
      <Declaration><![CDATA[// A move that ends beyond the hold band is corrected nMaxRetries times, then it settles with bTargetMissed and nothing moves again.
METHOD PRIVATE Miss_Beyond_HoldBand_Retries_Then_Gives_Up
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Miss_Beyond_HoldBand_Retries_Then_Gives_Up');
fbF(fTarget := 50.0, fActual := 36.0, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 50.0, fActual := 49.9, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'first correction');
fbF(fTarget := 50.0, fActual := 49.9, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'second correction');
fbF(fTarget := 50.0, fActual := 49.9, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'retries used up');
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bTargetMissed, Message := 'target missed');
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bSettled, Message := 'settled');
AssertEquals_UINT(Expected := 2, Actual := fbF.nRetries, Message := 'retries');
fbF(fTarget := 50.0, fActual := 49.9, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 50.0, fActual := 49.9, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bStartMove, Message := 'no further start');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bNeedEnable, Message := 'no enable request');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Hunting_Limited_By_Retries" Id="{f6761c2f-a1cc-4554-b286-9062d5077b2f}">
      <Declaration><![CDATA[// An axis that lands +-0.04 mm off every time is started nMaxRetries + 1 times in all, not forever.
METHOD PRIVATE Hunting_Limited_By_Retries
VAR
	fbF	: BROTLib.FB_MoveFollower;
	nStarts	: INT;
	i		: INT;
	fA		: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Hunting_Limited_By_Retries');
nStarts := 0; fA := 36.5;
fbF(fTarget := 36.0, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
IF fbF.bStartMove THEN nStarts := nStarts + 1; END_IF
FOR i := 1 TO 20 DO
	IF i MOD 2 = 0 THEN fA := 36.04; ELSE fA := 35.96; END_IF
	fbF(fTarget := 36.0, fActual := fA, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
	IF fbF.bStartMove THEN nStarts := nStarts + 1; END_IF
END_FOR
AssertEquals_INT(Expected := 3, Actual := nStarts, Message := 'starts');
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bTargetMissed, Message := 'target missed');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="New_Target_Clears_Missed_And_Retries" Id="{f8f3ebb2-b88d-4db4-abc6-74289ccc5b48}">
      <Declaration><![CDATA[// After giving up a new target moves again and the retry count starts over.
METHOD PRIVATE New_Target_Clears_Missed_And_Retries
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('New_Target_Clears_Missed_And_Retries');
fbF(fTarget := 50.0, fActual := 36.0, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 50.0, fActual := 49.9, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 50.0, fActual := 49.9, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 50.0, fActual := 49.9, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 55.0, fActual := 49.9, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'start');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bTargetMissed, Message := 'target missed');
AssertEquals_UINT(Expected := 0, Actual := fbF.nRetries, Message := 'retries');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Inactive_Clears_Settled" Id="{1f23b56c-6bbe-4344-a706-e2cf64c2487d}">
      <Declaration><![CDATA[// Leaving automatic mode clears the arrival: the next activation judges the axis anew.
METHOD PRIVATE Inactive_Clears_Settled
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Inactive_Clears_Settled');
fbF(fTarget := 36.0, fActual := 36.002, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
fbF(fTarget := 36.0, fActual := 36.002, fTolerance := 0.005, bActive := FALSE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bSettled, Message := 'settled');
fbF(fTarget := 36.0, fActual := 36.05, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'start');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Legacy_Settings_Restart_After_Every_Miss" Id="{787e5b7d-e7ee-4b6b-b3ce-c3628916b282}">
      <Declaration><![CDATA[// fHoldBand 0 and nMaxRetries 0 give the old behaviour: a move that ends 6 um off starts again, without a limit.
METHOD PRIVATE Legacy_Settings_Restart_After_Every_Miss
VAR
	fbF	: BROTLib.FB_MoveFollower;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Legacy_Settings_Restart_After_Every_Miss');
fbF(fTarget := 50.0, fActual := 36.0, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := FALSE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE, fHoldBand := 0.0, nMaxRetries := 0);
fbF(fTarget := 50.0, fActual := 49.994, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE, fHoldBand := 0.0, nMaxRetries := 0);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'first restart');
fbF(fTarget := 50.0, fActual := 49.994, fTolerance := 0.005, bActive := TRUE, bReady := TRUE, bMoveDone := TRUE, bAborted := FALSE, bError := FALSE, bStopDone := FALSE, fHoldBand := 0.0, nMaxRetries := 0);
AssertEquals_BOOL(Expected := TRUE, Actual := fbF.bStartMove, Message := 'second restart');
AssertEquals_BOOL(Expected := FALSE, Actual := fbF.bTargetMissed, Message := 'target missed');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
