	fbYRealTests			: FB_YREAL_Tests;
	fbTrackingTests			: FB_Tracking_Tests;
	fbPointingModelTests	: FB_PointingModel_Tests;
	fbBlinkTests			: FB_Blink_Tests;
END_VAR
]]></Declaration>
