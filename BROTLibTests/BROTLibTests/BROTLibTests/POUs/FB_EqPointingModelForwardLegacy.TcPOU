<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_EqPointingModelForwardLegacy" Id="{4254b7f8-328c-41cf-a598-ef70e16dc005}" SpecialFunc="None">
    <Declaration><![CDATA[// FB_PointingModelForward as it was at IAG50cm develop 84183d7, before IAG50cm#7, frozen with the coefficients of
// GVL_Pointing of that commit as constants (copied from IAG50cm's test project). The oracle for BROTLib's
// FB_EqPointingModelForward and FB_EqPointing in E_RefractionMode.OLD: with these coefficients they must give exactly the
// same numbers (FB_EqPointing_Tests). Do not change it.
FUNCTION_BLOCK FB_EqPointingModelForwardLegacy
VAR_INPUT
	HourAngle		: LREAL;
	Declination		: LREAL;
	Latitude		: LREAL;
END_VAR
VAR_OUTPUT
	HourAngle_correction	: LREAL;
	Declination_correction	: LREAL;
	HourAngle_velocity		: LREAL;
	Declination_velocity 	: LREAL;
	bValid					: BOOL;	// FALSE if the target is below fMinSinAlt (altitude < 1 deg): the refraction terms divide by sin_alt and are not physical there (#134). Corrections and Dec velocity are 0.0, HA velocity is sidereal when FALSE.
END_VAR
VAR
	// inputs in rad
	tau		: LREAL;
	dec		: LREAL;
	alt		: LREAL;
	lat		: LREAL;
	// offsets
	off_tau_esti : LREAL :=0.0;
	off_dec_esti : LREAL :=0.0;
	// trackingspeeds
	track_tau_esti : LREAL := 0.0;
	track_dec_esti : LREAL := 0.0;
	// Altitude
	alt_diff : LREAL;
	// pre calculated sin/cos
	sin_tau	: LREAL;
	cos_tau	: LREAL;
	sin_dec	: LREAL;
	cos_dec : LREAL;
	sin_lat	: LREAL;
	cos_lat : LREAL;
	sin_alt : LREAL;
	sin_alt_rate : LREAL;
	cos_alt : LREAL;
END_VAR
VAR	// the coefficients as variables, as they were in GVL_Pointing (no constant folding that the real block would not have)
	C_mAl_tau	: LREAL := 0.01687078;
	C_mEl_tau	: LREAL := -0.02608578;
	C_Coll_tau	: LREAL := 0.29826615;
	C_Refr_tau	: LREAL := -0.00759962;
	C_Enc_tau	: LREAL := 0.00108764;
	C_Flex_tau	: LREAL := -0.02462705;
	C_NP_tau	: LREAL := 0.02128217;
	C_mAl_dec	: LREAL := 0.01606325;
	C_mEl_dec	: LREAL := -0.05749048;
	C_Coll_dec	: LREAL := -0.17376101;
	C_Refr_dec	: LREAL := 0.01678090;
	C_Flex_dec	: LREAL := -0.01915146;
END_VAR
VAR CONSTANT
	d2r		: LREAL := PI/180.0;
	omega 	: LREAL := 360.0 / 86164.099 * (PI/180.0); //sidereal velocity
	fMinSinAlt : LREAL := 0.017452406437283512;	// SIN(1 deg), below this the refraction terms are not evaluated (#134)
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// degrees to rad
tau := HourAngle * d2r;
dec	:= Declination * d2r;
lat := Latitude * d2r;


// pre-calculate repeating sine and cosine functions
sin_TAU := SIN(tau);
cos_TAU := COS(tau);
sin_DEC := SIN(dec);
cos_DEC := COS(dec);
sin_lat := SIN(lat);
cos_lat := COS(lat);

// alt difference estimation (WITHOUT Nutation, Aberation, Presession)
sin_alt := sin_DEC * sin_lat + cos_DEC * cos_lat * cos_TAU;
sin_alt := LIMIT(-1.0, sin_alt, 1.0);	// rounding can give 1 + 2.2E-16 at the zenith, ASIN of that is NaN (#4)
alt := ASIN(sin_alt);					// diagnostics only, not used below
cos_alt := SQRT(1.0 - sin_alt * sin_alt);	// = COS(alt) >= 0
// d(sin alt)/dt = cos(alt) * d(alt)/dt. Finite everywhere; d(alt)/dt itself is 0/0 at the zenith (#4)
sin_alt_rate := -omega * cos_DEC * cos_lat * sin_TAU;
IF cos_alt > 1.0E-9 THEN
	alt_diff := sin_alt_rate / cos_alt;	// diagnostics only, not used below
ELSE
	alt_diff := 0.0;
END_IF

// below 1 deg altitude (also below the horizon) the refraction terms divide by sin_alt (Inf at the horizon) and refraction
// is not physical there: no correction, sidereal HA velocity, and the caller can refuse the target (#134)
IF sin_alt < fMinSinAlt THEN
	bValid := FALSE;
	HourAngle_correction	:= 0.0;
	Declination_correction	:= 0.0;
	HourAngle_velocity		:= omega / d2r;
	Declination_velocity	:= 0.0;
	RETURN;
END_IF
bValid := TRUE;

// ### TAU offset ###
off_tau_esti := - C_mAl_tau * ((cos_TAU * sin_DEC) / cos_DEC);
off_tau_esti := off_tau_esti + C_mEl_tau * ((sin_TAU * sin_DEC) / cos_DEC);
off_tau_esti := off_tau_esti + C_Coll_tau;
off_tau_esti := off_tau_esti + C_Refr_tau * ((sin_TAU * cos_lat) / (sin_alt * cos_DEC)); 
off_tau_esti := off_tau_esti + C_Flex_tau * ((sin_TAU * cos_lat) / cos_DEC);
off_tau_esti := off_tau_esti + C_Enc_tau / cos_DEC;
off_tau_esti := off_tau_esti - C_NP_tau * (sin_DEC / cos_DEC);


track_tau_esti := c_mal_tau * omega * ((sin_TAU * sin_DEC) / cos_DEC);
track_tau_esti := track_tau_esti + c_mel_tau * omega * ((cos_TAU * sin_DEC) / cos_DEC);
track_tau_esti := track_tau_esti + c_refr_tau * omega * ((cos_TAU * cos_lat) / (sin_alt * cos_DEC)); // 1ST derivative term
track_tau_esti := track_tau_esti - c_refr_tau * sin_alt_rate * ((sin_TAU * cos_lat) / (sin_alt*sin_alt * cos_DEC)); // 2nd term
track_tau_esti := track_tau_esti + c_flex_tau * omega * ((cos_TAU * cos_lat) / cos_DEC);


// ### DEC offset ###
off_dec_esti := C_mAl_dec * sin_TAU;
off_dec_esti := off_dec_esti + C_mEl_dec * cos_TAU;
off_dec_esti := off_dec_esti + C_Coll_dec;
off_dec_esti := off_dec_esti + C_Refr_dec * ((sin_lat - sin_alt * sin_DEC) / (cos_DEC * sin_alt));
off_dec_esti := off_dec_esti - C_Flex_dec * ((sin_lat - sin_alt * sin_DEC) / cos_DEC);


track_dec_esti := c_mal_dec * omega * cos_TAU;
track_dec_esti := track_dec_esti - c_mel_dec * omega * sin_TAU;
track_dec_esti := track_dec_esti - c_refr_dec * sin_alt_rate * (sin_DEC / (cos_DEC * sin_alt));//# 1ST term
track_dec_esti := track_dec_esti - c_refr_dec * sin_alt_rate * ((sin_lat - sin_alt * sin_DEC) / (cos_DEC * sin_alt*sin_alt)); //# 2nd derivative term
track_dec_esti := track_dec_esti + c_flex_dec * sin_alt_rate * (sin_DEC / cos_DEC);

HourAngle_correction	:= off_tau_esti;
Declination_correction	:= off_dec_esti;
HourAngle_velocity		:= (track_tau_esti + omega)/d2r;
Declination_velocity 	:= track_dec_esti/d2r; 

            ]]></ST>
    </Implementation>
    </POU>
</TcPlcObject>