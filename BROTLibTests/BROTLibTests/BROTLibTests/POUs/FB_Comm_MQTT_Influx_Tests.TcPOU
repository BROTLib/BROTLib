<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_Comm_MQTT_Influx_Tests" Id="{34557123-6b20-450c-8e1e-e569b4e30879}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for the command dispatch of BROTLib.FB_Comm_MQTT_Influx (BROTLib#39): single-field messages as pyBROT and
// BROTgui send them, and multi-field messages where track/slew must see the data of the same message. The handler is
// called directly with a payload; no MQTT connection is made. A stub records what it asks the telescope to do.
FUNCTION_BLOCK FB_Comm_MQTT_Influx_Tests EXTENDS TcUnit.FB_TestSuite
VAR
	fbComm	: BROTLib.FB_Comm_MQTT_Influx;
	stub	: FB_TelescopeStub;
	focus	: FB_FocusStub(comm := 0);
	aStates	: ARRAY[0..4] OF LREAL := [0.3, 0.7, 0.8, -1.0, -2.0];
	i		: INT;
	bReady	: BOOL;
	bSingle_Field_Messages_Still_Fill_The_Buffer	: BOOL;
	bData_Before_Verb_In_One_Message	: BOOL;
	bVerb_First_Uses_Data_From_The_Same_Message	: BOOL;
	bSame_Message_Data_Beats_The_Buffer	: BOOL;
	bIncomplete_Pair_Is_Dropped	: BOOL;
	bBuffer_Is_Cleared_After_Track	: BOOL;
	bSlew_Takes_Elevation_And_Azimuth_From_One_Message	: BOOL;
	bTrailing_Timestamp_Does_Not_Break_The_Last_Field	: BOOL;
	bOther_Measurement_Is_Ignored	: BOOL;
	bFields_Beyond_The_Eighth_Are_Ignored	: BOOL;
	bNon_Numeric_Coordinate_Is_Rejected	: BOOL;
	bOut_Of_Range_Coordinates_Are_Rejected	: BOOL;
	bRange_Limits_Are_Accepted	: BOOL;
	bRejected_Value_Clears_The_Buffer	: BOOL;
	bSpaced_Fields_Do_Not_Slew	: BOOL;
	bSpace_Before_Comma_Does_Not_Run_The_Verb	: BOOL;
	bSpace_In_A_Later_Pair_Does_Not_Run_The_Verb	: BOOL;
	bFocus_Rejected_While_Parked	: BOOL;
	bFocus_Rejected_Unless_Online	: BOOL;
	bFocus_Applied_When_Online	: BOOL;
	bFocus_Rejected_Without_Telescope	: BOOL;
	bFocus_Garbage_Still_Rejected_When_Online	: BOOL;
	bFocus_Gate_Does_Not_Touch_Other_Fields	: BOOL;
	bFocus_Above_Max_Rejected	: BOOL;
	bFocus_Below_Min_Rejected	: BOOL;
	bFocus_At_Limits_Applied	: BOOL;
	bFocus_OutOfRange_Keeps_Old_Target	: BOOL;
	bFocus_Range_Not_Checked_When_Not_Online	: BOOL;
	bStop_Command_Does_Not_Stop_Focus_Directly	: BOOL;
	bPublishLog_Too_Long_Is_Counted	: BOOL;
	fbW		: BROTLib.FB_Comm_MQTT_Influx;	// own instance for the weather tests
	stW			: BROTLib.ST_Weather;	// a property of struct type cannot be accessed component-wise, copy it first
	bWeather_Initially_Invalid	: BOOL;
	bWeather_Temperature_Accepted	: BOOL;
	bWeather_Zero_Celsius_Is_Valid	: BOOL;
	bWeather_Multi_Field_Message	: BOOL;
	bWeather_Rejects_Garbage_Keeps_Previous	: BOOL;
	bWeather_Pressure_Range	: BOOL;
	bWeather_Stale_Per_Field	: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT bReady THEN
	bReady := TRUE;
	fbComm.Telescope := stub;
	fbComm.Focus := focus;
END_IF
Single_Field_Messages_Still_Fill_The_Buffer();
Data_Before_Verb_In_One_Message();
Verb_First_Uses_Data_From_The_Same_Message();
Same_Message_Data_Beats_The_Buffer();
Incomplete_Pair_Is_Dropped();
Buffer_Is_Cleared_After_Track();
Slew_Takes_Elevation_And_Azimuth_From_One_Message();
Trailing_Timestamp_Does_Not_Break_The_Last_Field();
Other_Measurement_Is_Ignored();
Fields_Beyond_The_Eighth_Are_Ignored();
Non_Numeric_Coordinate_Is_Rejected();
Out_Of_Range_Coordinates_Are_Rejected();
Range_Limits_Are_Accepted();
Rejected_Value_Clears_The_Buffer();
Spaced_Fields_Do_Not_Slew();
Space_Before_Comma_Does_Not_Run_The_Verb();
Space_In_A_Later_Pair_Does_Not_Run_The_Verb();
Focus_Rejected_While_Parked();
Focus_Rejected_Unless_Online();
Focus_Applied_When_Online();
Focus_Rejected_Without_Telescope();
Focus_Garbage_Still_Rejected_When_Online();
Focus_Gate_Does_Not_Touch_Other_Fields();
Focus_Above_Max_Rejected();
Focus_Below_Min_Rejected();
Focus_At_Limits_Applied();
Focus_OutOfRange_Keeps_Old_Target();
Focus_Range_Not_Checked_When_Not_Online();
Stop_Command_Does_Not_Stop_Focus_Directly();
PublishLog_Too_Long_Is_Counted();
Weather_Initially_Invalid();
Weather_Temperature_Accepted();
Weather_Zero_Celsius_Is_Valid();
Weather_Multi_Field_Message();
Weather_Rejects_Garbage_Keeps_Previous();
Weather_Pressure_Range();
Weather_Stale_Per_Field();
]]></ST>
    </Implementation>
    <Method Name="ResetHandler" Id="{e4163f5e-60d4-4240-b519-3bcc1b5eb9d9}">
      <Declaration><![CDATA[// Puts the handler and the stub back to a clean state; every test runs its body once.
METHOD PRIVATE ResetHandler
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// drain whatever the previous test left in the handler's buffers: track and slew consume and clear them
fbComm._handleMQTTMessage(sPayloadRcv := 'command track=1');
fbComm._handleMQTTMessage(sPayloadRcv := 'command slew=1');
stub.ClearCounters();
stub.fReadyState := 1.0;
focus.Position := 10.0;
focus.fMinPosition := -1.0E6;
focus.fMaxPosition := 1.0E6;
focus.nStop := 0;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Single_Field_Messages_Still_Fill_The_Buffer" Id="{bf448ccc-63d8-435d-9991-76e2552690de}">
      <Declaration><![CDATA[// The way pyBROT and BROTgui send it today: three messages, the buffer is consumed by track.
METHOD PRIVATE Single_Field_Messages_Still_Fill_The_Buffer
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Single_Field_Messages_Still_Fill_The_Buffer');
IF NOT bSingle_Field_Messages_Still_Fill_The_Buffer THEN
	bSingle_Field_Messages_Still_Fill_The_Buffer := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=10.5');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command declination=20.5');
	AssertEquals_INT(Expected := 0, Actual := stub.nTrack, Message := 'before track: number of Track calls');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command track=1');
	AssertEquals_INT(Expected := 1, Actual := stub.nTrack, Message := 'after track: number of Track calls');
	AssertEquals_LREAL(Expected := 10.5, Actual := stub.fTrackRa, Delta := 1.0E-9, Message := 'after track: right ascension');
	AssertEquals_LREAL(Expected := 20.5, Actual := stub.fTrackDec, Delta := 1.0E-9, Message := 'after track: declination');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Data_Before_Verb_In_One_Message" Id="{3a11763f-f81c-4a99-9829-5ab118ed367b}">
      <Declaration><![CDATA[METHOD PRIVATE Data_Before_Verb_In_One_Message
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Data_Before_Verb_In_One_Message');
IF NOT bData_Before_Verb_In_One_Message THEN
	bData_Before_Verb_In_One_Message := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=10.5,declination=20.5,track=1');
	AssertEquals_INT(Expected := 1, Actual := stub.nTrack, Message := 'one message: number of Track calls');
	AssertEquals_LREAL(Expected := 10.5, Actual := stub.fTrackRa, Delta := 1.0E-9, Message := 'one message: right ascension');
	AssertEquals_LREAL(Expected := 20.5, Actual := stub.fTrackDec, Delta := 1.0E-9, Message := 'one message: declination');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Verb_First_Uses_Data_From_The_Same_Message" Id="{e8a94e9c-48f1-4ccd-a98c-22d7e10d0a9a}">
      <Declaration><![CDATA[// The data pass runs before the verb pass, so the field order does not matter.
METHOD PRIVATE Verb_First_Uses_Data_From_The_Same_Message
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Verb_First_Uses_Data_From_The_Same_Message');
IF NOT bVerb_First_Uses_Data_From_The_Same_Message THEN
	bVerb_First_Uses_Data_From_The_Same_Message := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command track=1,rightascension=10.5,declination=20.5');
	AssertEquals_INT(Expected := 1, Actual := stub.nTrack, Message := 'verb first: number of Track calls');
	AssertEquals_LREAL(Expected := 10.5, Actual := stub.fTrackRa, Delta := 1.0E-9, Message := 'verb first: right ascension');
	AssertEquals_LREAL(Expected := 20.5, Actual := stub.fTrackDec, Delta := 1.0E-9, Message := 'verb first: declination');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Same_Message_Data_Beats_The_Buffer" Id="{a02743b4-6532-4b68-8837-639d84cd727f}">
      <Declaration><![CDATA[// An old buffer value must never be combined with the new target.
METHOD PRIVATE Same_Message_Data_Beats_The_Buffer
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Same_Message_Data_Beats_The_Buffer');
IF NOT bSame_Message_Data_Beats_The_Buffer THEN
	bSame_Message_Data_Beats_The_Buffer := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=1.5');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command declination=2.5');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=10.5,declination=20.5,track=1');
	AssertEquals_INT(Expected := 1, Actual := stub.nTrack, Message := 'stale buffer: number of Track calls');
	AssertEquals_LREAL(Expected := 10.5, Actual := stub.fTrackRa, Delta := 1.0E-9, Message := 'stale buffer: right ascension');
	AssertEquals_LREAL(Expected := 20.5, Actual := stub.fTrackDec, Delta := 1.0E-9, Message := 'stale buffer: declination');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Incomplete_Pair_Is_Dropped" Id="{fd35e970-9a15-4f5c-98a3-32b668e2db14}">
      <Declaration><![CDATA[// Same as the buffered form: no declination, no Track call.
METHOD PRIVATE Incomplete_Pair_Is_Dropped
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Incomplete_Pair_Is_Dropped');
IF NOT bIncomplete_Pair_Is_Dropped THEN
	bIncomplete_Pair_Is_Dropped := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=10.5,track=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nTrack, Message := 'declination missing: number of Track calls');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Buffer_Is_Cleared_After_Track" Id="{72b7c574-480d-4146-8423-48463225227c}">
      <Declaration><![CDATA[// The second track finds an empty buffer and is dropped, the first call stays the last one.
METHOD PRIVATE Buffer_Is_Cleared_After_Track
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Buffer_Is_Cleared_After_Track');
IF NOT bBuffer_Is_Cleared_After_Track THEN
	bBuffer_Is_Cleared_After_Track := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=10.5,declination=20.5,track=1');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command track=1');
	AssertEquals_INT(Expected := 1, Actual := stub.nTrack, Message := 'second track without data: number of Track calls');
	AssertEquals_LREAL(Expected := 10.5, Actual := stub.fTrackRa, Delta := 1.0E-9, Message := 'second track without data: right ascension');
	AssertEquals_LREAL(Expected := 20.5, Actual := stub.fTrackDec, Delta := 1.0E-9, Message := 'second track without data: declination');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slew_Takes_Elevation_And_Azimuth_From_One_Message" Id="{ed1e6218-9e8f-429c-99e1-f69d844d24e7}">
      <Declaration><![CDATA[METHOD PRIVATE Slew_Takes_Elevation_And_Azimuth_From_One_Message
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Slew_Takes_Elevation_And_Azimuth_From_One_Message');
IF NOT bSlew_Takes_Elevation_And_Azimuth_From_One_Message THEN
	bSlew_Takes_Elevation_And_Azimuth_From_One_Message := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command slew=1,azimuth=120.5,elevation=45.5');
	AssertEquals_INT(Expected := 1, Actual := stub.nSlew, Message := 'slew: number of Slew calls');
	AssertEquals_LREAL(Expected := 120.5, Actual := stub.fSlewAz, Delta := 1.0E-9, Message := 'slew: azimuth');
	AssertEquals_LREAL(Expected := 45.5, Actual := stub.fSlewAlt, Delta := 1.0E-9, Message := 'slew: altitude');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Trailing_Timestamp_Does_Not_Break_The_Last_Field" Id="{7eed211b-d43a-4fa7-ba14-ab60aba02482}">
      <Declaration><![CDATA[METHOD PRIVATE Trailing_Timestamp_Does_Not_Break_The_Last_Field
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trailing_Timestamp_Does_Not_Break_The_Last_Field');
IF NOT bTrailing_Timestamp_Does_Not_Break_The_Last_Field THEN
	bTrailing_Timestamp_Does_Not_Break_The_Last_Field := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=10.5,declination=20.5,track=1 1700000000000000000');
	AssertEquals_INT(Expected := 1, Actual := stub.nTrack, Message := 'timestamp: number of Track calls');
	AssertEquals_LREAL(Expected := 10.5, Actual := stub.fTrackRa, Delta := 1.0E-9, Message := 'timestamp: right ascension');
	AssertEquals_LREAL(Expected := 20.5, Actual := stub.fTrackDec, Delta := 1.0E-9, Message := 'timestamp: declination');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Spaced_Fields_Do_Not_Slew" Id="{85a33eed-1627-4e91-86a9-d0f1721ed637}">
      <Declaration><![CDATA[// BROTLib#79: only the first field of a space-separated message arrives; nothing slews (the ADS warning is checked by hand).
METHOD PRIVATE Spaced_Fields_Do_Not_Slew
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Spaced_Fields_Do_Not_Slew');
IF NOT bSpaced_Fields_Do_Not_Slew THEN
	bSpaced_Fields_Do_Not_Slew := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command azimuth=150 elevation=50 slew=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nSlew, Message := 'spaced fields: number of Slew calls');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Space_Before_Comma_Does_Not_Run_The_Verb" Id="{0080847f-df28-46b2-8884-0a8c4590784f}">
      <Declaration><![CDATA[// BROTLib#79: ignored text in a message means track/slew of that message are not run; otherwise this would slew to the
// buffered elevation 30 with azimuth 150, a target nobody sent.
METHOD PRIVATE Space_Before_Comma_Does_Not_Run_The_Verb
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Space_Before_Comma_Does_Not_Run_The_Verb');
IF NOT bSpace_Before_Comma_Does_Not_Run_The_Verb THEN
	bSpace_Before_Comma_Does_Not_Run_The_Verb := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command elevation=30');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command azimuth=150 elevation=50,slew=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nSlew, Message := 'space before comma: number of Slew calls');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Space_In_A_Later_Pair_Does_Not_Run_The_Verb" Id="{289cc1db-7f74-42da-a6b3-73a02e99de35}">
      <Declaration><![CDATA[METHOD PRIVATE Space_In_A_Later_Pair_Does_Not_Run_The_Verb
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Space_In_A_Later_Pair_Does_Not_Run_The_Verb');
IF NOT bSpace_In_A_Later_Pair_Does_Not_Run_The_Verb THEN
	bSpace_In_A_Later_Pair_Does_Not_Run_The_Verb := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command azimuth=150,elevation=50 slew=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nSlew, Message := 'space in a later pair: number of Slew calls');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Other_Measurement_Is_Ignored" Id="{7311dfe5-1b87-4e83-b0cf-0c4bd649d7e3}">
      <Declaration><![CDATA[METHOD PRIVATE Other_Measurement_Is_Ignored
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Other_Measurement_Is_Ignored');
IF NOT bOther_Measurement_Is_Ignored THEN
	bOther_Measurement_Is_Ignored := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'status rightascension=10.5,declination=20.5,track=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nTrack, Message := 'measurement status: number of Track calls');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Fields_Beyond_The_Eighth_Are_Ignored" Id="{e6b89235-1e3d-47b1-8a05-9b4fa04bbd63}">
      <Declaration><![CDATA[// At most 8 fields per message (a malformed message must not spin the scan cycle); the rest is logged and ignored.
METHOD PRIVATE Fields_Beyond_The_Eighth_Are_Ignored
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Fields_Beyond_The_Eighth_Are_Ignored');
IF NOT bFields_Beyond_The_Eighth_Are_Ignored THEN
	bFields_Beyond_The_Eighth_Are_Ignored := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=10.5,declination=20.5,x1=0,x2=0,x3=0,x4=0,x5=0,x6=0,track=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nTrack, Message := 'track is the ninth field: number of Track calls');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Non_Numeric_Coordinate_Is_Rejected" Id="{70e0277b-64c7-4892-988c-3be963d7f592}">
      <Declaration><![CDATA[// STRING_TO_LREAL turns garbage into 0.0, a valid coordinate; it must not reach Track (#27).
METHOD PRIVATE Non_Numeric_Coordinate_Is_Rejected
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Non_Numeric_Coordinate_Is_Rejected');
IF NOT bNon_Numeric_Coordinate_Is_Rejected THEN
	bNon_Numeric_Coordinate_Is_Rejected := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=abc,declination=20.5,track=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nTrack, Message := 'rightascension=abc: number of Track calls');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=10.5,declination=nan,track=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nTrack, Message := 'declination=nan: number of Track calls');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Out_Of_Range_Coordinates_Are_Rejected" Id="{c629a73e-2263-4856-a25c-456cd6c5bfe9}">
      <Declaration><![CDATA[METHOD PRIVATE Out_Of_Range_Coordinates_Are_Rejected
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Out_Of_Range_Coordinates_Are_Rejected');
IF NOT bOut_Of_Range_Coordinates_Are_Rejected THEN
	bOut_Of_Range_Coordinates_Are_Rejected := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=10.5,declination=95,track=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nTrack, Message := 'declination=95: number of Track calls');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=1e999,declination=20.5,track=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nTrack, Message := 'rightascension=1e999: number of Track calls');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command elevation=120,azimuth=10,slew=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nSlew, Message := 'elevation=120: number of Slew calls');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Range_Limits_Are_Accepted" Id="{2234caa2-2a82-426e-91ed-05b02e9efd06}">
      <Declaration><![CDATA[// The limits themselves are valid values; so are signs and exponents.
METHOD PRIVATE Range_Limits_Are_Accepted
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Range_Limits_Are_Accepted');
IF NOT bRange_Limits_Are_Accepted THEN
	bRange_Limits_Are_Accepted := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=0,declination=-90,track=1');
	AssertEquals_INT(Expected := 1, Actual := stub.nTrack, Message := 'ra=0, dec=-90: number of Track calls');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=360,declination=+9e1,track=1');
	AssertEquals_INT(Expected := 2, Actual := stub.nTrack, Message := 'ra=360, dec=+9e1: number of Track calls');
	AssertEquals_LREAL(Expected := 90.0, Actual := stub.fTrackDec, Delta := 1.0E-9, Message := 'dec=+9e1: declination');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Rejected_Value_Clears_The_Buffer" Id="{70e7ff01-12c5-4d27-8596-129dcb4f5565}">
      <Declaration><![CDATA[// A rejected coordinate must not fall back to one buffered by an earlier message: the track is dropped instead.
METHOD PRIVATE Rejected_Value_Clears_The_Buffer
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Rejected_Value_Clears_The_Buffer');
IF NOT bRejected_Value_Clears_The_Buffer THEN
	bRejected_Value_Clears_The_Buffer := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=1.5');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command rightascension=abc,declination=20.5,track=1');
	AssertEquals_INT(Expected := 0, Actual := stub.nTrack, Message := 'buffered ra, then ra=abc: number of Track calls');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Rejected_While_Parked" Id="{6755c925-2264-4ba0-8f84-ff2b39dd6891}">
      <Declaration><![CDATA[// BROTLib#74: the case from the issue; a parked telescope does not move the focus.
METHOD PRIVATE Focus_Rejected_While_Parked
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Rejected_While_Parked');
IF NOT bFocus_Rejected_While_Parked THEN
	bFocus_Rejected_While_Parked := TRUE;
	ResetHandler();
	stub.fReadyState := 0.0;
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=36.5');
	AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus while parked');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Rejected_Unless_Online" Id="{260f077c-1ca2-4864-97ab-8e3960fdd98f}">
      <Declaration><![CDATA[// BROTLib#74: parking, initializing, calibrating, error and not operational are rejected too.
METHOD PRIVATE Focus_Rejected_Unless_Online
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Rejected_Unless_Online');
IF NOT bFocus_Rejected_Unless_Online THEN
	bFocus_Rejected_Unless_Online := TRUE;
	ResetHandler();
	FOR i := 0 TO 4 DO
		ResetHandler();
		stub.fReadyState := aStates[i];
		fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=36.5');
		AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := CONCAT('focus at READY_STATE ', LREAL_TO_STRING(aStates[i])));
	END_FOR
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Applied_When_Online" Id="{2b786cf1-0b7d-4c00-96e3-a4fd7cd169b9}">
      <Declaration><![CDATA[// BROTLib#74: unchanged behaviour while the telescope is online.
METHOD PRIVATE Focus_Applied_When_Online
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Applied_When_Online');
IF NOT bFocus_Applied_When_Online THEN
	bFocus_Applied_When_Online := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=36.5');
	AssertEquals_LREAL(Expected := 36.5, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus while online');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Rejected_Without_Telescope" Id="{6eef3e53-aaab-4592-8c37-e5258e8a47f6}">
      <Declaration><![CDATA[// BROTLib#74: no telescope connected is rejected (fail-safe).
METHOD PRIVATE Focus_Rejected_Without_Telescope
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Rejected_Without_Telescope');
IF NOT bFocus_Rejected_Without_Telescope THEN
	bFocus_Rejected_Without_Telescope := TRUE;
	ResetHandler();
	fbComm.Telescope := 0;
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=36.5');
	fbComm.Telescope := stub;
	AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus without telescope');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Garbage_Still_Rejected_When_Online" Id="{f8481f96-62f2-4aad-84f2-7802c806e86f}">
      <Declaration><![CDATA[// BROTLib#74: the range check still applies while online.
METHOD PRIVATE Focus_Garbage_Still_Rejected_When_Online
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Garbage_Still_Rejected_When_Online');
IF NOT bFocus_Garbage_Still_Rejected_When_Online THEN
	bFocus_Garbage_Still_Rejected_When_Online := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=abc');
	AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus=abc');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=1e7');
	AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus=1e7');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Gate_Does_Not_Touch_Other_Fields" Id="{bb4d1649-9f10-4da7-90a8-be4b0f734042}">
      <Declaration><![CDATA[// BROTLib#74: only focus is gated here; the slew is still forwarded (the telescope controller decides it).
METHOD PRIVATE Focus_Gate_Does_Not_Touch_Other_Fields
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Gate_Does_Not_Touch_Other_Fields');
IF NOT bFocus_Gate_Does_Not_Touch_Other_Fields THEN
	bFocus_Gate_Does_Not_Touch_Other_Fields := TRUE;
	ResetHandler();
	stub.fReadyState := 0.0;
	fbComm._handleMQTTMessage(sPayloadRcv := 'command elevation=50,azimuth=150,focus=36.5,slew=1');
	AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus in a multi-field message');
	AssertEquals_INT(Expected := 1, Actual := stub.nSlew, Message := 'slew still forwarded');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Above_Max_Rejected" Id="{c0f0cc5c-c1a0-4f44-96a7-a08eb4c9381f}">
      <Declaration><![CDATA[// MONETcommon#122: a target above the focus travel is rejected, not clamped (focus=500 ran to the end of travel).
METHOD PRIVATE Focus_Above_Max_Rejected
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Above_Max_Rejected');
IF NOT bFocus_Above_Max_Rejected THEN
	bFocus_Above_Max_Rejected := TRUE;
	ResetHandler();
	focus.fMaxPosition := 91.5;
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=500');
	AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus=500');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=91.6');
	AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus=91.6');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Below_Min_Rejected" Id="{3955e398-af23-40ee-bfb1-b4bdb38ccf0c}">
      <Declaration><![CDATA[// MONETcommon#122: a target below the focus travel is rejected.
METHOD PRIVATE Focus_Below_Min_Rejected
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Below_Min_Rejected');
IF NOT bFocus_Below_Min_Rejected THEN
	bFocus_Below_Min_Rejected := TRUE;
	ResetHandler();
	focus.fMinPosition := 15.0;
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=-5');
	AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus=-5');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=14.9');
	AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus=14.9');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_At_Limits_Applied" Id="{154428f0-db63-44fe-8bc8-5db6e9013791}">
      <Declaration><![CDATA[// MONETcommon#122: the limits themselves are valid targets.
METHOD PRIVATE Focus_At_Limits_Applied
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_At_Limits_Applied');
IF NOT bFocus_At_Limits_Applied THEN
	bFocus_At_Limits_Applied := TRUE;
	ResetHandler();
	focus.fMinPosition := 15.0;
	focus.fMaxPosition := 91.5;
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=91.5');
	AssertEquals_LREAL(Expected := 91.5, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus at max');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=15');
	AssertEquals_LREAL(Expected := 15.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'focus at min');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_OutOfRange_Keeps_Old_Target" Id="{04cb912e-0c97-4371-b362-79c5601e7c69}">
      <Declaration><![CDATA[// MONETcommon#122: a rejected target leaves the last valid one, so a running move continues.
METHOD PRIVATE Focus_OutOfRange_Keeps_Old_Target
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_OutOfRange_Keeps_Old_Target');
IF NOT bFocus_OutOfRange_Keeps_Old_Target THEN
	bFocus_OutOfRange_Keeps_Old_Target := TRUE;
	ResetHandler();
	focus.fMaxPosition := 91.5;
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=60');
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=500');
	AssertEquals_LREAL(Expected := 60.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'old target kept');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Focus_Range_Not_Checked_When_Not_Online" Id="{be51584f-9ff2-47a7-80af-dc16c666c6f0}">
      <Declaration><![CDATA[// MONETcommon#122: the online gate (#74) comes first; a parked telescope rejects an in-range target too.
METHOD PRIVATE Focus_Range_Not_Checked_When_Not_Online
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Focus_Range_Not_Checked_When_Not_Online');
IF NOT bFocus_Range_Not_Checked_When_Not_Online THEN
	bFocus_Range_Not_Checked_When_Not_Online := TRUE;
	ResetHandler();
	focus.fMaxPosition := 91.5;
	stub.fReadyState := 0.0;
	fbComm._handleMQTTMessage(sPayloadRcv := 'command focus=60');
	AssertEquals_LREAL(Expected := 10.0, Actual := focus.Position, Delta := 1.0E-9, Message := 'in range while parked');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop_Command_Does_Not_Stop_Focus_Directly" Id="{6612a15b-f2a2-49cf-a59b-2ec0d9b77759}">
      <Declaration><![CDATA[// MONETcommon#122: 'stop' goes to the telescope only; the telescope stops its focus (pins the design).
METHOD PRIVATE Stop_Command_Does_Not_Stop_Focus_Directly
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stop_Command_Does_Not_Stop_Focus_Directly');
IF NOT bStop_Command_Does_Not_Stop_Focus_Directly THEN
	bStop_Command_Does_Not_Stop_Focus_Directly := TRUE;
	ResetHandler();
	fbComm._handleMQTTMessage(sPayloadRcv := 'command stop=1');
	AssertEquals_INT(Expected := 0, Actual := focus.nStop, Message := 'focus stopped by the handler');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishLog_Too_Long_Is_Counted" Id="{da4a3699-f755-4d22-8612-4f5df20a6ec0}">
      <Declaration><![CDATA[// BROTLib#130: a log line that does not fit the buffer is not published, and it is counted instead of lost silently.
// No MQTT call is made on this path, so no connection is needed.
METHOD PRIVATE PublishLog_Too_Long_Is_Counted
VAR
	sLevel	: STRING(255) := 'LLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLL';
	bOk		: BOOL;
	nBefore	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('PublishLog_Too_Long_Is_Counted');
IF NOT bPublishLog_Too_Long_Is_Counted THEN
	bPublishLog_Too_Long_Is_Counted := TRUE;
	nBefore := fbComm.logDropped;
	bOk := fbComm.PublishLog(level := sLevel, message := 'x');
	AssertFalse(Condition := bOk, Message := 'published');
	AssertEquals_INT(Expected := nBefore + 1, Actual := fbComm.logDropped, Message := 'logDropped');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Weather_Initially_Invalid" Id="{df32cd46-99fa-4877-b0ca-975ba6fc03f9}">
      <Declaration><![CDATA[// BROTLib#33: a fresh handler has no weather; nothing is valid.
METHOD PRIVATE Weather_Initially_Invalid
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Weather_Initially_Invalid');
IF NOT bWeather_Initially_Invalid THEN
	bWeather_Initially_Invalid := TRUE;
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Initially_Invalid tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertFalse(Condition := stW.bTemperatureValid, Message := 'temperature valid');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Initially_Invalid tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertFalse(Condition := stW.bPressureValid, Message := 'pressure valid');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Initially_Invalid tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertFalse(Condition := stW.bHumidityValid, Message := 'humidity valid');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Weather_Temperature_Accepted" Id="{81588745-c0dd-42c1-a4ba-a8b79b44cd88}">
      <Declaration><![CDATA[METHOD PRIVATE Weather_Temperature_Accepted
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Weather_Temperature_Accepted');
IF NOT bWeather_Temperature_Accepted THEN
	bWeather_Temperature_Accepted := TRUE;
	fbW._handleMQTTMessage(sPayloadRcv := 'command temperature=12.5');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Temperature_Accepted tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 12.5, Actual := stW.fTemperature, Delta := 1.0E-9, Message := 'temperature');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Temperature_Accepted tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertTrue(Condition := stW.bTemperatureValid, Message := 'temperature valid');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Temperature_Accepted tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertFalse(Condition := stW.bPressureValid, Message := 'pressure still invalid');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Temperature_Accepted tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertFalse(Condition := stW.bHumidityValid, Message := 'humidity still invalid');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Weather_Zero_Celsius_Is_Valid" Id="{326882fa-20b9-4721-961d-fa8d9ba9346b}">
      <Declaration><![CDATA[// The old 0.0 sentinel made 0 deg C indistinguishable from "nothing received" (AstroBROT#4 made 0 deg C a valid temperature).
METHOD PRIVATE Weather_Zero_Celsius_Is_Valid
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Weather_Zero_Celsius_Is_Valid');
IF NOT bWeather_Zero_Celsius_Is_Valid THEN
	bWeather_Zero_Celsius_Is_Valid := TRUE;
	fbW._handleMQTTMessage(sPayloadRcv := 'command temperature=0');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Zero_Celsius_Is_Valid tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertTrue(Condition := stW.bTemperatureValid, Message := '0 deg C is a value, not no data');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Zero_Celsius_Is_Valid tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 0.0, Actual := stW.fTemperature, Delta := 1.0E-9, Message := 'temperature');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Weather_Multi_Field_Message" Id="{60c2be9c-220a-4c6e-9818-fd0b8f84243a}">
      <Declaration><![CDATA[METHOD PRIVATE Weather_Multi_Field_Message
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Weather_Multi_Field_Message');
IF NOT bWeather_Multi_Field_Message THEN
	bWeather_Multi_Field_Message := TRUE;
	fbW._handleMQTTMessage(sPayloadRcv := 'command temperature=10,pressure=800,humidity=40');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Multi_Field_Message tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 10.0, Actual := stW.fTemperature, Delta := 1.0E-9, Message := 'temperature');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Multi_Field_Message tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 800.0, Actual := stW.fPressure, Delta := 1.0E-9, Message := 'pressure');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Multi_Field_Message tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 40.0, Actual := stW.fHumidity, Delta := 1.0E-9, Message := 'humidity');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Multi_Field_Message tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertTrue(Condition := stW.bTemperatureValid AND stW.bPressureValid AND stW.bHumidityValid, Message := 'all valid');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Weather_Rejects_Garbage_Keeps_Previous" Id="{061b162e-60b1-4d99-b8c6-e154b515583c}">
      <Declaration><![CDATA[METHOD PRIVATE Weather_Rejects_Garbage_Keeps_Previous
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Weather_Rejects_Garbage_Keeps_Previous');
IF NOT bWeather_Rejects_Garbage_Keeps_Previous THEN
	bWeather_Rejects_Garbage_Keeps_Previous := TRUE;
	fbW._handleMQTTMessage(sPayloadRcv := 'command temperature=10,pressure=800,humidity=40');
	fbW._handleMQTTMessage(sPayloadRcv := 'command temperature=abc');
	fbW._handleMQTTMessage(sPayloadRcv := 'command temperature=283');
	fbW._handleMQTTMessage(sPayloadRcv := 'command pressure=101.3');
	fbW._handleMQTTMessage(sPayloadRcv := 'command pressure=29.9');
	fbW._handleMQTTMessage(sPayloadRcv := 'command humidity=150');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Rejects_Garbage_Keeps_Previous tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 10.0, Actual := stW.fTemperature, Delta := 1.0E-9, Message := 'temperature kept (text and Kelvin rejected)');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Rejects_Garbage_Keeps_Previous tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 800.0, Actual := stW.fPressure, Delta := 1.0E-9, Message := 'pressure kept (kPa and inHg rejected)');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Rejects_Garbage_Keeps_Previous tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 40.0, Actual := stW.fHumidity, Delta := 1.0E-9, Message := 'humidity kept (150 % rejected)');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Rejects_Garbage_Keeps_Previous tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertTrue(Condition := stW.bTemperatureValid AND stW.bPressureValid AND stW.bHumidityValid, Message := 'still valid');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Weather_Pressure_Range" Id="{6a6716c4-11ed-46b7-9270-f12709ba6020}">
      <Declaration><![CDATA[METHOD PRIVATE Weather_Pressure_Range
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Weather_Pressure_Range');
IF NOT bWeather_Pressure_Range THEN
	bWeather_Pressure_Range := TRUE;
	fbW._handleMQTTMessage(sPayloadRcv := 'command pressure=300');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Pressure_Range tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 300.0, Actual := stW.fPressure, Delta := 1.0E-9, Message := '300 hPa accepted');
	fbW._handleMQTTMessage(sPayloadRcv := 'command pressure=0');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Pressure_Range tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 300.0, Actual := stW.fPressure, Delta := 1.0E-9, Message := '0 is not a pressure any more');
	fbW._handleMQTTMessage(sPayloadRcv := 'command pressure=1100');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Pressure_Range tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 1100.0, Actual := stW.fPressure, Delta := 1.0E-9, Message := '1100 hPa accepted');
	fbW._handleMQTTMessage(sPayloadRcv := 'command pressure=1100.5');
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Pressure_Range tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertEquals_LREAL(Expected := 1100.0, Actual := stW.fPressure, Delta := 1.0E-9, Message := 'above 1100 rejected');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Weather_Stale_Per_Field" Id="{1e7d8eaf-d641-4361-8555-1eb4883cd378}">
      <Declaration><![CDATA[// BROTLib#33: staleness is per field; a fresh humidity must not keep a frozen temperature fresh (the old shared timer did).
// tWeatherTimeout is 0, so a field that got no new value in a call of _UpdateWeather is stale at once: the test needs
// no waiting and runs in one cycle.
METHOD PRIVATE Weather_Stale_Per_Field
VAR
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Weather_Stale_Per_Field');
IF NOT bWeather_Stale_Per_Field THEN
	bWeather_Stale_Per_Field := TRUE;
	fbW.tWeatherTimeout := T#0S;
	fbW._handleMQTTMessage(sPayloadRcv := 'command temperature=10,humidity=40');
	fbW._UpdateWeather();	// both were received since the last call: nothing is stale
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Stale_Per_Field tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertTrue(Condition := stW.bTemperatureValid AND stW.bHumidityValid, Message := 'received this cycle: valid');
	fbW._handleMQTTMessage(sPayloadRcv := 'command humidity=41');
	fbW._UpdateWeather();	// only the humidity is new: the temperature is stale
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Stale_Per_Field tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertFalse(Condition := stW.bTemperatureValid, Message := 'temperature is stale');
	AssertTrue(Condition := stW.bHumidityValid, Message := 'humidity is still valid');
	AssertEquals_LREAL(Expected := 10.0, Actual := stW.fTemperature, Delta := 1.0E-9, Message := 'stale value is kept');
	// a field that went stale is valid again with its next accepted value
	fbW._handleMQTTMessage(sPayloadRcv := 'command temperature=-3.5,humidity=42');
	fbW._UpdateWeather();
	stW := fbW.Weather;
	ADSLOGSTR(ADSLOG_MSGTYPE_WARN OR ADSLOG_MSGTYPE_LOG, 'DIAGC %s', CONCAT(CONCAT(CONCAT(CONCAT('Weather_Stale_Per_Field tv=', BOOL_TO_STRING(stW.bTemperatureValid)), CONCAT(' t=', LREAL_TO_STRING(stW.fTemperature))), CONCAT(CONCAT(' pv=', BOOL_TO_STRING(stW.bPressureValid)), CONCAT(' p=', LREAL_TO_STRING(stW.fPressure)))), CONCAT(CONCAT(' hv=', BOOL_TO_STRING(stW.bHumidityValid)), CONCAT(' h=', LREAL_TO_STRING(stW.fHumidity)))));
	AssertTrue(Condition := stW.bTemperatureValid, Message := 'temperature valid again');
	AssertEquals_LREAL(Expected := -3.5, Actual := stW.fTemperature, Delta := 1.0E-9, Message := 'new value');
	TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
