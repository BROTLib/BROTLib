<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="F_HomeStopAbort_Tests" Id="{c4a81f06-7b2d-4e93-a5d1-0e8f3b6a9d27}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for BROTLib.F_HomeStopAbort: a homing stopped by Stop() that MC_Home answers with 16#4B0A is aborted (HalfBROT#114).
FUNCTION_BLOCK F_HomeStopAbort_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Stopped_Homing_Error_Is_Abort();
Same_Error_Without_Stop_Stays_Error();
Other_Error_Stays_Error();
No_Error_No_Abort();
]]></ST>
    </Implementation>
    <Method Name="Stopped_Homing_Error_Is_Abort" Id="{1d7e2a58-3c90-4b64-9f12-a8e5c0d34b71}">
      <Declaration><![CDATA[METHOD PRIVATE Stopped_Homing_Error_Is_Abort
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Stopped_Homing_Error_Is_Abort');
AssertEquals_BOOL(Expected := TRUE, Actual := BROTLib.F_HomeStopAbort(bHomeStopped := TRUE, bError := TRUE, nErrorID := 16#4B0A), Message := 'stopped, 0x4B0A');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Same_Error_Without_Stop_Stays_Error" Id="{6e0b93d4-8a15-4c27-b3f8-2d5a71e9c046}">
      <Declaration><![CDATA[METHOD PRIVATE Same_Error_Without_Stop_Stays_Error
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Same_Error_Without_Stop_Stays_Error');
AssertEquals_BOOL(Expected := FALSE, Actual := BROTLib.F_HomeStopAbort(bHomeStopped := FALSE, bError := TRUE, nErrorID := 16#4B0A), Message := 'not stopped, 0x4B0A');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Other_Error_Stays_Error" Id="{a2f5c819-0e63-4d7b-8c4a-5b19e7d3f082}">
      <Declaration><![CDATA[METHOD PRIVATE Other_Error_Stays_Error
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Other_Error_Stays_Error');
AssertEquals_BOOL(Expected := FALSE, Actual := BROTLib.F_HomeStopAbort(bHomeStopped := TRUE, bError := TRUE, nErrorID := 16#4260), Message := 'stopped, lost enable 0x4260');
AssertEquals_BOOL(Expected := FALSE, Actual := BROTLib.F_HomeStopAbort(bHomeStopped := TRUE, bError := TRUE, nErrorID := 0), Message := 'stopped, no id');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="No_Error_No_Abort" Id="{f81d46b7-5c29-4e03-a7d6-93b0e2c5a418}">
      <Declaration><![CDATA[METHOD PRIVATE No_Error_No_Abort
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('No_Error_No_Abort');
AssertEquals_BOOL(Expected := FALSE, Actual := BROTLib.F_HomeStopAbort(bHomeStopped := TRUE, bError := FALSE, nErrorID := 16#4B0A), Message := 'stopped, no error, stale id');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>