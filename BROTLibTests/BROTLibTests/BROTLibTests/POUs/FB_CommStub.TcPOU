<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CommStub" Id="{9b2e4f17-3c58-4a60-8d1e-6f7a0c5b2d83}" SpecialFunc="None">
    <Declaration><![CDATA[// I_Comm stub for the FB_EventLog tests (BROTLib#130): PublishLog fails on request and records what it delivered.
FUNCTION_BLOCK FB_CommStub IMPLEMENTS BROTLib.I_Comm
VAR_INPUT
	nFailNext		: INT;	// this many coming PublishLog calls return FALSE, then TRUE
	bFailAlways		: BOOL;
END_VAR
VAR_OUTPUT
	nPublishLogCalls	: INT;	// every call, delivered or not
	nDelivered			: INT;
	aLevel				: ARRAY[1..8] OF STRING(255);	// delivered events in order
	aMessage			: ARRAY[1..8] OF STRING(255);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Publish" Id="{a17c5e92-0d46-4b38-8f2a-5c9e3b7d1f60}">
      <Declaration><![CDATA[METHOD Publish : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Publish := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishLREAL" Id="{20fac6c6-1108-45fe-979e-d9430ad7ecc0}">
      <Declaration><![CDATA[METHOD PublishLREAL : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: LREAL;
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[PublishLREAL := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishINT" Id="{3dd0d019-aead-4dab-835a-3ec62879adf1}">
      <Declaration><![CDATA[METHOD PublishINT : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: LINT;
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[PublishINT := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishBOOL" Id="{effdb505-deb9-44f3-ae34-2baba38b6aa3}">
      <Declaration><![CDATA[METHOD PublishBOOL : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: BOOL;
END_VAR
VAR_OUTPUT
