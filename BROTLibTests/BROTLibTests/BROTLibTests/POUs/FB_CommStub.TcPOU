END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[PublishBOOL := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishString" Id="{6bfe3a1a-9e19-44bc-b6b1-4d229e692d3b}">
      <Declaration><![CDATA[METHOD PublishString : BOOL
VAR_INPUT
	domain			: STRING(255) := 'environment';
	location		: STRING(255) := 'roof';
	parameter		: STRING(255);
	value			: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[PublishString := TRUE;
published := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PublishLog" Id="{d3f60b84-5a1e-4c97-b0d2-8e4a7c1f9b35}">
      <Declaration><![CDATA[METHOD PublishLog : BOOL
VAR_INPUT
	level		: STRING(255) := 'INFO';
	message		: STRING(255);
END_VAR
VAR_OUTPUT
	published	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nPublishLogCalls := nPublishLogCalls + 1;
IF bFailAlways THEN
	PublishLog := FALSE;
ELSIF nFailNext > 0 THEN
	nFailNext := nFailNext - 1;
	PublishLog := FALSE;
ELSE
	nDelivered := nDelivered + 1;
	IF nDelivered <= 8 THEN
		aLevel[nDelivered] := level;
		aMessage[nDelivered] := message;
	END_IF
	PublishLog := TRUE;
END_IF
published := PublishLog;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
